--==================================================
-- MAIN EGG PROCESS
--==================================================

local function ProcessEgg()

    --================================================
    -- FIND BEST EGG
    --================================================

    local Egg =
        GetBestEgg()


    --================================================
    -- NO EGG
    --================================================

    if not Egg then

        print(
            "=========================================="
        )

        print(
            "[AUTO EGG] TIDAK ADA VALID EGG"
        )

        print(
            "[AUTO EGG] -> TREADMILL"
        )

        print(
            "=========================================="
        )


        EnterTreadmill()

        return

    end


    --================================================
    -- EGG FOUND
    --================================================

    if TreadmillRunning then

        print(
            "[AUTO EGG] EGG FOUND"
        )

        print(
            "[AUTO EGG] -> EXIT TREADMILL"
        )


        local Doffed =
            ExitTreadmill()


        if not Doffed then

            return

        end

    end


    --================================================
    -- START AREA
    --================================================

    local StartArea =
        GetStartArea()


    if not StartArea then

        warn(
            "[AUTO EGG] StartArea tidak ditemukan."
        )

        return

    end


    --================================================
    -- FLY START
    --================================================

    local StartPosition =
        GetPosition(
            StartArea
        )


    if StartPosition then

        StartPosition =
            StartPosition +
            Vector3.new(
                -20,
                5,
                0
            )

    end


    local StartReached =
        AutoFlyToPosition(
            StartPosition,
            REACH_DISTANCE,
            "MAIN:StartArea"
        )


    if not StartReached then

        return

    end


    --================================================
    -- VALIDATE EGG
    --================================================

    if not Egg
        or not Egg.Parent then

        return

    end


    --================================================
    -- FLY EGG
    --================================================

    print(
        "[AUTO EGG] -> FLY:",
        Egg.Name
    )


    local ReachedEgg =
        FlyToObject(
            Egg
        )


    if not ReachedEgg then

        return

    end


    --================================================
    -- CARRY
    --================================================

    task.wait(
        AFTER_CARRY_START_DELAY
    )


    if not CarryEgg(
        Egg
    ) then

        return

    end


    task.wait(
        CARRY_DELAY
    )


    --================================================
    -- RETURN START
    --================================================

    StartPosition =
        GetPosition(
            StartArea
        )


    if StartPosition then

        StartPosition =
            StartPosition +
            Vector3.new(
                -20,
                5,
                0
            )

    end


    StartReached =
        AutoFlyToPosition(
            StartPosition,
            REACH_DISTANCE,
            "MAIN:StartArea"
        )


    if not StartReached then

        return

    end


    --================================================
    -- WAIT
    --================================================

    print(
        "[AUTO EGG] WAIT:",
        WAIT_AFTER_RETURN
    )


    task.wait(
        WAIT_AFTER_RETURN
    )


    --================================================
    -- CHECK TOOL
    --================================================

    local Tool =
        GetEquippedTool()


    if not Tool then

        task.wait(
            TOOL_CHECK_DELAY
        )


        Tool =
            GetEquippedTool()

    end


    if not Tool then

        warn(
            "[AUTO EGG] Tool tidak ditemukan."
        )

        return

    end


    print(
        "[AUTO EGG] TOOL:",
        Tool.Name,
        "| UID:",
        Tool:GetAttribute("UID")
    )


    --================================================
    -- PARASITE CHECK
    --================================================

    local ParasiteHandled =
        CheckAndFeedParasite()


    if ParasiteHandled then

        print(
            "[AUTO EGG] PARASITE -> PLACE SKIP"
        )

        return

    end


    --================================================
    -- OWN PLOT
    --================================================

    local Plot =
        GetMyPlot()


    if not Plot then

        return

    end


    --================================================
    -- FLY PLOT
    --================================================

    local ReachedPlot =
        FlyToObject(
            Plot
        )


    if not ReachedPlot then

        return

    end


    --================================================
    -- TOOL RECHECK
    --================================================

    local CurrentTool =
        GetEquippedTool()


    if not CurrentTool then

        warn(
            "[AUTO PLACE] Tool sudah tidak equipped."
        )

        return

    end


    --================================================
    -- PARASITE SAFETY RECHECK
    --================================================

    local ParasiteAfterPlot =
        CheckAndFeedParasite()


    if ParasiteAfterPlot then

        print(
            "[AUTO PLACE] PARASITE -> PLACE CANCEL"
        )

        return

    end


    --================================================
    -- PLACE
    --================================================

    local Placed =
        PlaceEggUntilSuccess(
            CurrentTool,
            Plot
        )


    if not Placed then

        return

    end


    --================================================
    -- HATCH
    --================================================

    print(
        "[AUTO HATCH] START"
    )


    StartHatch()


    --================================================
    -- RESUME
    --================================================

    task.wait(
        HATCH_RESUME_TIME
    )


end


