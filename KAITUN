    return nil

end


--==================================================
-- FIND PLOT AREA
--==================================================

local function GetPlotArea(
    Plot
)

    local BiggestPart =
        nil

    local BiggestArea =
        0


    for _, Object in ipairs(
        Plot:GetDescendants()
    ) do

        if Object:IsA("BasePart") then

            local Name =
                Object.Name:lower()


            if not Name:find("sign")
                and not Name:find("playername")
                and not Name:find("deco")
                and not Name:find("border")
                and not Name:find("wall")
                and not Name:find("fence") then


                local Area =
                    Object.Size.X *
                    Object.Size.Z


                if Area >
                    BiggestArea then

                    BiggestArea =
                        Area

                    BiggestPart =
                        Object

                end

            end

        end

    end


    return BiggestPart

end


--==================================================
-- RANDOM PLACE POSITION
--==================================================

local function GetRandomPosition(
    Plot,
    AreaPart
)

    local Size =
        AreaPart.Size


    local MinX =
        -Size.X / 2 + MARGIN

    local MaxX =
        Size.X / 2 - MARGIN

    local MinZ =
        -Size.Z / 2 + MARGIN

    local MaxZ =
        Size.Z / 2 - MARGIN


    local LocalX =
        MinX +
        math.random() *
        (MaxX - MinX)


    local LocalZ =
        MinZ +
        math.random() *
        (MaxZ - MinZ)


    local WorldPosition =
        AreaPart.CFrame:
        PointToWorldSpace(
            Vector3.new(
                LocalX,
                0,
                LocalZ
            )
        )


    local PlotPivot =
        Plot:GetPivot()


    local PlotLocalPosition =
        PlotPivot:
        PointToObjectSpace(
            WorldPosition
        )


    return Vector3.new(
        PlotLocalPosition.X,
        FIXED_Y,
        PlotLocalPosition.Z
    )

end


--==================================================
-- PLACE EGG
--==================================================

local function PlaceEgg(
    Tool,
    Plot
)

    if not Tool
        or not Tool.Parent then

        return false

    end


    local UID =
        Tool:GetAttribute(
            "UID"
        )


    if not UID then

        warn(
            "[PLACE] UID tidak ditemukan:",
            Tool.Name
        )

        return false

    end


    local AreaPart =
        GetPlotArea(
            Plot
        )


    if not AreaPart then

        return false

    end


    local RandomPosition =
        GetRandomPosition(
            Plot,
            AreaPart
        )


    local LocalCFrame =
        CFrame.new(
            RandomPosition.X,
            FIXED_Y,
            RandomPosition.Z
        )


    print(
        "[PLACE] PLACE:",
        Tool.Name,
        "| UID:",
        UID,
        "| Position:",
        RandomPosition
    )


    local Args = {

        [1] = {

            ["Uid"] =
                UID,

            ["LocalCFrame"] =
                LocalCFrame

        }

    }


    local Success,
        Result =
        pcall(function()

            return PlaceEggRemote:
                InvokeServer(
                    unpack(Args)
                )

        end)


    print(
        "[PLACE] Result:",
        Success,
        Result
    )


    return Success

end


--==================================================
-- PLACE UNTIL SUCCESS
--==================================================

local function PlaceEggUntilSuccess(
    Tool,
    Plot
)

    local Attempt =
        0


    while true do

        Attempt =
            Attempt + 1


        if not Tool
            or not Tool.Parent then

            print(
                "[PLACE] TOOL HILANG -> SUCCESS"
            )

            return true

        end


        local Equipped =
            GetEquippedTool()


        if Equipped ~= Tool then

            local Character =
                LocalPlayer.Character

            local Humanoid =
                Character
                and Character:
                FindFirstChildOfClass(
                    "Humanoid"
                )


            if Humanoid then

                pcall(function()

                    Humanoid:
                        EquipTool(
                            Tool
                        )

                end)

            end


            task.wait(
                0.2
            )

        end


        print(
            "[PLACE] ATTEMPT:",
            Attempt
        )


        PlaceEgg(
            Tool,
            Plot
        )


        local StartWait =
            tick()


        while tick() - StartWait <
            WAIT_TOOL_GONE do


            if not Tool.Parent then

                print(
                    "[PLACE] SUCCESS!"
                )

                return true

            end


            if GetEquippedTool()
                ~= Tool then

                print(
                    "[PLACE] TOOL NO LONGER EQUIPPED"
                )

                return true

            end


            task.wait(
                0.1
            )

        end


        warn(
            "[PLACE] ATTEMPT",
            Attempt,
            "GAGAL -> RANDOM POSISI BARU"
        )


        task.wait(
            PLACE_RETRY_DELAY
        )

    end

end


