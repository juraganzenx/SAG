        CarryEgg(
            Egg
        )


    if not CarrySuccess then

        warn(
            "[FIELD EGG] CARRY FAILED"
        )

        return false

    end


    task.wait(
        CARRY_DELAY
    )


    --==================================================
    -- FINAL TOOL VERIFY
    --==================================================

