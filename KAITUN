--==================================================
-- GET BEST FIELD EGG
--==================================================

local function GetBestEgg()

    local Folder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )


    local Seen = {}


    local BestEgg
    local BestScale = -math.huge
    local BestX = -math.huge
    local BestHighlight = false


    local function Process(
        Egg
    )

        if not Egg
            or not Egg:IsA("Model")
            or Seen[Egg] then

            return

        end


        Seen[Egg] = true


        local Scale =
            GetEggScale(
                Egg
            )


        local X =
            GetEggPivotX(
                Egg
            )


        local Highlight =
            HasEggHighlight(
                Egg
            )


        local Valid = false


        if Highlight then

            Valid = true

        elseif Scale >
            NORMAL_MIN_SCALE
            and X >
            NORMAL_MIN_PIVOT_X then

            Valid = true

        end


        if not Valid then
            return
        end


        if Highlight
            and not BestHighlight then

            BestEgg =
                Egg

            BestScale =
                Scale

            BestX =
                X

            BestHighlight =
                true

            return

        end


        if Highlight ==
            BestHighlight then

            if Scale >
                BestScale
                or (
                    Scale ==
                    BestScale
                    and X > BestX
                ) then

                BestEgg =
                    Egg

                BestScale =
                    Scale

                BestX =
                    X

            end

        end

    end


    if Folder then

        for _, Object in ipairs(
            Folder:GetDescendants()
        ) do

            Process(
                Object
            )

        end

    end


    for _, Object in ipairs(
        Workspace:GetChildren()
    ) do

        if Object:IsA(
            "Model"
        ) then

            Process(
                Object
            )

        end

    end


    if BestEgg then

        print(
            "[FIELD EGG] BEST:",
            BestEgg.Name,
            "| SCALE:",
            BestScale,
            "| X:",
            BestX
        )

    end


    return BestEgg

end


--==================================================
-- CARRY FIELD EGG
--==================================================

local function CarryEgg(
    Egg
)

    if not Egg
        or not Egg.Parent then

        warn(
            "[CARRY] EGG INVALID"
        )

        return false

    end


    local UID =
        Egg.Name


    print(
        "=========================================="
    )

    print(
        "[CARRY] EGG:",
        Egg.Name
    )

    print(
        "[CARRY] UID:",
        UID
    )


    for Attempt = 1,
        FIELD_CARRY_RETRIES do

        print(
            "[CARRY] ATTEMPT:",
            Attempt,
            "/",
            FIELD_CARRY_RETRIES
        )


        if not Egg.Parent then

            warn(
                "[CARRY] EGG DISAPPEARED"
            )

            return false

        end


        local Success,
            Result =
            pcall(function()

                return CarryEggRemote:
                    InvokeServer({

                        ["Uid"] =
                            UID

                    })

            end)


        print(
            "[CARRY] REMOTE:",
            Success,
            Result
        )


        if Success
            and Result ~= false then

            task.wait(
                0.15
            )


            local Tool =
                GetEquippedTool()


            if Tool then

                local ToolUID =
                    Tool:GetAttribute(
                        "UID"
                    )


                print(
                    "[CARRY] TOOL FOUND:",
                    Tool.Name
                )

                print(
                    "[CARRY] TOOL UID:",
                    ToolUID
                )


                if not ToolUID
                    or tostring(ToolUID)
                        == tostring(UID) then

                    print(
                        "[CARRY] SUCCESS"
                    )

                    return true

                end

            end

        end


        if Attempt <
            FIELD_CARRY_RETRIES then

            task.wait(
                FIELD_CARRY_RETRY_DELAY
            )

        end

    end


    warn(
        "[CARRY] FAILED AFTER RETRIES"
    )


    return false

end


