--==================================================
-- EGG SCALE
--==================================================

local function GetEggScale(
    EggData
)

    if typeof(EggData) ~= "table" then
        return -math.huge
    end


    local Scale =
        EggData.AssetScale


    if typeof(Scale) ~= "number" then

        Scale =
            EggData.Scale

    end


    if typeof(Scale) ~= "number" then

        return -math.huge

    end


    return Scale

end


--==================================================
-- FIND BEST INVENTORY EGG
--
-- Placement == nil
-- SCALE TERBESAR
--==================================================

local function GetBestInventoryEgg()

    local EggInventory =
        GetEggInventory()


    if not EggInventory then
        return nil
    end


    local Eggs = {}


    for UID, EggData in pairs(
        EggInventory
    ) do


        if typeof(UID) == "string"
            and typeof(EggData) == "table"
            and EggData.Placement == nil then


            local Scale =
                GetEggScale(
                    EggData
                )


            table.insert(
                Eggs,
                {
                    UID = UID,
                    Data = EggData,
                    Scale = Scale,
                }
            )

        end

    end


    if #Eggs == 0 then

        print(
            "[INVENTORY] TIDAK ADA EGG Placement=nil"
        )

        return nil

    end


    table.sort(
        Eggs,
        function(A, B)

            if A.Scale == B.Scale then

                return A.UID < B.UID

            end

            return A.Scale > B.Scale

        end
    )


    local Best =
        Eggs[1]


    print(
        "=========================================="
    )

    print(
        "[INVENTORY] BEST EGG"
    )

    print(
        "[INVENTORY] UID:",
        Best.UID
    )

    print(
        "[INVENTORY] SCALE:",
        Best.Scale
    )

    print(
        "[INVENTORY] CATEGORY:",
        Best.Data.AssetCategory
            or Best.Data.Category
            or "nil"
    )

    print(
        "[INVENTORY] PLACEMENT:",
        Best.Data.Placement
    )

    print(
        "=========================================="
    )


    return Best

end


--==================================================
-- FIND INVENTORY EGG BY UID
--==================================================

local function GetInventoryEggByUID(
    UID
)

    if not UID then
        return nil
    end


    local EggInventory =
        GetEggInventory()


    if not EggInventory then
        return nil
    end


    local EggData =
        EggInventory[
            tostring(UID)
        ]


    if typeof(EggData) ~= "table" then
        return nil
