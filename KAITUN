            GetEquippedTool()


        if Equipped then

            print(
                "[FUSE] FUSED EGG EQUIPPED:",
                Equipped.Name
            )

            return Equipped

        end


        local Backpack =
            GetBackpack()


        if Backpack then

            for _, Object in ipairs(
                Backpack:GetChildren()
