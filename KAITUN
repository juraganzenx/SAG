-- FIND 3 SAME PET
--==================================================

local function FindThreeSamePets()

    local Backpack =
        GetBackpack()


    if not Backpack then
        return nil
    end


    local Groups = {}


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if Tool:IsA("Tool")
            and not BLACKLIST[Tool.Name] then


            local Weight =
                Tool:GetAttribute(
                    "Weight"
                )


            local UID =
                Tool:GetAttribute(
                    "UID"
                )


            if typeof(Weight) == "number"
                and Weight < MAX_PET_WEIGHT
                and typeof(UID) == "string"
                and UID ~= "" then


                Groups[Tool.Name] =
                    Groups[Tool.Name]
                    or {}


                table.insert(
                    Groups[Tool.Name],
                    Tool
                )

            end

        end

    end


    for Name, Tools in pairs(
        Groups
    ) do

        if #Tools >= 3 then

            print(
                "=========================================="
            )

            print(
                "[FUSE] FOUND 3 SAME PET"
            )

            print(
                "[FUSE] NAME:",
                Name
            )

            print(
                "=========================================="
            )


            for i = 1, 3 do

                print(
                    "[FUSE] PET #" .. i,
                    "| NAME:",
                    Tools[i].Name,
                    "| WEIGHT:",
                    Tools[i]:GetAttribute(
                        "Weight"
                    ),
                    "| UID:",
                    Tools[i]:GetAttribute(
                        "UID"
                    )
                )

            end


            return
                Tools[1],
                Tools[2],
                Tools[3]

        end

    end


    return nil

end


