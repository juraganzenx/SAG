    )

    print(
        "=========================================="
    )


    if not LoadOnePet(
        Pet1,
        1
    ) then

        return false

    end


    if not LoadOnePet(
        Pet2,
        2
    ) then

        return false

    end


    if not LoadOnePet(
        Pet3,
        3
    ) then

        return false

    end


    if not StartFuse() then

        return false

    end


    print(
        "[FUSE] WAIT FUSE PROCESS..."
