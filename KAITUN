    end


    local StartPosition =
        GetPosition(
            StartArea
        )


    if not StartPosition then
        return false
    end


    StartPosition +=
        Vector3.new(
            -20,
            5,
            0
        )


    --==================================================
    -- TELEPORT START
    --==================================================

    if not AutoFlyToPosition(
        StartPosition,
        10,
        "FIELD:START"
    ) then

