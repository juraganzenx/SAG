--==================================================
-- GET PLOT AREA
--==================================================

local function GetPlotArea(
    Plot
)

    local BiggestPart =
        nil

    local BiggestArea =
        0


    for _, Object in ipairs(
        Plot:GetDescendants()
    ) do

        if Object:IsA("BasePart") then

            local Name =
                Object.Name:lower()


            if not Name:find("sign")
                and not Name:find("playername")
                and not Name:find("deco")
                and not Name:find("border")
                and not Name:find("wall")
                and not Name:find("fence") then


                local Area =
                    Object.Size.X *
                    Object.Size.Z


                if Area >
                    BiggestArea then

                    BiggestArea =
                        Area


                    BiggestPart =
                        Object

                end

            end

        end

    end


    return BiggestPart

end


--==================================================
-- RANDOM PLOT POSITION
--==================================================

local function GetRandomPosition(
    Plot,
    AreaPart
)

    local Size =
        AreaPart.Size


    local MinX =
        -Size.X / 2 + MARGIN


    local MaxX =
        Size.X / 2 - MARGIN


    local MinZ =
        -Size.Z / 2 + MARGIN


    local MaxZ =
        Size.Z / 2 - MARGIN


    local LocalX =
        MinX +
        math.random() *
        (MaxX - MinX)


    local LocalZ =
        MinZ +
        math.random() *
        (MaxZ - MinZ)


    local WorldPosition =
        AreaPart.CFrame:PointToWorldSpace(
            Vector3.new(
                LocalX,
                0,
                LocalZ
            )
        )


    local PlotPivot =
        Plot:GetPivot()


    local PlotLocalPosition =
        PlotPivot:PointToObjectSpace(
            WorldPosition
        )


    return Vector3.new(
        PlotLocalPosition.X,
        FIXED_Y,
        PlotLocalPosition.Z
    )

end


