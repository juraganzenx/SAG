    end


    task.wait(
        0.1
    )


    --==================================================
    -- CHECK EGG
    --==================================================

    if not Egg
        or not Egg.Parent then

        warn(
            "[FIELD EGG] EGG LOST BEFORE CARRY"
        )

        return false

    end


    --==================================================
    -- GET EGG POSITION
    --==================================================

    local EggPosition =
        GetPosition(
            Egg
        )


    if not EggPosition then

        warn(
            "[FIELD EGG] EGG POSITION INVALID"
        )

