--==================================================

local function WaitForEquippedTool(
    Timeout
)

    local StartTime =
        tick()


    while tick() - StartTime <
        Timeout do


        local Tool =
            GetEquippedTool()


        if Tool then

            print(
                "[TOOL] EQUIPPED:",
                Tool.Name
            )

            return Tool

        end


        task.wait(
            TOOL_CHECK_DELAY
        )

    end


    return nil

end


--==================================================
-- FUSE ONE PROCESS
--==================================================

local function ProcessOneFuse()

    --================================================
    -- FIND 3 PET
    --================================================

    local Pet1,
          Pet2,
          Pet3 =
        FindThreeSamePets()


    --================================================
    -- NO FUSE PET
    --================================================

    if not Pet1 then

        print("")
        print("==========================================")
        print("[FUSE] NO 3 SAME PET")
        print("[FUSE] FALLBACK -> AUTO EGG")
        print("==========================================")


        return "NO_FUSE_PET"

    end


    local Pets = {

        Pet1,
        Pet2,
        Pet3

    }


    --================================================
    -- LOAD
    --================================================

    local Loaded =
        LoadPets(
            Pets
        )


    if not Loaded then

        warn(
            "[FUSE] LoadPet gagal."
        )

        return false

    end


    --================================================
    -- BEGIN
    --================================================

    local Started =
        BeginFusion()


    if not Started then

        warn(
            "[FUSE] BeginFuse gagal."
        )

        return false

    end


    --================================================
    -- FINISH
    --================================================

    local Finished =
        FinishFusion()


    if not Finished then

        warn(
            "[FUSE] FinishReveal gagal."
        )

        return false

    end


    --================================================
    -- WAIT FUSED EGG
    --================================================

    print(
        "[FUSE] WAITING FUSED EGG TOOL..."
    )


    local Tool =
        WaitForEquippedTool(
            WAIT_TOOL_TIMEOUT
        )


    if not Tool then

        warn(
            "[FUSE] Fused egg/tool tidak muncul."
        )

        return false

    end


    task.wait(
        0.5
    )


    --================================================
    -- FIND PLOT
    --================================================

    local Plot =
        GetMyPlot()


    if not Plot then

        warn(
            "[FUSE] Own plot tidak ditemukan."
        )

        return false

    end


    --================================================
    -- FLY PLOT
    --================================================

    print(
        "[FUSE] -> FLY OWN PLOT"
    )


    local Reached =
        FlyToObject(
            Plot,
            REACH_DISTANCE,
            "FUSE"
        )


    if not Reached then

        warn(
            "[FUSE] Gagal fly ke plot."
        )

        return false

    end


    --================================================
    -- CHECK TOOL
    --================================================

    local CurrentTool =
        GetEquippedTool()


    if not CurrentTool then

        warn(
            "[FUSE] Egg sudah tidak equipped."
        )

        return false

    end


    --================================================
    -- PLACE
    --================================================

    local Placed =
        PlaceEgg(
            CurrentTool,
            Plot,
            "FUSE"
        )


    if not Placed then

        warn(
            "[FUSE] Place fused egg gagal."
        )

        return false

    end


    --================================================
    -- WAIT GONE
    --================================================

    WaitToolGone(
        CurrentTool,
        WAIT_TOOL_GONE
    )


    print("")
    print("==========================================")
    print("[FUSE] FUSE + PLACE SELESAI")
    print("==========================================")


    task.wait(
        AFTER_REVEAL_DELAY
    )


    return true

