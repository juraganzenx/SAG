    end


    return true

end


--==================================================
-- PROCESS INVENTORY EGG
--==================================================

local function ProcessInventoryEgg(
    EggData,
    Index,
    Total
)

    local UID =
        EggData.UID


    print(
        "[INV] PROCESS:",
        Index,
        "/",
        Total,
        "| UID:",
