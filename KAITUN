local function LoadOnePet(
    Tool,
    Index
)

    if not Tool
        or not Tool.Parent then

        warn(
            "[FUSE] Pet #" .. Index ..
            " sudah tidak ada."
        )

        return false

    end


    local UID =
        Tool:GetAttribute(
            "UID"
        )


    if not UID then

        warn(
            "[FUSE] UID tidak ditemukan:",
            Tool.Name
        )

        return false

    end


    print(
        "------------------------------------------"
    )


    print(
        "[FUSE] LOAD PET #" .. Index
    )


    print(
        "[FUSE] Name:",
        Tool.Name
    )


    print(
        "[FUSE] Weight:",
        Tool:GetAttribute(
            "Weight"
        )
    )


    print(
        "[FUSE] UID:",
        UID
    )


    local Success, Result =
        pcall(function()

            return LoadPet:InvokeServer(
                UID
            )

        end)


    print(
        "[FUSE] LoadPet Success:",
        Success
    )


    print(
        "[FUSE] LoadPet Result:",
        Result
    )


    if not Success then

        warn(
            "[FUSE] LoadPet ERROR"
        )

        return false

    end


    task.wait(
        FUSE_PROCESS_DELAY
    )


    return true

end


