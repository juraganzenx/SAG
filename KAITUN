        HATCH_RESUME_TIME
    )


    print(
        "=========================================="
    )

    print(
        "[INV] PROCESS SNAPSHOT:",
        #Snapshot
    )

    print(
        "=========================================="
    )


    for Index, EggData in ipairs(
        Snapshot
    ) do

        local Success,
            Error =
            xpcall(
                function()

                    ProcessInventoryEgg(
                        EggData,
                        Index,
                        #Snapshot
                    )

                end,
                debug.traceback
            )


        if not Success then

            warn(
                "[INV] ERROR:",
                Error
            )

            StopFly()

            MovementOwner =
                nil

        end


        if Index <
            #Snapshot then

            task.wait(
                LOOP_DELAY
            )

        end

    end


    print(
        "[INV] SNAPSHOT COMPLETE"
    )


    return true

end


