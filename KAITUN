--==================================================
-- FIND 3 SAME PETS
--==================================================

local function FindThreeSamePets()

    local Backpack =
        LocalPlayer:WaitForChild(
            "Backpack"
        )


    local Groups =
        {}


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if Tool:IsA("Tool")
            and not BLACKLIST[Tool.Name] then


            local Weight =
                Tool:GetAttribute(
                    "Weight"
                )


            local UID =
                Tool:GetAttribute(
                    "UID"
                )


            if typeof(Weight) == "number"
                and Weight < MAX_WEIGHT
                and typeof(UID) == "string"
                and UID ~= "" then


                if not Groups[
                    Tool.Name
                ] then

                    Groups[
                        Tool.Name
                    ] = {}

                end


                table.insert(
                    Groups[
                        Tool.Name
                    ],
                    Tool
                )

            end

        end

    end


    --================================================
    -- FIND GROUP
    --================================================

    for Name, Tools in pairs(Groups) do

        if #Tools >= 3 then

            print("")
            print("==========================================")
            print("[FUSE] FOUND 3 SAME PET")
            print("[FUSE] NAME:", Name)
            print("==========================================")


            for i = 1, 3 do

                print(
                    "[FUSE] PET #" .. i,
                    "| Name:",
                    Tools[i].Name,
                    "| Weight:",
                    Tools[i]:GetAttribute("Weight"),
                    "| UID:",
                    Tools[i]:GetAttribute("UID")
                )

            end


            return
                Tools[1],
                Tools[2],
                Tools[3]

        end

    end


    print(
        "[FUSE] NO GROUP OF 3 FOUND"
    )


    return nil

end


--==================================================
-- LOAD PETS
--==================================================

local function LoadPets(Pets)

    for i, Tool in ipairs(Pets) do

        --============================================
        -- CHECK TOOL
        --============================================

        if not Tool
            or not Tool.Parent then

            warn(
                "[FUSE] Pet #" .. i ..
                " sudah tidak tersedia."
            )

            return false

        end


        --============================================
        -- CHECK BLACKLIST
        --============================================

        if BLACKLIST[Tool.Name] then

            warn(
                "[FUSE] BLACKLIST PET:",
                Tool.Name
            )

            return false

        end


        --============================================
        -- CHECK WEIGHT
        --============================================

        local Weight =
            Tool:GetAttribute(
                "Weight"
            )


        if typeof(Weight) ~= "number"
            or Weight >= MAX_WEIGHT then

            warn(
                "[FUSE] Weight tidak valid:",
                Tool.Name,
                Weight
            )

            return false

        end


        --============================================
        -- UID
        --============================================

        local UID =
            Tool:GetAttribute(
                "UID"
            )


        if typeof(UID) ~= "string"
            or UID == "" then

            warn(
                "[FUSE] UID invalid pet #" .. i
            )

            return false

        end


        print("")
        print("------------------------------------------")
        print("[FUSE] LOAD PET #" .. i)
        print("Name:", Tool.Name)
        print("Weight:", Weight)
        print("UID:", UID)
        print("------------------------------------------")


        --============================================
        -- LOAD
        --============================================

        local Success, Result =
            pcall(function()

                return LoadPet:InvokeServer(
                    UID
                )

            end)


        print(
            "[FUSE] LoadPet:",
            Success,
            Result
        )


        if not Success then

            warn(
                "[FUSE] LoadPet gagal #" .. i
            )

            return false

        end


        --============================================
        -- DELAY
        --============================================

        task.wait(
            LOAD_DELAY
        )

    end


    return true

end


