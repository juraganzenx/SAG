local function GetBestEgg()

    local EggFolder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )


    if not EggFolder then

        warn(
            "[AUTO EGG] EGG FOLDER TIDAK DITEMUKAN"
        )

        return nil

    end


    local BestHighlight = nil

    local BestHighlightScale =
        -math.huge

    local BestHighlightPivotX =
        -math.huge


    local BestNormal = nil

    local BestNormalScale =
        -math.huge

    local BestNormalPivotX =
        -math.huge


    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do


        if Object:IsA("Model") then


            local Scale =
                GetEggScaleWorld(
                    Object
                )


            local PivotX =
                GetEggWorldPivotX(
                    Object
                )


            local Highlight =
                HasHighlight(
                    Object
                )


            if Highlight then


                if Scale >
                    BestHighlightScale then

                    BestHighlight =
                        Object

                    BestHighlightScale =
                        Scale

                    BestHighlightPivotX =
                        PivotX


                elseif Scale ==
                    BestHighlightScale

                    and PivotX >
                        BestHighlightPivotX then

                    BestHighlight =
                        Object

                    BestHighlightScale =
                        Scale

                    BestHighlightPivotX =
                        PivotX

                end


            elseif Scale >
                    NORMAL_MIN_SCALE

                and PivotX >
                    NORMAL_MIN_PIVOT_X then


                if Scale >
                    BestNormalScale then

                    BestNormal =
                        Object

                    BestNormalScale =
                        Scale

                    BestNormalPivotX =
                        PivotX


                elseif Scale ==
                    BestNormalScale

                    and PivotX >
                        BestNormalPivotX then

                    BestNormal =
                        Object

                    BestNormalScale =
                        Scale

                    BestNormalPivotX =
                        PivotX

                end

            end

        end

    end


    if BestHighlight then

        print(
            "[AUTO EGG] BEST HIGHLIGHT:",
            BestHighlight.Name,
            "| SCALE:",
            BestHighlightScale,
            "| X:",
            BestHighlightPivotX
        )

        return BestHighlight

    end


    if BestNormal then

        print(
            "[AUTO EGG] BEST NORMAL:",
            BestNormal.Name,
            "| SCALE:",
            BestNormalScale,
            "| X:",
            BestNormalPivotX
        )

        return BestNormal

    end


    print(
        "[AUTO EGG] NO VALID FIELD EGG"
    )


    return nil

end


