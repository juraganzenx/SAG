                BestHighlightScale = Scale
                BestHighlightPivotX = PivotX

            end


        -- PRIORITAS #2: NORMAL FIELD EGG
        elseif Scale > NORMAL_MIN_SCALE
            and PivotX > NORMAL_MIN_PIVOT_X then

            if Scale > BestNormalScale
                or (
                    Scale == BestNormalScale
                    and PivotX > BestNormalPivotX
                ) then

                BestNormal = Object
                BestNormalScale = Scale
                BestNormalPivotX = PivotX

            end

        end

    end


    --==================================================
    -- #1 SCAN AreaEggSlotsClient
    --==================================================

    if EggFolder then

        for _, Object in ipairs(
            EggFolder:GetDescendants()
        ) do

            ProcessEgg(
                Object
            )

        end

    else

        warn(
            "[AUTO EGG] EGG FOLDER TIDAK DITEMUKAN:",
            EGG_FOLDER_NAME
        )

    end


    --==================================================
    -- #2 SCAN CHILD LANGSUNG DI WORKSPACE
    --
    -- FORMAT TARGET:
    -- Workspace
    -- └── RandomString
    --     └── Highlight
    --
    -- BUKAN scan seluruh Workspace:GetDescendants()
    --==================================================

    for _, Object in ipairs(
        Workspace:GetChildren()
    ) do

        if Object ~= EggFolder
            and Object:IsA("Model") then

            local DirectHighlight =
                Object:FindFirstChildOfClass(
                    "Highlight"
                )

            if DirectHighlight
                and DirectHighlight.Name
                    ~= "MonsterParasiteHighlight" then

                ProcessEgg(
                    Object
                )

            end

        end

    end


    --==================================================
    -- RESULT
    --==================================================

    if BestHighlight then

        print(
            "[AUTO EGG] BEST HIGHLIGHT:",
            BestHighlight.Name,
            "| PATH:",
            BestHighlight:GetFullName(),
            "| SCALE:",
            BestHighlightScale,
            "| X:",
            BestHighlightPivotX
        )

        return BestHighlight

    end


    if BestNormal then

        print(
            "[AUTO EGG] BEST NORMAL:",
            BestNormal.Name,
            "| PATH:",
            BestNormal:GetFullName(),
            "| SCALE:",
            BestNormalScale,
            "| X:",
            BestNormalPivotX
        )

        return BestNormal

    end


    print(
        "[AUTO EGG] NO VALID FIELD EGG"
    )

    return nil

