            --========================================

            local StartArea =
                GetStartArea()


            if not StartArea then

                warn(
                    "[AUTO EGG] StartArea tidak ditemukan."
                )

                task.wait(2)

                return

            end


            --========================================
            -- STEP 3
            -- FLY START
            --========================================

            print(
                "[AUTO EGG] -> FLY START AREA"
            )


            local StartPosition =
                GetPosition(StartArea)


            if StartPosition then

                StartPosition =
                    StartPosition +
                    Vector3.new(
                        -20,
                        5,
                        0
                    )

            end


            local StartReached =
                AutoFlyToPosition(
                    StartPosition,
                    REACH_DISTANCE,
                    "MAIN:StartArea"
                )


            if not StartReached then

                return

            end


            --========================================
            -- STEP 4
            -- VALIDATE EGG
            --========================================

            if not Egg
                or not Egg.Parent then

                print(
                    "[AUTO EGG] Egg sudah hilang."
                )

                return

            end


            local IsHighlight =
                HasHighlight(Egg)


            if not IsHighlight then

                local Scale =
                    GetEggScale(Egg)


                local PivotX =
                    GetEggWorldPivotX(Egg)


                if Scale <=
                    NormalEggConfig.MIN_SCALE
                    or PivotX <=
                    NormalEggConfig.MIN_WORLD_PIVOT_X then

                    print(
                        "[AUTO EGG] Egg tidak valid lagi."
                    )

                    return

                end

            end


            --========================================
