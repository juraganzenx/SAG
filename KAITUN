--==================================================
-- FUSE:
-- FIND 3 SAME PET
--==================================================

local function FindThreeSamePets()

    local Backpack =
        GetBackpack()


    if not Backpack then

        return nil

    end


    local Groups =
        {}


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if Tool:IsA("Tool") then

            if Blacklist[Tool.Name] then

                print(
                    "[FUSE] BLACKLIST:",
                    Tool.Name
                )

                continue

            end


            local Weight =
                Tool:GetAttribute(
                    "Weight"
                )


            local UID =
                Tool:GetAttribute(
                    "UID"
                )


            if typeof(Weight) == "number"
                and Weight < MAX_WEIGHT
                and typeof(UID) == "string"
                and UID ~= "" then


                if not Groups[Tool.Name] then

                    Groups[Tool.Name] =
                        {}

                end


                table.insert(
                    Groups[Tool.Name],
                    Tool
                )

            end

        end

    end


    for Name, Tools in pairs(
        Groups
    ) do

        if #Tools >= 3 then

            print(
                "=========================================="
            )

            print(
                "[FUSE] FOUND 3 PET"
            )

            print(
                "[FUSE] NAME:",
                Name
            )


            for i = 1, 3 do

                print(
                    "[FUSE]",
                    i,
                    Tools[i].Name,
                    "| Weight:",
                    Tools[i]:GetAttribute("Weight"),
                    "| UID:",
                    Tools[i]:GetAttribute("UID")
                )

            end


            print(
                "=========================================="
            )


            return
                Tools[1],
                Tools[2],
                Tools[3]

        end

    end


    return nil

end


