--==================================================
-- SLOT KEY
--==================================================

local function GetFirstAreaSlotKey(
Egg
)


if not Egg then
    return nil
end


local Attribute =
    Egg:GetAttribute(
        "FirstAreaSlotKey"
    )


if typeof(Attribute) == "string"
    and Attribute ~= "" then

    return Attribute

end


if Egg.Parent then

    local ParentAttribute =
        Egg.Parent:GetAttribute(
            "FirstAreaSlotKey"
        )


    if typeof(ParentAttribute) == "string"
        and ParentAttribute ~= "" then

        return ParentAttribute

    end

end


local UID =
    Egg.Name


local SlotKey =
    string.match(
        UID,
        "([%w]+:Slot_%d+)$"
    )


if SlotKey then
    return SlotKey
end


return nil


end

