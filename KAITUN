local UserId =
    tostring(
        LocalPlayer.UserId
    )


local function GetActiveRenders()

    local Renders =
        {}


    for _, Object in ipairs(
        Workspace:GetChildren()
    ) do

        if Object.Name ==
            "PlacedEggRenders"
            and #Object:GetChildren() > 0 then

            table.insert(
                Renders,
                Object
            )

        end

    end


    return Renders

end


local function IsMyEgg(
    Egg
)

    if not Egg then

        return false

    end


    return string.match(
        Egg.Name,
        "^" .. UserId .. "_"
    ) ~= nil

end


local function GetPlacedEggPosition(
    Egg
)

    if not Egg
        or not Egg.Parent then

        return nil

    end


    if Egg:IsA("BasePart") then

        return Egg.Position

    end


    if Egg:IsA("Model") then

        local Success,
            Pivot =
            pcall(function()

                return Egg:GetPivot()

            end)


        if Success and Pivot then

            return Pivot.Position

        end

    end


    local Part =
        Egg:FindFirstChildWhichIsA(
            "BasePart",
            true
        )


    if Part then

        return Part.Position

    end


    return nil

end


local function FindMyPlacedEgg()

    for _, Render in ipairs(
        GetActiveRenders()
    ) do

        for _, Egg in ipairs(
            Render:GetChildren()
        ) do

            if IsMyEgg(Egg) then

                return Egg

            end

        end

    end


    return nil

end


--==================================================
-- HATCH
--==================================================

local TriggeredPrompts =
    {}


local function TriggerNearbyPrompts()

    local Root =
        GetRoot()


    if not Root then

        return

    end


    for _, Prompt in ipairs(
        Workspace:GetDescendants()
    ) do

        if Prompt:IsA("ProximityPrompt")
            and Prompt.Enabled then


            local Part =
                Prompt.Parent


            if Part
                and Part:IsA("BasePart") then


                local Distance =
                    (
                        Root.Position -
                        Part.Position
                    ).Magnitude


                if Distance <
                    MAX_PROMPT_DISTANCE then


                    if not TriggeredPrompts[
                        Prompt
                    ] then

                        TriggeredPrompts[
                            Prompt
                        ] = true


                        pcall(function()

                            fireproximityprompt(
                                Prompt
                            )

                        end)

                    end

                else

                    TriggeredPrompts[
                        Prompt
                    ] = nil

                end

            end

        end

    end

end


local function HatchEggProcess()

    local Egg =
        FindMyPlacedEgg()


    if not Egg then

        return

    end


    local Position =
        GetPlacedEggPosition(
            Egg
        )


    if not Position then

        return

    end


    local Reached =
        AutoFlyToPosition(
            Position,
            WALK_TO_EGG_DISTANCE,
            "HATCH:" .. Egg.Name
        )


    if not Reached then

        return

    end


    TriggeredPrompts =
        {}


    local StartTime =
        tick()


    while tick() - StartTime <
        HATCH_MAX_TIME do


        if not Egg
            or not Egg.Parent then

            print(
                "[AUTO HATCH] SUCCESS"
            )

            return

        end


        TriggerNearbyPrompts()


        task.wait(
            PROMPT_CHECK_DELAY
        )

    end


    warn(
        "[AUTO HATCH] TIMEOUT"
    )

end


local function StartHatch()

    if HatchRunning then

        return

    end


    HatchRunning =
        true


    task.spawn(function()

        local Success,
            Error =
            xpcall(
                HatchEggProcess,
                debug.traceback
            )


        if not Success then

            warn(
                "[AUTO HATCH] ERROR:",
                Error
            )

            StopFly()

        end


        HatchRunning =
            false

    end)

end


