            )


            for Index, Egg in ipairs(
                Eggs
            ) do

                print(
                    "[HATCH] PROCESS:",
                    Index,
                    "/",
                    #Eggs
                )


                if Egg.Parent then

                    HatchOneEgg(
                        Egg
                    )

                end


                task.wait(
                    HATCH_RESUME_TIME
                )

            end

        end,
        debug.traceback)


    if not Success then

        warn(
            "[HATCH] ERROR:",
            Error
        )

    end


    HatchRunning = false

end


