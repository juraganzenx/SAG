            -- FLY EGG
            --========================================

            print(
                "[AUTO EGG] -> FLY EGG:",
                Egg.Name
            )


            local ReachedEgg =
                FlyToObject(
                    Egg
                )


            if not ReachedEgg then

                return

            end


            --========================================
            -- STEP 6
            -- CARRY
            --========================================

            task.wait(
                AFTER_CARRY_START_DELAY
            )


            local Carried =
                CarryEgg(Egg)


            if not Carried then

                warn(
                    "[AUTO EGG] Carry gagal."
                )

                return

            end


            task.wait(
                CARRY_DELAY
            )


            --========================================
            -- STEP 7
            -- RETURN START
            --========================================

            print(
                "[AUTO EGG] -> FLY START AREA"
            )


            StartPosition =
                GetPosition(StartArea)


            if StartPosition then

                StartPosition =
                    StartPosition +
                    Vector3.new(
                        -20,
                        5,
                        0
                    )

            end


            StartReached =
                AutoFlyToPosition(
                    StartPosition,
                    REACH_DISTANCE,
                    "MAIN:StartArea"
                )


            if not StartReached then

                return

            end


            --========================================
            -- STEP 8
            -- WAIT
            --========================================

            print(
                "[AUTO EGG] Sampai StartArea."
            )


            print(
                "[AUTO EGG] Menunggu",
                WAIT_AFTER_RETURN,
                "detik..."
            )


            task.wait(
                WAIT_AFTER_RETURN
            )


            --========================================
            -- STEP 9
            -- CHECK TOOL
            --========================================

            print(
                "[AUTO EGG] STEP 9 -> CHECK TOOL"
            )


            local Tool =
                GetEquippedTool()


            if not Tool then

                print(
                    "[AUTO EGG] Tool BELUM EQUIPPED."
                )


                Tool =
                    WaitForEquippedTool(
                        5
                    )

            end


            if not Tool then

                print(
                    "[AUTO EGG] Tool tidak muncul."
                )

                return

            end


            print(
                "[AUTO EGG] TOOL:",
                Tool.Name
            )


            print(
                "[AUTO EGG] TOOL UID:",
                Tool:GetAttribute("UID")
            )


            --========================================
            -- STEP 9.5
            -- CHECK MONSTER PARASITE
            --
            -- IMPORTANT:
            -- NO UID USED HERE
            -- SCAN ENTIRE ottoko_store
            --========================================

            print(
                "=========================================="
            )


            print(
                "[AUTO EGG] STEP 9.5 -> CHECK PARASITE"
            )


            print(
                "[AUTO EGG] SCANNING:",
                "workspace.ottoko_store"
            )


            local ParasiteHandled =
                CheckAndFeedParasite()


            if ParasiteHandled then

                print(
                    "[AUTO EGG] =========================================="
                )


                print(
                    "[AUTO EGG] PARASITE PROCESS HANDLED"
                )


                print(
                    "[AUTO EGG] PLACE DI-SKIP"
                )


                print(
                    "[AUTO EGG] -> NEXT EGG"
                )


                print(
                    "[AUTO EGG] =========================================="
                )


                return

            end


            --========================================
            -- STEP 10
            -- OWN PLOT
            --========================================

            print(
                "[AUTO PLACE] Tool terdeteksi:",
                Tool.Name
            )


            local Plot =
                GetMyPlot()


            if not Plot then

                return

            end


            --========================================
            -- STEP 11
            -- FLY PLOT
            --========================================

            print(
                "[AUTO PLACE] -> FLY OWN PLOT"
            )


            local ReachedPlot =
                FlyToObject(
                    Plot
                )


            if not ReachedPlot then

                return

            end


            --========================================
            -- STEP 12
            -- CHECK TOOL AGAIN
            --========================================

            local CurrentTool =
                GetEquippedTool()


            if not CurrentTool then

                warn(
                    "[AUTO PLACE] Tool sudah tidak equipped."
                )

                return

            end


            --========================================
            -- STEP 12.5
            -- PARASITE SAFETY RECHECK
            --========================================

            print(
                "[AUTO PLACE] RECHECK PARASITE..."
            )


            local ParasiteAfterPlot =
                CheckAndFeedParasite()


            if ParasiteAfterPlot then

                print(
                    "[AUTO PLACE] PARASITE TERDETEKSI."
                )


                print(
                    "[AUTO PLACE] PLACE DIBATALKAN."
                )


                return

            end


            --========================================
            -- STEP 13
            -- PLACE
            --========================================

            local Placed =
                PlaceEgg(
                    CurrentTool,
                    Plot
                )


            if not Placed then

                warn(
                    "[AUTO PLACE] Place gagal."
                )

                return

            end


            print(
                "[AUTO PLACE] PLACE REQUEST SENT."
            )


            --========================================
            -- STEP 14
            -- WAIT TOOL GONE
            --========================================

            local Gone =
                WaitToolGone(
                    CurrentTool,
                    WAIT_TOOL_GONE
                )


            if Gone then

                print(
                    "[AUTO PLACE] Tool sudah hilang."
                )

            else

                warn(
                    "[AUTO PLACE] Tool masih ada."
                )

            end


            --========================================
            -- STEP 15
            -- START HATCH
            --========================================

            print(
                "[AUTO HATCH] START HATCH PROCESS"
            )


            StartHatch()


            --========================================
            -- STEP 16
            -- RESUME AFTER 5 SEC
            --========================================

            print(
                "[AUTO HATCH] Menunggu",
                HATCH_RESUME_TIME,
                "detik..."
            )


            task.wait(
                HATCH_RESUME_TIME
            )


            print(
                "[AUTO EGG] RESUME -> CARI EGG BERIKUTNYA"
            )


        end,
        debug.traceback
    )


    --================================================
    -- RELEASE PROCESS LOCK
    --================================================

    ProcessRunning = false


    if not Success then

        warn(
            "[AUTO EGG] PROCESS ERROR:",
            Error
        )


        StopFly()

    end

end


