--==================================================
-- GET BEST NORMAL EGG
--
-- PRIORITY:
-- 1. SCALE TERBESAR
-- 2. SCALE SAMA -> PIVOT X TERBESAR
--==================================================

local function GetLargestNormalEgg()

    if not NormalEggConfig.Enabled then

        return nil

    end


    local EggFolder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )


    if not EggFolder then

        return nil

    end


    local SelectedEgg =
        nil

    local LargestScale =
        NormalEggConfig.MIN_SCALE

    local HighestPivotX =
        NormalEggConfig.MIN_WORLD_PIVOT_X


    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model") then

            if not HasHighlight(Object) then

                local Scale =
                    GetEggScale(
                        Object
                    )

                local PivotX =
                    GetEggWorldPivotX(
                        Object
                    )


                if Scale >
                    NormalEggConfig.MIN_SCALE
                    and PivotX >
                    NormalEggConfig.MIN_WORLD_PIVOT_X then


                    if Scale >
                        LargestScale then

                        LargestScale =
                            Scale

                        HighestPivotX =
                            PivotX

                        SelectedEgg =
                            Object


                    elseif Scale ==
                        LargestScale
                        and PivotX >
                        HighestPivotX then

                        HighestPivotX =
                            PivotX

                        SelectedEgg =
                            Object

                    end

                end

            end

        end

    end


    if SelectedEgg then

        print(
            "[AUTO EGG] BEST NORMAL EGG:",
            SelectedEgg.Name,
            "| Scale:",
            LargestScale,
            "| PivotX:",
            HighestPivotX
        )

    end


    return SelectedEgg

end


