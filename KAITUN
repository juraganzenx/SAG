--==================================================
-- PLACE FUSED EGG
--==================================================

local function PlaceFusedEgg(
    FusedEgg
)

    local Plot =
        GetMyPlot()


    if not Plot then
        return false
    end


    if TreadmillRunning then

        if not ExitTreadmill() then
            return false
        end

    end


    if not FlyToObject(
        Plot,
        REACH_DISTANCE,
        "FUSE:PLOT"
    ) then

        return false

    end


    local Tool =
        GetEquippedTool()


    if not Tool then
        return false
    end


    if Tool ~= FusedEgg then
        return false
    end


    if not PlaceEggOnce(
        Tool,
        Plot
    ) then

        return false

    end


    WaitToolGone(
        Tool,
        WAIT_TOOL_GONE
    )


    print(
        "[FUSE] EGG PLACED - NO HATCH"
    )


    return true

end


