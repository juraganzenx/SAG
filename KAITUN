--==================================================
-- MOVEMENT LOCK
--==================================================

local function AcquireMovementLock(
    Name
)

    if MovementOwner ~= nil then

        warn(
            "[FLY] MOVEMENT BUSY:",
            MovementOwner,
            "| REQUEST:",
            Name
        )

        return false

    end


    MovementOwner = Name


    print(
        "[FLY] LOCK:",
        Name
    )


    return true

end


local function ReleaseMovementLock(
    Name
)

    if MovementOwner == Name then

        MovementOwner = nil


        print(
            "[FLY] RELEASE:",
            Name
        )

    end

end


local function StopFly()

    local Root =
        GetRoot()


    if Root then

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end

end


--==================================================
-- AUTO FLY
--==================================================

local function AutoFlyToPosition(
    TargetPosition,
    Distance,
    LockName
)

    if not TargetPosition then
        return false
    end


    Distance =
        Distance
        or REACH_DISTANCE


    LockName =
        LockName
        or "AUTO_FLY"


    if not AcquireMovementLock(
        LockName
    ) then

        return false

    end


    local Root =
        GetRoot()

    local Humanoid =
        GetHumanoid()


    if not Root or not Humanoid then

        ReleaseMovementLock(
            LockName
        )

        return false

    end


    print(
        "[FLY] START:",
        LockName
    )

    print(
        "[FLY] TARGET:",
        TargetPosition
    )


    local OldPlatformStand =
        Humanoid.PlatformStand

    local OldAutoRotate =
        Humanoid.AutoRotate


    Humanoid.PlatformStand =
        true

    Humanoid.AutoRotate =
        false


    local BG =
        Instance.new(
            "BodyGyro"
        )


    BG.Name =
        "AutoFuseEggGyro"


    BG.P =
        9e4


    BG.MaxTorque =
        Vector3.new(
            9e9,
            9e9,
            9e9
        )


    BG.CFrame =
        Root.CFrame


    BG.Parent =
        Root


    local BV =
        Instance.new(
            "BodyVelocity"
        )


    BV.Name =
        "AutoFuseEggVelocity"


    BV.MaxForce =
        Vector3.new(
            9e9,
            9e9,
            9e9
        )


    BV.Velocity =
        Vector3.zero


    BV.Parent =
        Root


    local Success =
        false


    local StartTime =
        tick()


    while true do

        Root =
            GetRoot()

        Humanoid =
            GetHumanoid()


        if not Root or not Humanoid then
            break
        end


        if tick() - StartTime >
            FLY_MAX_TIME then

            warn(
                "[FLY] TIMEOUT:",
                LockName
            )

            break

        end


        local Offset =
            TargetPosition
            - Root.Position


        local CurrentDistance =
            Offset.Magnitude


        if CurrentDistance <= Distance then

            Success =
                true


            print(
                "[FLY] REACHED:",
                LockName,
                "| DIST:",
                math.floor(
                    CurrentDistance * 10
                ) / 10
            )


            break

        end


        local Direction =
            CurrentDistance > 0
            and Offset.Unit
            or Vector3.zero


        local CurrentSpeed =
            math.min(
                FLY_SPEED,
                math.max(
                    100,
                    CurrentDistance * 8
                )
            )


        BV.Velocity =
            Direction * CurrentSpeed


        if Direction.Magnitude > 0 then

            BG.CFrame =
                CFrame.lookAt(
                    Root.Position,
                    Root.Position + Direction
                )

        end


        task.wait(
            FLY_UPDATE_DELAY
        )

    end


    BV.Velocity =
        Vector3.zero


    StopFly()


    if BG then
        BG:Destroy()
    end


    if BV then
        BV:Destroy()
    end


    Humanoid =
        GetHumanoid()


    if Humanoid then

        Humanoid.PlatformStand =
            OldPlatformStand

        Humanoid.AutoRotate =
            OldAutoRotate

    end


    StopFly()


    ReleaseMovementLock(
        LockName
    )


    print(
        "[FLY] END:",
        LockName,
        "| SUCCESS:",
        Success
    )


    return Success

end


--==================================================
-- GET POSITION
--==================================================

local function GetPosition(
    Object
)

    if not Object then
        return nil
    end


    if Object:IsA(
        "BasePart"
    ) then

        return Object.Position

    end


    if Object:IsA(
        "Model"
    ) then

        local Success,
            Pivot =
            pcall(function()

                return Object:GetPivot()

            end)


        if Success and Pivot then
            return Pivot.Position
        end

    end


    return nil

end


local function FlyToObject(
    Object,
    Distance,
    LockName
)

    if not Object then
        return false
    end


    local Position =
        GetPosition(
            Object
        )


    if not Position then

        warn(
            "[FLY] POSITION NOT FOUND:",
            Object.Name
        )

        return false

    end


    return AutoFlyToPosition(
        Position,
        Distance or REACH_DISTANCE,
        LockName
            or ("MAIN:" .. Object.Name)
    )

end


--==================================================
-- FIND 3 SAME PET
--==================================================

local function FindThreeSamePets()

    local Backpack =
        GetBackpack()


    if not Backpack then
        return nil
    end


    local Groups = {}


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do


        if Tool:IsA("Tool")
            and not BLACKLIST[Tool.Name] then


            local Weight =
                Tool:GetAttribute(
                    "Weight"
                )


            local UID =
                Tool:GetAttribute(
                    "UID"
                )


            if typeof(Weight) == "number"
                and Weight < MAX_PET_WEIGHT
                and typeof(UID) == "string"
                and UID ~= "" then


                Groups[Tool.Name] =
                    Groups[Tool.Name]
                    or {}


                table.insert(
                    Groups[Tool.Name],
                    Tool
                )

            end

        end

    end


    for Name, Tools in pairs(
        Groups
    ) do


        if #Tools >= 3 then

            print(
                "=========================================="
            )

            print(
                "[FUSE] FOUND 3 SAME PET"
            )

            print(
                "[FUSE] NAME:",
                Name
            )

            print(
                "=========================================="
            )


            for i = 1, 3 do

                print(
                    "[FUSE] PET #" .. i,
                    "| NAME:",
                    Tools[i].Name,
                    "| WEIGHT:",
                    Tools[i]:GetAttribute(
                        "Weight"
                    ),
                    "| UID:",
                    Tools[i]:GetAttribute(
                        "UID"
                    )
                )

            end


            return
                Tools[1],
                Tools[2],
                Tools[3]

        end

    end


    return nil

end


