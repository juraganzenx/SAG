        "[FIELD EGG] TELEPORT CARRY POSITION:",
        CarryPosition
    )


    if not AutoFlyToPosition(
        CarryPosition,
        10,
        "FIELD:CARRY"
    ) then

        warn(
            "[FIELD EGG] TELEPORT CARRY POSITION FAILED"
        )

        return false

    end


    task.wait(
        0.15
    )


    --==================================================
    -- CARRY
    --==================================================

