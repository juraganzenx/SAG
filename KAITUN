--==================================================

local function FindThreeSamePets()


local Backpack =
    GetBackpack()


if not Backpack then
    return nil
end


local Groups =
    {}


for _, Tool in ipairs(
    Backpack:GetChildren()
) do

    if Tool:IsA("Tool")
        and not BLACKLIST[Tool.Name] then


        local Weight =
            Tool:GetAttribute(
                "Weight"
            )


        local UID =
            Tool:GetAttribute(
                "UID"
            )


        if typeof(Weight) == "number"
            and Weight < MAX_PET_WEIGHT
            and typeof(UID) == "string"
            and UID ~= "" then


            Groups[Tool.Name] =
                Groups[Tool.Name]
                or {}


            table.insert(
                Groups[Tool.Name],
                Tool
            )

        end

    end

end


for Name, Tools in pairs(
    Groups
) do

    if #Tools >= 3 then

        print(
            "[FUSE] FOUND:",
            Name
        )


        return
            Tools[1],
            Tools[2],
            Tools[3]

    end

end


return nil


end

