--==================================================
-- FIND NEW EGG AFTER FUSE
--
-- PRIORITY:
-- 1. UID yang belum ada sebelum fuse
-- 2. Placement == nil
-- 3. SCALE TERBESAR
--==================================================

local function FindNewFusedEgg(
    OldSnapshot,
    Timeout
)

    local StartTime =
        tick()


    while tick() - StartTime <
        Timeout do


        local EggInventory =
            GetEggInventory()


        if EggInventory then

            local Candidates = {}


            for UID, EggData in pairs(
                EggInventory
            ) do


                if typeof(UID) == "string"
                    and typeof(EggData) == "table"
                    and EggData.Placement == nil
                    and not OldSnapshot[UID] then


                    table.insert(
                        Candidates,
                        {
                            UID = UID,
                            Data = EggData,
                            Scale = GetEggScale(EggData),
                        }
                    )

                end

            end


            if #Candidates > 0 then

                table.sort(
                    Candidates,
                    function(A, B)

                        if A.Scale == B.Scale then
                            return A.UID < B.UID
                        end

                        return A.Scale > B.Scale

                    end
                )


                local Best =
                    Candidates[1]


                print(
                    "=========================================="
                )

                print(
                    "[FUSE] NEW EGG FOUND IN INVENTORY"
                )

                print(
                    "[FUSE] UID:",
                    Best.UID
                )

                print(
                    "[FUSE] SCALE:",
                    Best.Scale
                )

                print(
                    "[FUSE] CATEGORY:",
                    Best.Data.AssetCategory
                        or Best.Data.Category
                        or "nil"
                )

                print(
                    "=========================================="
                )


                return Best

            end

        end


        task.wait(
            0.2
        )

    end


    warn(
        "[FUSE] NEW FUSED EGG TIDAK DITEMUKAN DI INVENTORY"
    )


    return nil

end


