--==================================================
-- INVENTORY EGG SCALE
--==================================================

local function GetInventoryEggScale(
    EggData
)

    if typeof(EggData) ~= "table" then
        return -math.huge
    end


    local Scale =
        EggData.AssetScale


    if typeof(Scale) ~= "number" then

        Scale =
            EggData.Scale

    end


    if typeof(Scale) ~= "number" then

        Scale = 0

    end


    return Scale

end


--==================================================
-- INVENTORY EGG SNAPSHOT
--==================================================

local function GetInventoryEggSnapshot()

    local EggInventory =
        GetEggInventory()


    if not EggInventory then
        return {}
    end


    local Eggs = {}


    for UID,
        EggData in pairs(
            EggInventory
        ) do


        if typeof(UID) == "string"
            and typeof(EggData) == "table"
            and EggData.Placement == nil then


            local Scale =
                GetInventoryEggScale(
                    EggData
                )


            table.insert(
                Eggs,
                {
                    UID = UID,
                    Data = EggData,
                    Scale = Scale
                }
            )

        end

    end


    --==============================================
    -- SORT TERBESAR
    --==============================================

    table.sort(
        Eggs,
        function(A, B)

            if A.Scale ==
                B.Scale then

                return A.UID < B.UID

            end


            return A.Scale > B.Scale

        end
    )


    print(
        "=========================================="
    )

    print(
        "[INV EGG] SNAPSHOT"
    )

    print(
        "[INV EGG] TOTAL:",
        #Eggs
    )


    for Index,
        Egg in ipairs(
            Eggs
        ) do


        print(
            "[INV EGG] #" .. Index,
            "| UID:",
            Egg.UID,
            "| SCALE:",
            Egg.Scale,
            "| CATEGORY:",
            Egg.Data.AssetCategory
                or Egg.Data.Category
                or "nil"
        )

    end


    print(
        "=========================================="
    )


    return Eggs

end


--==================================================
-- EQUIP INVENTORY EGG
--==================================================

local function EquipInventoryEgg(
    UID
)

    if typeof(UID) ~= "string"
        or UID == "" then

        warn(
            "[INV EGG] INVALID UID"
        )

        return false

    end


    print(
        "=========================================="
    )

    print(
        "[INV EGG] EQUIP UID:",
        UID
    )


    local Success,
        Result =
        pcall(function()

            return EquipEggRemote:
                InvokeServer(
                    UID
                )

        end)


    print(
        "[INV EGG] EQUIP RESULT:",
        Success,
        Result
    )


    if not Success then

        warn(
            "[INV EGG] EQUIP ERROR:",
            Result
        )

        return false

    end


    task.wait(
        INVENTORY_EGG_TOOL_DELAY
    )


    local Tool =
        WaitForEquippedTool(
            INVENTORY_EGG_EQUIP_TIMEOUT
        )


    if not Tool then

        warn(
            "[INV EGG] TOOL TIDAK EQUIPPED"
        )

        return false

    end


    local EquippedUID =
        Tool:GetAttribute(
            "UID"
        )


    print(
        "[INV EGG] TOOL:",
        Tool.Name
    )

    print(
        "[INV EGG] EQUIPPED UID:",
        EquippedUID
    )


    if EquippedUID
        and tostring(EquippedUID)
            ~= tostring(UID) then

        warn(
            "[INV EGG] UID TOOL BERBEDA!"
        )

        return false

    end


    return true

end


--==================================================
-- PROCESS ONE INVENTORY EGG
--==================================================

local function ProcessInventoryEgg(
    EggData,
    Index,
    Total
)

    if not EggData then
        return false
    end


    local UID =
        EggData.UID


    print(
        "=========================================="
    )

    print(
        "[INV EGG] PROCESS:",
        Index,
        "/",
        Total
    )

    print(
        "[INV EGG] UID:",
        UID
    )

    print(
        "[INV EGG] SCALE:",
        EggData.Scale
    )


    --==============================================
    -- EQUIP
    --==============================================

    if not EquipInventoryEgg(
        UID
    ) then

        warn(
            "[INV EGG] GAGAL EQUIP:",
            UID
        )

        return false

    end


    --==============================================
    -- GET TOOL
    --==============================================

    local Tool =
        GetEquippedTool()


    if not Tool then

        Tool =
            WaitForEquippedTool(
                INVENTORY_EGG_EQUIP_TIMEOUT
            )

    end


    if not Tool then

        warn(
            "[INV EGG] TOOL TIDAK DITEMUKAN"
        )

        return false

    end


    local ToolUID =
        Tool:GetAttribute(
            "UID"
        )


    if ToolUID
        and tostring(ToolUID)
            ~= tostring(UID) then

        warn(
            "[INV EGG] TOOL UID TIDAK SESUAI"
        )

        return false

    end


    --==============================================
    -- OWN PLOT
    --==============================================

    local Plot =
        GetMyPlot()


    if not Plot then

        warn(
            "[INV EGG] OWN PLOT TIDAK DITEMUKAN"
        )

        return false

    end


    --==============================================
    -- EXIT TREADMILL
    --==============================================

    if TreadmillRunning then

        print(
            "[INV EGG] EXIT TREADMILL"
        )


        if not ExitTreadmill() then
            return false
        end

    end


    --==============================================
    -- FLY PLOT
    --==============================================

    if not FlyToObject(
        Plot,
        REACH_DISTANCE,
        "INV_EGG:PLOT"
    ) then

        warn(
            "[INV EGG] GAGAL FLY PLOT"
        )

        return false

    end


    task.wait(
        0.2
    )


    --==============================================
    -- CHECK TOOL
    --==============================================

    Tool =
        GetEquippedTool()


    if not Tool then

        warn(
            "[INV EGG] TOOL HILANG"
        )

        return false

    end


    ToolUID =
        Tool:GetAttribute(
            "UID"
        )


    if ToolUID
        and tostring(ToolUID)
            ~= tostring(UID) then

        warn(
            "[INV EGG] TOOL BERUBAH"
        )

        return false

    end


    --==============================================
    -- PLACE
    --==============================================

    if not PlaceEggOnce(
        Tool,
        Plot
    ) then

        warn(
            "[INV EGG] PLACE FAILED:",
            UID
        )

        return false

    end


    print(
        "[INV EGG] PLACE SUCCESS:",
        UID
    )


    --==============================================
    -- WAIT TOOL
    --==============================================

    task.wait(
        INVENTORY_EGG_AFTER_PLACE_DELAY
    )


    WaitToolGone(
        Tool,
        WAIT_TOOL_GONE
    )


    print(
        "[INV EGG] COMPLETE:",
        Index,
        "/",
        Total
    )


    return true

end


--==================================================
-- PROCESS INVENTORY EGGS
--
-- FLOW:
--
-- SNAPSHOT INVENTORY
-- ->
-- HATCH EXISTING PLACED EGGS
-- ->
-- PROCESS SNAPSHOT
-- ->
-- EQUIP
-- ->
-- PLACE
--
-- HATCH TIDAK DIULANG SETELAH SETIAP PLACE
--==================================================

local function ProcessInventoryEggs()

    print(
        "=========================================="
    )

    print(
        "[INV EGG] START INVENTORY PROCESS"
    )


    --==============================================
    -- SNAPSHOT INVENTORY 1X
    --==============================================

    local Snapshot =
        GetInventoryEggSnapshot()


    local Total =
        #Snapshot


    if Total == 0 then

        print(
            "[INV EGG] NO INVENTORY EGG"
        )

        return false

    end


    print(
        "[INV EGG] TOTAL SNAPSHOT:",
        Total
    )


    --==============================================
    -- HATCH EXISTING PLACED EGG
    --
    -- INI SATU-SATUNYA HATCH DI MAIN FLOW
    --==============================================

    print(
        "=========================================="
    )

    print(
        "[MAIN] INVENTORY EGG FOUND"
    )

    print(
        "[MAIN] -> HATCH EXISTING PLACED EGGS"
    )

    print(
        "=========================================="
    )


    HatchAllPlacedEggs()


    task.wait(
        HATCH_RESUME_TIME
    )


    --==============================================
    -- PROCESS SNAPSHOT
    --==============================================

    print(
        "=========================================="
    )

    print(
        "[INV EGG] START PLACE SNAPSHOT"
    )

    print(
        "[INV EGG] TOTAL:",
        Total
    )

    print(
        "=========================================="
    )


    for Index,
        EggData in ipairs(
            Snapshot
        ) do


        local Success,
            Error =
            xpcall(
                function()

                    ProcessInventoryEgg(
                        EggData,
                        Index,
                        Total
                    )

                end,
                debug.traceback
            )


        if not Success then

            warn(
                "[INV EGG] ERROR:",
                Error
            )

            StopFly()

            MovementOwner =
                nil

        end


        if Index < Total then

            task.wait(
                LOOP_DELAY
            )

        end

    end


    print(
        "=========================================="
    )

    print(
        "[INV EGG] SNAPSHOT COMPLETE"
    )

    print(
        "[INV EGG] TOTAL PROCESSED:",
        Total
    )

    print(
        "[INV EGG] NO RESCAN"
    )

    print(
        "[INV EGG] HATCH SUDAH DILAKUKAN DI AWAL"
    )

    print(
        "=========================================="
    )


    return true

end


