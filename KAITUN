--==================================================

local function GetInventoryEggSnapshot()


local Inventory =
    GetEggInventory()


if not Inventory then
    return {}
end


local Snapshot =
    {}


for UID, Data in pairs(
    Inventory
) do

    if typeof(UID) == "string"
        and typeof(Data) == "table"
        and Data.Placement == nil then


        table.insert(
            Snapshot,
            {
                UID = UID,
                Data = Data,
                Scale =
                    GetInventoryEggScale(
                        Data
                    )
            }
        )

    end

end


table.sort(
    Snapshot,
    function(A, B)

        if A.Scale ==
            B.Scale then

            return A.UID <
                B.UID

        end


        return A.Scale >
            B.Scale

    end
)


print(
    "[INV] SNAPSHOT:",
    #Snapshot
)


return Snapshot


end

