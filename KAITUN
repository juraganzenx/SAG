    if not Plots then

        warn(
            "[PLOT] workspace.Plots tidak ditemukan"
        )

        return nil

    end


    for PlotNumber =
        MIN_PLOT,
        MAX_PLOT do


        local Plot =
            Plots:FindFirstChild(
                tostring(
                    PlotNumber
                )
            )


        if Plot then

            local PlotSign =
                Plot:FindFirstChild(
                    "PlotSign"
                )


            local PlayerPlotSign =
                PlotSign
                and PlotSign:FindFirstChild(
                    "PlayerPlotSign"
                )


            local Frame =
                PlayerPlotSign
                and PlayerPlotSign:FindFirstChild(
                    "Frame"
                )


            local PlayerName =
                Frame
