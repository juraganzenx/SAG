        StartPosition,
        REACH_DISTANCE,
        "FIELD:START"
    ) then

        return false

    end


    --==============================================
    -- VALIDATE EGG
    --==============================================

    if not Egg.Parent then
        return false
    end


    --==============================================
    -- FLY EGG
    --==============================================

    if not FlyToObject(
        Egg,
        REACH_DISTANCE,
        "FIELD:EGG"
    ) then

        return false

    end


    --==============================================
    -- CARRY
    --==============================================

    task.wait(
        AFTER_CARRY_START_DELAY
    )


    local FieldUID =
        Egg.Name


    if not CarryEgg(
        Egg
    ) then

        warn(
            "[FIELD EGG] CARRY FAILED"
        )

        return false

    end


    task.wait(
        CARRY_DELAY
    )


    --==============================================
    -- RETURN START
    --==============================================

    if not AutoFlyToPosition(
        StartPosition,
        REACH_DISTANCE,
        "FIELD:RETURN_START"
    ) then

        return false

    end


    --==============================================
    -- WAIT INVENTORY UPDATE
    --==============================================

    print(
        "[FIELD EGG] WAIT INVENTORY:",
        FieldUID
    )


    local StartInventoryWait =
        tick()


    local InventoryEgg = nil


    while tick() - StartInventoryWait <
        EQUIP_TIMEOUT do


        InventoryEgg =
            GetInventoryEggByUID(
                FieldUID
            )


        if InventoryEgg then

            print(
                "[FIELD EGG] FOUND IN INVENTORY:",
                FieldUID
            )

            break

        end


        task.wait(
            0.2
        )

    end


    if not InventoryEgg then

        warn(
            "[FIELD EGG] UID TIDAK MASUK INVENTORY:",
            FieldUID
        )

        return false

    end


    --==============================================
    -- EQUIP BY INVENTORY UID
    --==============================================

    local Tool =
        EquipEggByUID(
            InventoryEgg.UID
        )


    if not Tool then

        warn(
            "[FIELD EGG] GAGAL EQUIP INVENTORY EGG"
        )

        return false

    end


    --==============================================
    -- PARASITE
    --==============================================

    if CheckAndFeedParasite() then

        print(
            "[FIELD EGG] PARASITE -> PLACE SKIP"
        )

        return true

    end


    --==============================================
    -- OWN PLOT
    --==============================================

    local Plot =
        GetMyPlot()


    if not Plot then
        return false
    end


    --==============================================
    -- FLY PLOT
    --==============================================

    if not FlyToObject(
        Plot,
        REACH_DISTANCE,
        "FIELD:OWN_PLOT"
    ) then

        return false

    end


    --==============================================
    -- CHECK TOOL
    --==============================================

    Tool =
        GetEquippedTool()


    if not Tool then

        warn(
            "[FIELD EGG] TOOL HILANG"
        )

        return false

    end


    local EquippedUID =
        Tool:GetAttribute(
            "UID"
        )


    if not EquippedUID
        or tostring(EquippedUID)
            ~= tostring(FieldUID) then

        warn(
            "[FIELD EGG] TOOL UID TIDAK SESUAI"
        )

        print(
            "EXPECTED:",
            FieldUID
        )

        print(
            "CURRENT:",
            EquippedUID
        )

        return false

    end


    --==============================================
    -- PLACE
    --==============================================

    if not PlaceEggByUID(
        FieldUID,
        Plot
    ) then

        warn(
            "[FIELD EGG] PLACE FAILED"
        )

        return false

    end


    --==============================================
    -- WAIT TOOL GONE
    --==============================================

    WaitToolGone(
        Tool,
        WAIT_TOOL_GONE
    )


    --==============================================
    -- HATCH SNAPSHOT
    --==============================================

    HatchAllPlacedEggs()


    task.wait(
        HATCH_RESUME_TIME
    )


    print(
        "[FIELD EGG] COMPLETE"
    )


    return true

end


