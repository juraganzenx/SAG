--==================================================

local function WaitToolGone(
    Tool,
    Timeout
)

    if not Tool then
        return true
    end


    local StartTime =
        tick()


    while tick() - StartTime <
        Timeout do


        if not Tool.Parent then

            print(
                "[PLACE] TOOL GONE"
            )

            return true

        end


        if GetEquippedTool()
            ~= Tool then

            print(
                "[PLACE] TOOL NO LONGER EQUIPPED"
            )

            return true

        end


        task.wait(
            0.1
        )

    end


    warn(
        "[PLACE] WAIT TOOL GONE TIMEOUT"
    )


    return false

end


--==================================================
-- PLACE FUSED EGG
--
-- IMPORTANT:
-- TIDAK ADA HATCH DI SINI
--==================================================

local function PlaceFusedEgg(
    FusedEgg
)

    if not FusedEgg
        or not FusedEgg.Parent then

        warn(
            "[FUSE PLACE] FUSED EGG INVALID"
        )

        return false

    end


    print(
        "=========================================="
    )

    print(
        "[FUSE PLACE] START"
    )

    print(
        "[FUSE PLACE] TOOL:",
        FusedEgg.Name
    )

    print(
        "[FUSE PLACE] UID:",
        FusedEgg:GetAttribute(
            "UID"
        )
    )


    local Plot =
        GetMyPlot()


    if not Plot then
        return false
    end


    if TreadmillRunning then

        print(
            "[FUSE PLACE] EXIT TREADMILL"
        )


        if not ExitTreadmill() then
            return false
        end

    end


    if not FlyToObject(
        Plot,
        REACH_DISTANCE,
        "FUSE:OWN_PLOT"
    ) then

        return false

    end


    local CurrentTool =
        GetEquippedTool()


    if not CurrentTool then

        warn(
            "[FUSE PLACE] FUSED TOOL SUDAH TIDAK EQUIPPED"
        )

        return false

    end


    if CurrentTool ~= FusedEgg then

        warn(
            "[FUSE PLACE] TOOL BERUBAH!"
        )

        return false

    end


    local Placed =
        PlaceEggOnce(
            CurrentTool,
            Plot
        )


    if not Placed then

        warn(
            "[FUSE PLACE] PLACE FAILED"
        )

        return false

    end


    WaitToolGone(
        CurrentTool,
        WAIT_TOOL_GONE
    )


    print(
        "[FUSE PLACE] SUCCESS"
    )

