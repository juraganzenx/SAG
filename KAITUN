--==================================================
-- AUTO EGG PROCESS
--==================================================

local function ProcessEggAutomation()

    --================================================
    -- STEP 1
    -- FIND EGG
    --================================================

    local Egg =
        GetBestEgg()


    --================================================
    -- NO EGG
    --================================================

    if not Egg then

        print("")
        print("##########################################")
        print("[AUTO EGG] NO VALID EGG")
        print("[AUTO EGG] SERVER HOP DISABLED")
        print("[AUTO EGG] -> TREADMILL")
        print("##########################################")


        EnterTreadmill()


        return

    end


    --================================================
    -- EGG FOUND
    --================================================

    if TreadmillRunning then

        print(
            "[AUTO EGG] EGG FOUND -> EXIT TREADMILL"
        )


        local Doffed =
            ExitTreadmill()


        if not Doffed then

            warn(
                "[AUTO EGG] Gagal keluar treadmill."
            )

            return

        end

    end


    --================================================
    -- START AREA
    --================================================

    local StartArea =
        GetStartArea()


    if not StartArea then

        warn(
            "[AUTO EGG] StartArea tidak ditemukan."
        )

        return

    end


    --================================================
    -- FLY START AREA
    --================================================

    print(
        "[AUTO EGG] -> FLY START AREA"
    )


    local StartPosition =
        GetPosition(
            StartArea
        )


    if StartPosition then

        StartPosition =
            StartPosition +
            Vector3.new(
                -20,
                5,
                0
            )

    end


    local StartReached =
        AutoFlyToPosition(
            StartPosition,
            REACH_DISTANCE,
            "EGG:StartArea"
        )


    if not StartReached then

        return

    end


    --================================================
    -- VALIDATE EGG
    --================================================

    if not Egg
        or not Egg.Parent then

        print(
            "[AUTO EGG] Egg sudah hilang."
        )

        return

    end


    local IsHighlight =
        HasHighlight(
            Egg
        )


    if not IsHighlight then

        local Scale =
            GetEggScale(
                Egg
            )


        local PivotX =
            GetEggWorldPivotX(
                Egg
            )


        if Scale <=
            NormalEggConfig.MIN_SCALE
            or PivotX <=
            NormalEggConfig.MIN_WORLD_PIVOT_X then

            print(
                "[AUTO EGG] Egg tidak valid lagi."
            )

            return

        end

    end


    --================================================
    -- FLY EGG
    --================================================

    print(
        "[AUTO EGG] -> FLY EGG:",
        Egg.Name
    )


    local ReachedEgg =
        FlyToObject(
            Egg,
            REACH_DISTANCE,
            "EGG"
        )


    if not ReachedEgg then

        return

    end


    --================================================
    -- CARRY
    --================================================

    task.wait(
        AFTER_CARRY_START_DELAY
    )


    local Carried =
        CarryEgg(
            Egg
        )


    if not Carried then

        warn(
            "[AUTO EGG] Carry gagal."
        )

        return

    end


    task.wait(
        CARRY_DELAY
    )


    --================================================
    -- RETURN START
    --================================================

    print(
        "[AUTO EGG] -> RETURN START AREA"
    )


    StartPosition =
        GetPosition(
            StartArea
        )


    if StartPosition then

        StartPosition =
            StartPosition +
            Vector3.new(
                -20,
                5,
                0
            )

    end


    StartReached =
        AutoFlyToPosition(
            StartPosition,
            REACH_DISTANCE,
            "EGG:StartArea"
        )


    if not StartReached then

        return

    end


    --================================================
    -- WAIT
    --================================================

    print(
        "[AUTO EGG] WAIT:",
        WAIT_AFTER_RETURN,
        "SEC"
    )


    task.wait(
        WAIT_AFTER_RETURN
    )


    --================================================
    -- CHECK TOOL
    --================================================

    print(
        "[AUTO EGG] STEP -> CHECK TOOL"
    )


    local Tool =
        GetEquippedTool()


    if not Tool then

        Tool =
            WaitForEquippedTool(
                5
            )

    end


    if not Tool then

        warn(
            "[AUTO EGG] Tool tidak muncul."
        )

        return

    end


    print(
        "[AUTO EGG] TOOL:",
        Tool.Name
    )


    print(
        "[AUTO EGG] UID:",
        Tool:GetAttribute("UID")
    )


    --================================================
    -- PARASITE CHECK #1
    --================================================

    print("")
    print("==========================================")
    print("[AUTO EGG] CHECK PARASITE")
    print("==========================================")


    local ParasiteHandled =
        CheckAndFeedParasite()


    if ParasiteHandled then

        print("")
        print("==========================================")
        print("[AUTO EGG] PARASITE HANDLED")
        print("[AUTO EGG] PLACE SKIPPED")
        print("==========================================")


        return

    end


    --================================================
    -- OWN PLOT
    --================================================

    local Plot =
        GetMyPlot()


    if not Plot then

        return

    end


    --================================================
    -- FLY PLOT
    --================================================

    print(
        "[AUTO EGG] -> FLY OWN PLOT"
    )


    local ReachedPlot =
        FlyToObject(
            Plot,
            REACH_DISTANCE,
            "EGG"
        )


    if not ReachedPlot then

        return

    end


    --================================================
    -- CHECK TOOL AGAIN
    --================================================

    local CurrentTool =
        GetEquippedTool()


    if not CurrentTool then

        warn(
            "[AUTO EGG] Tool sudah tidak equipped."
        )

        return

    end


    --================================================
    -- PARASITE SAFETY RECHECK
    --================================================

    print(
        "[AUTO EGG] RECHECK PARASITE..."
    )


    local ParasiteAfterPlot =
        CheckAndFeedParasite()


    if ParasiteAfterPlot then

        print(
            "[AUTO EGG] PARASITE DETECTED"
        )

        print(
            "[AUTO EGG] PLACE CANCELLED"
        )

        return

    end


    --================================================
    -- PLACE
    --================================================

    local Placed =
        PlaceEgg(
            CurrentTool,
            Plot,
            "AUTO EGG"
        )


    if not Placed then

        warn(
            "[AUTO EGG] Place gagal."
        )

        return

    end


    print(
        "[AUTO EGG] PLACE REQUEST SENT."
    )


    --================================================
    -- WAIT TOOL GONE
    --================================================

    local Gone =
        WaitToolGone(
            CurrentTool,
            WAIT_TOOL_GONE
        )


    if Gone then

        print(
            "[AUTO EGG] Tool sudah hilang."
        )

    else

        warn(
            "[AUTO EGG] Tool masih ada."
        )

    end


    --================================================
    -- HATCH
    --================================================

    print(
        "[AUTO HATCH] START"
    )


    StartHatch()


    --================================================
    -- RESUME
    --================================================

    print(
        "[AUTO HATCH] WAIT:",
        HATCH_RESUME_TIME,
        "SEC"
    )


    task.wait(
        HATCH_RESUME_TIME
    )


    print(
        "[AUTO EGG] READY FOR NEXT CHECK"
    )

end


