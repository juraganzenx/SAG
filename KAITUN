local function GetNearestEgg()


local Folder =
    GetEggFolder()


if not Folder then

    warn(
        "[NEAREST] AreaEggSlotsClient tidak ditemukan"
    )

    return nil

end


local BestEgg =
    nil

local BestX =
    math.huge

local Seen =
    {}


for _, Object in ipairs(
    Folder:GetDescendants()
) do

    if IsValidEgg(Object)
        and not Seen[Object] then

        Seen[Object] =
            true


        local Position =
            GetEggPosition(
                Object
            )


        if Position
            and Position.X < BestX then

            BestX =
                Position.X

            BestEgg =
                Object

        end

    end

end


if BestEgg then

    print(
        "[NEAREST]",
        BestEgg.Name,
        "| X:",
        BestX
    )

else

    print(
        "[NEAREST] NO EGG"
    )

end


return BestEgg


end

