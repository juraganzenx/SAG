--==================================================

local function FindThreeSamePets()

    local Backpack =
        LocalPlayer:WaitForChild(
            "Backpack"
        )

    local Groups = {}

    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if Tool:IsA("Tool")
            and not BLACKLIST[Tool.Name] then

            local Weight =
                Tool:GetAttribute("Weight")

            local UID =
                Tool:GetAttribute("UID")

            if typeof(Weight) == "number"
                and Weight < MAX_PET_WEIGHT
                and typeof(UID) == "string"
                and UID ~= "" then

                if not Groups[Tool.Name] then
                    Groups[Tool.Name] = {}
                end

                table.insert(
                    Groups[Tool.Name],
                    Tool
                )
            end
        end
    end

    for Name, Tools in pairs(Groups) do

        if #Tools >= 3 then

            print("==========================================")
            print("[FUSE] FOUND 3 SAME PET")
            print("[FUSE] NAME:", Name)
            print("==========================================")

            for i = 1, 3 do
                print(
                    "[FUSE] PET #" .. i,
                    "| Name:", Tools[i].Name,
                    "| Weight:", Tools[i]:GetAttribute("Weight"),
                    "| UID:", Tools[i]:GetAttribute("UID")
                )
            end

            return Tools[1], Tools[2], Tools[3]
        end
    end

    return nil
end


