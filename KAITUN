--==================================================
-- PLACE EGG
-- METODE SAMA DENGAN AUTO EGG YANG SUDAH BERHASIL
--==================================================

local function PlaceEgg(EggTool)

    if not EggTool
        or not EggTool.Parent then
        return false
    end

    local CharacterFolder =
        Workspace:FindFirstChild(LocalPlayer.Name)

    if not CharacterFolder
        or EggTool.Parent ~= CharacterFolder then

        warn("[AUTO PLACE] Egg tool bukan di Character")
        return false
    end

    local PetArea, CenterPoint =
        GetPetAreaData()

    if not PetArea or not CenterPoint then
        return false
    end

    -- Validasi bahwa tool memang Egg
    local IsEggSuccess, IsEgg =
        pcall(function()
            return EggToolDisplay.IsEggTool(EggTool)
        end)

    if not IsEggSuccess or not IsEgg then
        warn(
            "[AUTO PLACE] Tool bukan Egg:",
            EggTool.Name
        )
        return false
    end

    -- Ambil UID menggunakan EggToolDisplay,
    -- bukan hardcode UID.
    local EggUID =
        EggToolDisplay.GetToolUid(EggTool)

    if not EggUID then
        warn(
            "[AUTO PLACE] Egg UID tidak ditemukan:",
            EggTool.Name
        )
        return false
    end

    print("==========================================")
    print("[AUTO PLACE] PLACE EGG START")
    print("[AUTO PLACE] Tool:", EggTool.Name)
    print("[AUTO PLACE] UID:", EggUID)
    print("==========================================")

    -- Retry seperti script PlaceEgg yang berhasil.
    for Attempt = 1, 50 do

        local CurrentTool = GetEquippedTool()

        if not CurrentTool then
            print("[AUTO PLACE] Egg sudah tidak ada di Character")
            return true
        end

        local WorldPosition =
            GetRandomPetAreaPosition(PetArea)

        if not WorldPosition then
            task.wait(0.15)
            continue
        end

        -- PENTING:
        -- posisi world dikonversi menjadi LocalCFrame
        -- relatif terhadap CenterPoint, sama dengan script
        -- Auto Egg Place yang sebelumnya berhasil.
        local LocalCFrame =
            CenterPoint.CFrame:ToObjectSpace(
                CFrame.new(WorldPosition)
            )

        print(
            "[AUTO PLACE] Attempt:",
            Attempt,
            "Position:",
            WorldPosition
        )

        local InvokeSuccess, Response1, Response2 =
            pcall(function()
                return RequestPlaceEggRemote:InvokeServer({
                    ["Uid"] = EggUID,
                    ["LocalCFrame"] = LocalCFrame
                })
            end)

        if InvokeSuccess then
            print(
                "[AUTO PLACE] Response:",
                Response1,
                Response2
            )
        else
            warn(
                "[AUTO PLACE] Invoke Error:",
                Response1
            )
        end

        -- Jangan langsung menganggap sukses hanya karena
        -- InvokeServer tidak error. Verifikasi tool hilang.
        if WaitUntilEggToolGone(3) then
            print("==========================================")
            print("[AUTO PLACE] EGG BERHASIL DI-PLACE")
            print("[AUTO PLACE] Attempt:", Attempt)
            print("==========================================")
            return true
        end

        warn("[AUTO PLACE] Place belum berhasil, retry posisi lain...")
        task.wait(0.15)
    end

    warn("[AUTO PLACE] MAX PLACE ATTEMPTS tercapai")
    return false
end

