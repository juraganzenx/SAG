                    NORMAL_MIN_SCALE
                    and PivotX >
                    NORMAL_MIN_WORLD_PIVOT_X then


                    if Scale >
                        LargestScale then

                        LargestScale =
                            Scale


                        HighestPivotX =
                            PivotX


                        SelectedEgg =
                            Object


                    elseif Scale ==
                        LargestScale
                        and PivotX >
                        HighestPivotX then

                        HighestPivotX =
                            PivotX


                        SelectedEgg =
                            Object

                    end

                end

            end

        end

    end


    if SelectedEgg then

        print(
            "[AUTO EGG] NORMAL EGG:",
            SelectedEgg.Name,
            "| Scale:",
            LargestScale,
            "| PivotX:",
            HighestPivotX
        )

    end


    return SelectedEgg

end


