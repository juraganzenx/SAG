--==================================================
-- PLACE UNTIL SUCCESS
--==================================================

local function PlaceEggUntilSuccess(
    Tool,
    Plot
)

    if not Tool then

        return false

    end


    local Attempt =
        0


    print(
        "=========================================="
    )


    print(
        "[PLACE] START RETRY LOOP"
    )


    print(
        "[PLACE] EGG:",
        Tool.Name
    )


    print(
        "=========================================="
    )


    while true do

        Attempt =
            Attempt + 1


        --============================================
        -- TOOL CHECK
        --============================================

        if not Tool.Parent then

            print(
                "[PLACE] TOOL HILANG"
            )


            print(
                "[PLACE] PLACE SUCCESS"
            )


            return true

        end


        --============================================
        -- EQUIP
        --============================================

        local Equipped =
            GetEquippedTool()


        if Equipped ~= Tool then

            local Character =
                LocalPlayer.Character


            local Humanoid =
                Character
                and Character:FindFirstChildOfClass(
                    "Humanoid"
                )


            if Humanoid then

                pcall(function()

                    Humanoid:EquipTool(
                        Tool
                    )

                end)

            end


            task.wait(0.2)

        end


        print(
            "[PLACE] ATTEMPT:",
            Attempt
        )


        --============================================
        -- PLACE
        --============================================

        PlaceEggOnce(
            Tool,
            Plot
        )


        --============================================
        -- WAIT TOOL GONE
        --============================================

        local StartTime =
            tick()


        while tick() - StartTime <
            WAIT_TOOL_GONE do


            if not Tool.Parent then

                print(
                    "[PLACE] SUCCESS!"
                )


                return true

            end


            task.wait(
                0.1
            )

        end


        warn(
            "[PLACE] ATTEMPT",
            Attempt,
            "FAILED"
        )


        task.wait(
            PLACE_RETRY_DELAY
        )

    end

end


