        "[FIELD EGG] CARRIED TOOL:",
        CarriedTool.Name
    )

    print(
        "[FIELD EGG] CARRIED UID:",
        CarriedTool:GetAttribute(
            "UID"
        )
    )


    --==================================================
    -- RETURN START
    --==================================================

    if not AutoFlyToPosition(
        StartPosition,
        10,
        "FIELD:RETURN"
    ) then

        return false

    end


    task.wait(
        WAIT_AFTER_RETURN
    )


    --==================================================
    -- PARASITE
    --==================================================

    if CheckAndFeedParasite() then

        print(
            "[FIELD EGG] PARASITE HANDLED"
        )

    end


    --==================================================
    -- PLOT
    --==================================================

    local Plot =
        GetMyPlot()


    if not Plot then
        return false
    end


    if not AutoFlyToPosition(
        GetPosition(Plot),
        REACH_DISTANCE,
        "FIELD:PLOT"
    ) then

        return false

    end


    task.wait(
        0.15
    )


    --==================================================
    -- TOOL CHECK
    --==================================================

    local CurrentTool =
        GetEquippedTool()


    if not CurrentTool then

        warn(
            "[FIELD EGG] TOOL LOST BEFORE PLACE"
        )

        return false

    end


    --==================================================
    -- PARASITE RECHECK
    --==================================================

    CheckAndFeedParasite()


    --==================================================
    -- PLACE
    --==================================================

    if not PlaceEggOnce(
        CurrentTool,
        Plot
    ) then

        warn(
            "[FIELD EGG] PLACE FAILED"
        )

        return false

    end


    WaitToolGone(
        CurrentTool,
        WAIT_TOOL_GONE
    )


    print(
        "[FIELD EGG] SUCCESS"
    )

    print(
        "[FIELD EGG] NO HATCH"
    )


    return true

end


--==================================================
-- INVENTORY
--==================================================

local function GetEggInventory()

    local Success,
        Data =
        pcall(function()

            return Save.Get()

        end)


    if not Success
        or typeof(Data) ~= "table" then

        return nil

    end


    if typeof(
        Data.EggInventory
    ) ~= "table" then

        return nil

    end


    return Data.EggInventory

end


--==================================================
-- INVENTORY SCALE
--==================================================

local function GetInventoryEggScale(
    Data
)

    if typeof(Data) ~= "table" then
        return 0
    end


    local Scale =
        Data.AssetScale


    if typeof(Scale) ~= "number" then

        Scale =
            Data.Scale

    end


    if typeof(Scale) ~= "number" then
        Scale = 0
    end


    return Scale

end


--==================================================
-- INVENTORY SNAPSHOT
--==================================================

local function GetInventoryEggSnapshot()

    local Inventory =
        GetEggInventory()


    if not Inventory then
        return {}
    end


    local Snapshot = {}


    for UID, Data in pairs(
        Inventory
    ) do

        if typeof(UID) == "string"
            and typeof(Data) == "table"
            and Data.Placement == nil then

            table.insert(
                Snapshot,
                {
                    UID = UID,
                    Data = Data,
                    Scale =
                        GetInventoryEggScale(
                            Data
                        )
                }
            )

        end

    end


    table.sort(
        Snapshot,
        function(A, B)

            if A.Scale ==
                B.Scale then

                return A.UID <
                    B.UID

            end


            return A.Scale >
                B.Scale

        end
    )


    print(
        "[INV] SNAPSHOT:",
        #Snapshot
    )


    return Snapshot

end


--==================================================
-- EQUIP INVENTORY EGG
--==================================================

local function EquipInventoryEgg(
    UID
)

    local Success,
        Result =
        pcall(function()

            return EquipEggRemote:
                InvokeServer(
                    UID
                )

        end)


    print(
        "[INV] EQUIP:",
        UID,
        Success,
        Result
    )


    if not Success then
        return false
    end


    task.wait(
        INVENTORY_EGG_TOOL_DELAY
