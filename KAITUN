--==================================================
-- GET BEST FIELD EGG
--
-- PRIORITY:
-- 1. HIGHLIGHT
-- 2. SCALE TERBESAR
-- 3. PIVOT X TERBESAR
--
-- NORMAL:
-- 1. SCALE TERBESAR
-- 2. PIVOT X TERBESAR
--==================================================

local function GetBestEgg()

    local EggFolder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )


    if not EggFolder then

        warn(
            "[AUTO EGG] EGG FOLDER TIDAK DITEMUKAN"
        )

        return nil

    end


    local BestHighlight = nil

    local BestHighlightScale =
        -math.huge

    local BestHighlightPivotX =
        -math.huge


    local BestNormal = nil

    local BestNormalScale =
        -math.huge

    local BestNormalPivotX =
        -math.huge


    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do


        if Object:IsA("Model") then


            local Scale =
                GetEggScale(
                    Object
                )


            local PivotX =
                GetEggWorldPivotX(
                    Object
                )


            local Highlight =
                HasHighlight(
                    Object
                )


            if Highlight then


                if Scale >
                    BestHighlightScale

                    or (

                        Scale ==
                            BestHighlightScale

                        and

                        PivotX >
                            BestHighlightPivotX

                    ) then


                    BestHighlight =
                        Object

                    BestHighlightScale =
                        Scale

                    BestHighlightPivotX =
                        PivotX

                end


            elseif Scale >
                    NORMAL_MIN_SCALE

                and PivotX >
                    NORMAL_MIN_PIVOT_X then


                if Scale >
                    BestNormalScale

                    or (

                        Scale ==
                            BestNormalScale

                        and

                        PivotX >
                            BestNormalPivotX

                    ) then


                    BestNormal =
                        Object

                    BestNormalScale =
                        Scale

                    BestNormalPivotX =
                        PivotX

                end

            end

        end

    end


    if BestHighlight then

        print(
            "=========================================="
        )

        print(
            "[AUTO EGG] BEST HIGHLIGHT:",
            BestHighlight.Name
        )

        print(
            "[AUTO EGG] SCALE:",
            BestHighlightScale
        )

        print(
            "[AUTO EGG] PIVOT X:",
            BestHighlightPivotX
        )

        return BestHighlight

    end


    if BestNormal then

        print(
            "=========================================="
        )

        print(
            "[AUTO EGG] BEST NORMAL:",
            BestNormal.Name
        )

        print(
            "[AUTO EGG] SCALE:",
            BestNormalScale
        )

        print(
            "[AUTO EGG] PIVOT X:",
            BestNormalPivotX
        )

        return BestNormal

    end


    return nil

end


