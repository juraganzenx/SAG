--==================================================
-- PROCESS FUSE
--==================================================

local function TryFuseCycle()

    print(
        "=========================================="
    )

    print(
        "[MAIN] CHECK FUSE"
    )


    local Pet1,
        Pet2,
        Pet3 =
        FindThreeSamePets()


    if not Pet1 then

        print(
            "[MAIN] NO 3 PET READY"
        )

        return false

    end


    --==============================================
    -- EXIT TREADMILL
    --==============================================

    if TreadmillRunning then

        print(
            "[FUSE] PET READY -> EXIT TREADMILL"
        )


        if not ExitTreadmill() then
            return false
        end

    end


    --==============================================
    -- LOAD PET #1
    --==============================================

    if not LoadOnePet(
        Pet1,
        1
    ) then

        return false

    end


    --==============================================
    -- LOAD PET #2
    --==============================================

    if not LoadOnePet(
        Pet2,
        2
    ) then

        return false

    end


    --==============================================
    -- LOAD PET #3
    --==============================================

    if not LoadOnePet(
        Pet3,
        3
    ) then

        return false

    end


    --==============================================
    -- BEGIN FUSE
    --==============================================

    if not StartFuse() then
        return false
    end


    --==============================================
    -- FINISH REVEAL
    --==============================================

    if not FinishFuse() then
        return false
    end


    --==============================================
    -- WAIT FUSED EGG EQUIPPED
    --==============================================

    local FusedEgg =
        WaitForFusedEggEquipped(
            FUSED_EGG_WAIT_TIMEOUT
        )


    if not FusedEgg then
        return false
    end


    --==============================================
    -- PLACE FUSED EGG
    --==============================================

    if not PlaceFusedEgg(
        FusedEgg
    ) then

        warn(
            "[FUSE] PLACE FUSED EGG FAILED"
        )

        return false

    end


    --==============================================
    -- HATCH
    --
    -- Hanya hatch snapshot yang ada saat ini.
    --==============================================

    HatchAllPlacedEggs()


    task.wait(
        HATCH_RESUME_TIME
    )


    print(
        "=========================================="
    )

    print(
        "[FUSE] CYCLE COMPLETE"
    )

    print(
        "=========================================="
    )


    return true

end


--==================================================
-- PROCESS FIELD EGG
--==================================================

local function ProcessFieldEgg(
    Egg
)

    if not Egg
        or not Egg.Parent then

        return false

    end


    print(
        "=========================================="
    )

    print(
        "[FIELD EGG] PROCESS:",
        Egg.Name
    )


    --==============================================
    -- FORCE DOFF
    --
    -- SETIAP MULAI KE START
    -- SELALU DOFF TERLEBIH DAHULU
    --==============================================

    if not ForceDoffBeforeStart() then

        warn(
            "[FIELD EGG] FORCE DOFF FAILED"
        )

        return false

    end


    --==============================================
    -- START AREA
    --==============================================

    local StartArea =
        Workspace:FindFirstChild(
            START_AREA_NAME,
            true
        )


    if not StartArea then

        warn(
            "[FIELD EGG] START AREA TIDAK DITEMUKAN"
        )

        return false

    end


    local StartPosition =
        GetPosition(
            StartArea
        )


    if not StartPosition then
        return false
    end


    StartPosition +=
        Vector3.new(
            -20,
            5,
            0
        )


    --==============================================
    -- FLY START
    --==============================================

    if not AutoFlyToPosition(
        StartPosition,
        REACH_DISTANCE,
        "FIELD:START"
    ) then

        return false

    end


    --==============================================
    -- VALIDATE EGG
    --==============================================

    if not Egg.Parent then

        warn(
            "[FIELD EGG] EGG SUDAH HILANG"
        )

        return false

    end


    --==============================================
    -- FLY EGG
    --==============================================

    if not FlyToObject(
        Egg,
        REACH_DISTANCE,
        "FIELD:EGG"
    ) then

        return false

    end


    --==============================================
    -- CARRY
    --==============================================

    task.wait(
        AFTER_CARRY_START_DELAY
    )


    if not CarryEgg(
        Egg
    ) then

        warn(
            "[FIELD EGG] CARRY FAILED"
        )

        return false

    end


    task.wait(
        CARRY_DELAY
    )


    --==============================================
    -- RETURN START
    --==============================================

    if not AutoFlyToPosition(
        StartPosition,
        REACH_DISTANCE,
        "FIELD:RETURN_START"
    ) then

        return false

    end


    --==============================================
    -- WAIT
    --==============================================

    print(
        "[FIELD EGG] WAIT:",
        WAIT_AFTER_RETURN
    )


    task.wait(
        WAIT_AFTER_RETURN
    )


    --==============================================
    -- WAIT TOOL
    --==============================================

    local Tool =
        WaitForEquippedTool(
            5
        )


    if not Tool then

        warn(
            "[FIELD EGG] CARRIED EGG TOOL TIDAK EQUIPPED"
        )

        return false

    end


    print(
        "[FIELD EGG] CARRIED TOOL:",
        Tool.Name
    )


    --==============================================
    -- PARASITE
    --==============================================

    if CheckAndFeedParasite() then

        print(
            "[FIELD EGG] PARASITE -> PLACE SKIP"
        )

        return true

    end


    --==============================================
    -- OWN PLOT
    --==============================================

    local Plot =
        GetMyPlot()


    if not Plot then
        return false
    end


    --==============================================
    -- FLY PLOT
    --==============================================

    if not FlyToObject(
        Plot,
        REACH_DISTANCE,
        "FIELD:OWN_PLOT"
    ) then

        return false

    end


    --==============================================
    -- CHECK TOOL AGAIN
    --==============================================

    local CurrentTool =
        GetEquippedTool()


    if not CurrentTool then

        warn(
            "[FIELD EGG] TOOL HILANG"
        )

        return false

    end


    --==============================================
    -- PARASITE RECHECK
    --==============================================

    if CheckAndFeedParasite() then

        print(
            "[FIELD EGG] PARASITE -> PLACE CANCEL"
        )

        return true

    end


    --==============================================
    -- PLACE
    --==============================================

    if not PlaceEggOnce(
        CurrentTool,
        Plot
    ) then

        warn(
            "[FIELD EGG] PLACE FAILED"
        )

        return false

    end


    --==============================================
    -- WAIT TOOL GONE
    --==============================================

    WaitToolGone(
        CurrentTool,
        WAIT_TOOL_GONE
    )


    --==============================================
    -- HATCH
    --
    -- SCAN 1X SAJA
    --==============================================

    HatchAllPlacedEggs()


    task.wait(
        HATCH_RESUME_TIME
    )


    print(
        "[FIELD EGG] COMPLETE"
    )


    return true

end


