-- 1. FUSE
-- 2. EGG
-- 3. TREADMILL
--==================================================

local function Process()

    if ProcessRunning then

        return

    end


    ProcessRunning =
        true


    local Success, Error =
        xpcall(
            function()


                --====================================
                -- PRIORITY #1
                -- CHECK FUSE
                --====================================

                local Pet1,
                    Pet2,
                    Pet3 =
                    FindThreeSamePets()


                if Pet1 then

                    print(
                        "=========================================="
                    )


                    print(
                        "[MAIN] PRIORITY: FUSE"
                    )


                    print(
                        "=========================================="
                    )


                    ProcessFuse(
                        Pet1,
                        Pet2,
                        Pet3
                    )


                    return

                end


                --====================================
                -- NO FUSEABLE PET
                --====================================

                print(
                    "[MAIN] NO 3 PET FUSEABLE"
                )


                --====================================
                -- PRIORITY #2
                -- FIND EGG
                --====================================

                local Egg =
                    GetBestEgg()


                if Egg then

                    print(
                        "=========================================="
                    )


                    print(
                        "[MAIN] PRIORITY: AUTO EGG"
                    )


                    print(
                        "=========================================="
                    )


                    ProcessNormalEgg(
                        Egg
                    )


                    return

                end


                --====================================
                -- NO FUSE
                -- NO EGG
                --
                -- PRIORITY #3
                -- TREADMILL
                --====================================

                print(
                    "=========================================="
                )


                print(
                    "[MAIN] NO FUSEABLE PET"
                )


                print(
                    "[MAIN] NO VALID EGG"
                )


                print(
                    "[MAIN] PRIORITY: TREADMILL"
                )


                print(
                    "=========================================="
                )


                EnterTreadmill()


            end,
            debug.traceback
        )


    ProcessRunning =
        false


    if not Success then

        warn(
            "[MAIN] PROCESS ERROR:",
            Error
        )


        StopFly()

    end

end


--==================================================
-- MAIN LOOP
--==================================================

task.spawn(function()

    print(
        "=================================================="
    )


    print(
        " AUTO FUSE PET"
    )


    print(
        " + AUTO EGG CARRY"
    )


    print(
        " + AUTO PLACE"
    )


    print(
        " + AUTO HATCH"
    )


    print(
        " + AUTO MONSTER PARASITE FEED"
    )


    print(
        " + AUTO TREADMILL"
    )


    print(
        " + AUTO FLY"
    )


    print(
        "=================================================="
    )


    print(
        "PRIORITY:"
    )


    print(
        "1. FUSE PET"
    )


    print(
        "2. NORMAL/HIGHLIGHT EGG"
    )


    print(
        "3. TREADMILL"
    )


    print(
        "=================================================="
    )


    while true do


        --================================================
        -- ALWAYS CHECK FUSE FIRST
        --================================================

        local Pet1,
            Pet2,
            Pet3 =
            FindThreeSamePets()


        --================================================
        -- FUSE AVAILABLE
        --================================================

        if Pet1 then

            if not ProcessRunning then

                Process()

            end


            task.wait(
                LOOP_DELAY
            )


            continue

        end


        --================================================
        -- NO FUSE
        -- CHECK EGG
        --================================================

        local Egg =
            GetBestEgg()


        if Egg then

            if TreadmillRunning then

                print(
                    "[MAIN] EGG AVAILABLE"
                )


                print(
                    "[MAIN] EXIT TREADMILL"
                )


                ExitTreadmill()

            end


            if not ProcessRunning then

                Process()

            end


            task.wait(
                LOOP_DELAY
            )


            continue

        end


        --================================================
        -- NO FUSE
        -- NO EGG
        -- TREADMILL
        --================================================

        if not TreadmillRunning then

            print(
                "=========================================="
            )


            print(
                "[MAIN] NOTHING TO FUSE"
            )


            print(
                "[MAIN] NOTHING TO CARRY"
            )


            print(
                "[MAIN] -> TREADMILL"
            )


            print(
                "=========================================="
            )


            EnterTreadmill()

        else

            print(
                "[TREADMILL] WAITING..."
            )

        end


        task.wait(
            TREADMILL_CHECK_DELAY
        )

    end

end)
