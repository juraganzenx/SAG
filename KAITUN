--==================================================
-- WAIT EQUIPPED TOOL
--==================================================

local function WaitForEquippedTool(
    Timeout,
    ExpectedUID
)

    local StartTime =
        tick()

    while tick() - StartTime <
        Timeout do


        local Tool =
            GetEquippedTool()


        if Tool then

            local ToolUID =
                Tool:GetAttribute("UID")


            print(
                "[TOOL] EQUIPPED:",
                Tool.Name
            )

            print(
                "[TOOL] UID:",
                ToolUID
            )


            if ExpectedUID then

                if ToolUID
                    and tostring(ToolUID)
                        == tostring(ExpectedUID) then

                    print(
                        "[TOOL] UID VALID"
                    )

                    return Tool

                end


                warn(
                    "[TOOL] UID BELUM SESUAI"
                )

            else

                return Tool

            end

        end


        task.wait(
            TOOL_CHECK_DELAY
        )

    end


    warn(
        "[TOOL] EQUIP TIMEOUT"
    )


    return nil

end


