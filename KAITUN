--==================================================
-- NORMAL EGG PROCESS
--==================================================

local function ProcessNormalEgg(
    Egg
)

    print(
        "=========================================="
    )


    print(
        "[EGG] NORMAL EGG PROCESS"
    )


    print(
        "[EGG] Egg:",
        Egg.Name
    )


    print(
        "=========================================="
    )


    --================================================
    -- EXIT TREADMILL
    --================================================

    if TreadmillRunning then

        print(
            "[EGG] EXIT TREADMILL"
        )


        local Doffed =
            ExitTreadmill()


        if not Doffed then

            return false

        end

    end


    --================================================
    -- START AREA
    --================================================

    local StartArea =
        GetStartArea()


    if not StartArea then

        warn(
            "[EGG] StartArea tidak ditemukan."
        )

        return false

    end


    --================================================
    -- FLY START
    --================================================

    local StartPosition =
        GetPosition(
            StartArea
        )


    if not StartPosition then

        return false

    end


    StartPosition =
        StartPosition +
        Vector3.new(
            -20,
            5,
            0
        )


    print(
        "[EGG] -> FLY START AREA"
    )


    local StartReached =
        AutoFlyToPosition(
            StartPosition,
            REACH_DISTANCE,
            "MAIN:StartArea"
        )


    if not StartReached then

        return false

    end


    --================================================
    -- VALIDATE EGG
    --================================================

    if not Egg
        or not Egg.Parent then

        print(
            "[EGG] Egg sudah hilang."
        )

        return false

    end


    local IsHighlight =
        HasHighlight(
            Egg
        )


    if not IsHighlight then

        local Scale =
            GetEggScale(
                Egg
            )


        local PivotX =
            GetEggWorldPivotX(
                Egg
            )


        if Scale <=
            NORMAL_MIN_SCALE
            or PivotX <=
            NORMAL_MIN_WORLD_PIVOT_X then

            print(
                "[EGG] Egg tidak valid lagi."
            )

            return false

        end

    end


    --================================================
    -- FLY EGG
    --================================================

    print(
        "[EGG] -> FLY EGG"
    )


    local ReachedEgg =
        FlyToObject(
            Egg
        )


    if not ReachedEgg then

        return false

    end


    --================================================
    -- CARRY
    --================================================

    task.wait(
        AFTER_CARRY_START_DELAY
    )


    local Carried =
        CarryEgg(
            Egg
        )


    if not Carried then

        warn(
            "[EGG] Carry gagal."
        )

        return false

    end


    task.wait(
        CARRY_DELAY
    )


    --================================================
    -- RETURN START
    --================================================

    StartPosition =
        GetPosition(
            StartArea
        )


    if not StartPosition then

        return false

    end


    StartPosition =
        StartPosition +
        Vector3.new(
            -20,
            5,
            0
        )


    print(
        "[EGG] -> RETURN START"
    )


    StartReached =
        AutoFlyToPosition(
            StartPosition,
            REACH_DISTANCE,
            "MAIN:StartArea"
        )


    if not StartReached then

        return false

    end


    --================================================
    -- WAIT
    --================================================

    print(
        "[EGG] WAIT:",
        WAIT_AFTER_RETURN
    )


    task.wait(
        WAIT_AFTER_RETURN
    )


    --================================================
    -- CHECK TOOL
    --================================================

    local Tool =
        GetEquippedTool()


    if not Tool then

        Tool =
            WaitForEquippedTool(
                5
            )

    end


    if not Tool then

        warn(
            "[EGG] Tool tidak muncul."
        )

        return false

    end


    print(
        "[EGG] TOOL:",
        Tool.Name
    )


    print(
        "[EGG] TOOL UID:",
        Tool:GetAttribute(
            "UID"
        )
    )


    --================================================
    -- PARASITE CHECK #1
    --================================================

    print(
        "[EGG] CHECK PARASITE"
    )


    local ParasiteHandled =
        CheckAndFeedParasite()


    if ParasiteHandled then

        print(
            "=========================================="
        )


        print(
            "[EGG] PARASITE HANDLED"
        )


        print(
            "[EGG] PLACE SKIPPED"
        )


        print(
            "=========================================="
        )


        return true

    end


    --================================================
    -- OWN PLOT
    --================================================

    local Plot =
        GetMyPlot()


    if not Plot then

        return false

    end


    --================================================
    -- FLY OWN PLOT
    --================================================

    print(
        "[EGG] -> FLY OWN PLOT"
    )


    local ReachedPlot =
        FlyToObject(
            Plot
        )


    if not ReachedPlot then

        return false

    end


    --================================================
    -- CHECK TOOL AGAIN
    --================================================

    local CurrentTool =
        GetEquippedTool()


    if not CurrentTool then

        warn(
            "[EGG] Tool tidak lagi equipped."
        )

        return false

    end


    --================================================
    -- PARASITE SAFETY RECHECK
    --================================================

    print(
        "[EGG] PARASITE SAFETY RECHECK"
    )


    local ParasiteAfterPlot =
        CheckAndFeedParasite()


    if ParasiteAfterPlot then

        print(
            "[EGG] PARASITE DETECTED"
        )


        print(
            "[EGG] PLACE CANCELLED"
        )


        return true

    end


    --================================================
    -- PLACE
    --================================================

    print(
        "[EGG] -> PLACE"
    )


    local Placed =
        PlaceEggUntilSuccess(
            CurrentTool,
            Plot
        )


    if not Placed then

        return false

    end


    --================================================
    -- HATCH
    --================================================

    print(
        "[EGG] PLACE SUCCESS"
    )


    print(
        "[EGG] -> START HATCH"
    )


    StartHatch()


    --================================================
    -- WAIT HATCH
    --================================================

    print(
        "[EGG] WAIT:",
        HATCH_RESUME_TIME,
        "SEC"
    )


    task.wait(
        HATCH_RESUME_TIME
    )


    print(
        "[EGG] NORMAL EGG PROCESS COMPLETE"
    )


    return true

end


