    )


    return true

end


--==================================================
-- PLACED EGGS
--==================================================

local function IsMyPlacedEgg(
    Egg
)

    local Prefix =
        tostring(
            LocalPlayer.UserId
        )
        .. "_"


    return string.sub(
        Egg.Name,
        1,
        #Prefix
    ) == Prefix

end


local function GetMyPlacedEggs()

    local Eggs = {}
    local Seen = {}


    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if Object.Name ==
            "PlacedEggRenders" then

            for _, Egg in ipairs(
                Object:GetChildren()
            ) do

                if IsMyPlacedEgg(Egg)
                    and not Seen[Egg] then

                    Seen[Egg] = true

                    table.insert(
                        Eggs,
                        Egg
                    )

                end

            end

        end

    end


    return Eggs

end


--==================================================
-- HATCH ONE
--==================================================

local function HatchOneEgg(
    Egg
)

    local Position =
        GetPosition(
            Egg
        )


    if not Position then
        return false
    end


    if not AutoFlyToPosition(
        Position,
        WALK_TO_EGG_DISTANCE,
        "HATCH:" .. Egg.Name
    ) then

        return false

    end


    local StartTime =
        tick()


    while tick() - StartTime <
        HATCH_MAX_TIME do

        if not Egg.Parent then
            return true
        end


        local Root =
            GetRoot()


        if Root then

            for _, Prompt in ipairs(
                Workspace:GetDescendants()
            ) do

                if Prompt:IsA(
                    "ProximityPrompt"
                )
                    and Prompt.Enabled then

                    local Parent =
                        Prompt.Parent


                    if Parent
                        and Parent:IsA(
                            "BasePart"
                        ) then

                        local Distance =
                            (
                                Root.Position
                                - Parent.Position
                            ).Magnitude


                        if Distance <=
                            MAX_PROMPT_DISTANCE then

                            pcall(function()

                                fireproximityprompt(
                                    Prompt
                                )

                            end)

                        end

                    end

                end

            end

        end


        task.wait(
            PROMPT_CHECK_DELAY
        )

    end


    return false

end


