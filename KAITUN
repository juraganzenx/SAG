--==================================================
-- FUSE CYCLE
--==================================================

local function TryFuseCycle()

    local Pet1,
        Pet2,
        Pet3 =
        FindThreeSamePets()


    if not Pet1 then
        return false
    end


    if TreadmillRunning then

        if not ExitTreadmill() then
            return false
        end

    end


    if not LoadOnePet(
        Pet1,
        1
    ) then
        return false
    end


    if not LoadOnePet(
        Pet2,
        2
    ) then
        return false
    end


    if not LoadOnePet(
        Pet3,
        3
    ) then
        return false
    end


    if not StartFuse() then
        return false
    end


    if not FinishFuse() then
        return false
    end


    local FusedEgg =
        WaitForFusedEggEquipped(
            FUSED_EGG_WAIT_TIMEOUT
        )


    if not FusedEgg then
        return false
    end


    return PlaceFusedEgg(
        FusedEgg
    )

end


