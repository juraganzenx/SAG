--==================================================
-- RANDOM POSITION SELURUH PETAREA
--==================================================

local function GetRandomPetAreaPosition(PetArea)

    if not PetArea then
        return nil
    end

    local HalfSize = PetArea.Size / 2
    local Padding = 0.5

    local RandomX =
        math.random() * (HalfSize.X * 2) - HalfSize.X

    local RandomZ =
        math.random() * (HalfSize.Z * 2) - HalfSize.Z

    if HalfSize.X > Padding * 2 then
        RandomX = math.clamp(
            RandomX,
            -HalfSize.X + Padding,
            HalfSize.X - Padding
        )
    end

    if HalfSize.Z > Padding * 2 then
        RandomZ = math.clamp(
            RandomZ,
            -HalfSize.Z + Padding,
            HalfSize.Z - Padding
        )
    end

    return PetArea.CFrame:PointToWorldSpace(
        Vector3.new(
            RandomX,
            HalfSize.Y,
            RandomZ
        )
    )
end

