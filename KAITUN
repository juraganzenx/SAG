    end

end


--==================================================
-- AUTO FLY TO POSITION
--==================================================

local function AutoFlyToPosition(
    TargetPosition,
    Distance,
    LockName
)

    if not TargetPosition then

        return false

    end


    Distance =
        Distance
        or REACH_DISTANCE


    LockName =
        LockName
        or "AUTO_FLY"


    if not AcquireMovementLock(
        LockName
    ) then

        return false

    end


    local Root =
        GetRoot()


    local Humanoid =
        GetHumanoid()


    if not Root
        or not Humanoid then

        ReleaseMovementLock(
            LockName
        )

        return false

    end


    print(
        "[AUTO FLY] START:",
        LockName
    )


    print(
        "[AUTO FLY] TARGET:",
        TargetPosition
    )


    --================================================
    -- SAVE HUMANOID
    --================================================

    local OldPlatformStand =
        Humanoid.PlatformStand


    local OldAutoRotate =
        Humanoid.AutoRotate


    Humanoid.PlatformStand =
        true


    Humanoid.AutoRotate =
        false


    --================================================
    -- BODY GYRO
    --================================================

    local BG =
        Instance.new("BodyGyro")


    BG.Name =
        "AutoCombinedFlyGyro"


    BG.P =
        9e4


    BG.MaxTorque =
        Vector3.new(
            9e9,
            9e9,
            9e9
        )


    BG.CFrame =
        Root.CFrame


    BG.Parent =
        Root


    --================================================
    -- BODY VELOCITY
    --================================================

    local BV =
        Instance.new("BodyVelocity")


    BV.Name =
        "AutoCombinedFlyVelocity"


    BV.MaxForce =
        Vector3.new(
            9e9,
            9e9,
            9e9
        )


    BV.Velocity =
        Vector3.zero


    BV.Parent =
        Root


    local Success =
        false


    local StartTime =
        tick()


    --================================================
    -- FLY LOOP
    --================================================

    while true do

        Root =
            GetRoot()


        Humanoid =
            GetHumanoid()


        if not Root
            or not Humanoid then

            break

        end


        --============================================
        -- TIMEOUT
        --============================================

        if tick() - StartTime >
            FLY_MAX_TIME then

            warn(
                "[AUTO FLY] TIMEOUT:",
                LockName
            )

            break

        end


        --============================================
        -- DISTANCE
        --============================================

        local Offset =
            TargetPosition -
            Root.Position


        local CurrentDistance =
            Offset.Magnitude


        if CurrentDistance <=
            Distance then

            Success =
                true


            print(
                "[AUTO FLY] REACHED:",
                LockName,
                "| Distance:",
                math.floor(
                    CurrentDistance * 10
                ) / 10
            )


            break

        end


        --============================================
        -- DIRECTION
        --============================================

        local Direction


        if CurrentDistance > 0 then

            Direction =
                Offset.Unit

        else

            Direction =
                Vector3.zero

        end


        --============================================
        -- SPEED
        --============================================

        local CurrentSpeed =
            math.min(
                FLY_SPEED,
                math.max(
                    100,
                    CurrentDistance * 8
                )
            )


        BV.Velocity =
            Direction *
            CurrentSpeed


        --============================================
        -- FACE TARGET
        --============================================

        if Direction.Magnitude > 0 then

            BG.CFrame =
                CFrame.lookAt(
                    Root.Position,
                    Root.Position + Direction
                )

        end


        task.wait(
            FLY_UPDATE_DELAY
        )

    end


    --================================================
    -- STOP
    --================================================

    BV.Velocity =
        Vector3.zero


    StopFly()


    task.wait()


    if BG then

        BG:Destroy()

    end


    if BV then

        BV:Destroy()

    end


    --================================================
    -- RESTORE
    --================================================

    Humanoid =
        GetHumanoid()


    if Humanoid then

        Humanoid.PlatformStand =
            OldPlatformStand


        Humanoid.AutoRotate =
            OldAutoRotate

    end


    StopFly()


    ReleaseMovementLock(
        LockName
    )


    print(
        "[AUTO FLY] END:",
        LockName,
        "| SUCCESS:",
        Success
    )


    return Success

end


--==================================================
-- GET OBJECT POSITION
--==================================================

local function GetPosition(Object)

    if not Object then

        return nil

    end


    if Object:IsA("BasePart") then

        return Object.Position

    end


    if Object:IsA("Model") then

        local Success, Pivot =
            pcall(function()

                return Object:GetPivot()

            end)


        if Success and Pivot then

            return Pivot.Position

        end

    end


    return nil

end


--==================================================
-- FLY TO OBJECT
--==================================================

local function FlyToObject(
    Object,
    Distance,
    LockPrefix
)

    if not Object then

        return false

    end


    local Position =
        GetPosition(Object)


    if not Position then

        warn(
            "[AUTO FLY] Position tidak ditemukan:",
            Object.Name
        )

        return false

    end


    local Prefix =
        LockPrefix
        or "MAIN"


    local LockName =
        Prefix .. ":" .. Object.Name


    return AutoFlyToPosition(
        Position,
        Distance or REACH_DISTANCE,
        LockName
    )

end


