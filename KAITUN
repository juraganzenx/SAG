local function PlaceEggOnce(
    Tool,
    Plot
)

    if not Tool then
        return false
    end


    local UID =
        Tool:GetAttribute(
            "UID"
        )


    if typeof(UID) ~= "string"
        or UID == "" then

        warn(
            "[PLACE] UID INVALID"
        )

        return false

    end


    local AreaPart =
        GetPlotArea(
            Plot
        )


    if not AreaPart then
        return false
    end


    local Position =
        GetRandomPosition(
            Plot,
            AreaPart
        )


    if not Position then
        return false
    end


    print(
        "[PLACE] UID:",
        UID
    )


    local Success,
        Result =
        pcall(function()

            return PlaceEggRemote:
                InvokeServer({

                    ["Uid"] =
                        UID,

                    ["LocalCFrame"] =
                        CFrame.new(
                            Position.X,
                            FIXED_Y,
                            Position.Z
                        )

                })

        end)


    print(
        "[PLACE] RESULT:",
        Success,
        Result
    )


    if not Success
        or Result == false then

        return false

    end


    return true

end


