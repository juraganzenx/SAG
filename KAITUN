    print("[SYSTEM] PRIORITY 1 -> CHECK FUSE")
    print("##########################################")


    local FuseResult =
        ProcessOneFuse()


    --================================================
    -- 3 PET FOUND / FUSE DONE
    --================================================

    if FuseResult == true then

        print("")
        print("##########################################")
        print("[SYSTEM] FUSE SUCCESS")
        print("[SYSTEM] NEXT LOOP -> CHECK FUSE AGAIN")
        print("##########################################")


        return

    end


    --================================================
    -- NO 3 SAME PET
    --================================================

    if FuseResult ==
        "NO_FUSE_PET" then

        print("")
        print("##########################################")
        print("[SYSTEM] NO 3 SAME PET")
        print("[SYSTEM] FALLBACK -> AUTO EGG")
        print("##########################################")


        ProcessEggAutomation()


        return

    end


    --================================================
    -- FUSE ERROR
    --================================================

    warn(
        "[SYSTEM] FUSE PROCESS ERROR"
    )


    -- Jangan langsung menjalankan egg
    -- jika fuse gagal di tengah proses.
    -- Tunggu loop berikutnya.

end


