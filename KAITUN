--==================================================

local function HatchOneEgg(
    Egg
)

    if not Egg
        or not Egg.Parent then

        warn(
            "[HATCH] EGG SUDAH TIDAK ADA:",
            Egg and Egg.Name or "nil"
        )

        return false

    end


    print(
        "=========================================="
    )

    print(
        "[HATCH] START:",
        Egg.Name
    )


    local Position =
        GetPlacedEggPosition(
            Egg
        )


    if not Position then

        warn(
            "[HATCH] POSITION TIDAK DITEMUKAN"
        )

        return false

    end


    local Reached =
        AutoFlyToPosition(
            Position,
            WALK_TO_EGG_DISTANCE,
            "HATCH:" .. Egg.Name
        )


    if not Reached then

        warn(
            "[HATCH] GAGAL MENUJU EGG:",
            Egg.Name
        )

        return false

    end


    TriggeredPrompts = {}


    local StartTime =
        tick()


    while tick() - StartTime <
        HATCH_MAX_TIME do


        if not Egg.Parent then

            print(
                "[HATCH] SUCCESS:",
                Egg.Name
            )

            return true

        end


        TriggerNearbyPrompts()


        task.wait(
            PROMPT_CHECK_DELAY
        )

    end


    warn(
        "[HATCH] TIMEOUT:",
        Egg.Name
    )


    return false

end


--==================================================
-- HATCH ALL OWN EGGS
--
-- IMPORTANT:
--
-- DI SINI HANYA SCAN 1X.
--
-- Contoh:
--
-- Saat fungsi dipanggil:
-- Egg #1
-- Egg #2
--
-- Snapshot = {Egg1, Egg2}
--
-- Kemudian:
-- Hatch Egg1
-- Hatch Egg2
--
-- Setelah itu SELESAI.
--
-- TIDAK ADA:
-- while true
-- GetMyPlacedEggs()
--
-- Jadi egg baru yang muncul ketika proses
-- hatch berlangsung TIDAK ikut di-loop ini.
--==================================================

local function HatchAllPlacedEggs()

    if HatchRunning then

        print(
            "[HATCH] ALREADY RUNNING"
        )

        return

    end


    HatchRunning = true


    local Success,
        Error =
        xpcall(function()


            --======================================
            -- SCAN HANYA 1X
            --======================================

            local Eggs =
                GetMyPlacedEggs()


            local EggCount =
                #Eggs


            print(
                "=========================================="
            )

            print(
                "[HATCH] SNAPSHOT TOTAL:",
                EggCount
            )

            print(
                "[HATCH] SCAN HANYA 1X"
            )

            print(
                "=========================================="
            )


            --======================================
            -- TIDAK ADA EGG
            --======================================

            if EggCount == 0 then

                print(
                    "[HATCH] NO OWN EGG"
                )

                return

            end


            --======================================
            -- HATCH SESUAI SNAPSHOT
            --======================================

            for Index, Egg in ipairs(
                Eggs
            ) do


                print(
                    "=========================================="
                )

                print(
                    "[HATCH] PROCESS:",
                    Index,
                    "/",
                    EggCount
                )

                print(
                    "[HATCH] EGG:",
                    Egg.Name
                )


                -- Kalau egg masih ada -> hatch
                if Egg
                    and Egg.Parent then

                    HatchOneEgg(
                        Egg
                    )

                else

                    warn(
                        "[HATCH] EGG SUDAH HILANG:",
                        Egg and Egg.Name or "nil"
                    )

                end


                -- Delay antar egg
                if Index < EggCount then

                    task.wait(
                        0.5
                    )

                end

            end


            --======================================
            -- SELESAI
            --======================================

            print(
                "=========================================="
            )

            print(
                "[HATCH] SNAPSHOT HATCH COMPLETE"
            )

            print(
                "[HATCH] TOTAL YANG DIPROSES:",
                EggCount
            )

            print(
                "[HATCH] TIDAK SCAN ULANG"
            )

            print(
                "=========================================="
            )


        end,
        debug.traceback)


    if not Success then

        warn(
            "[HATCH] ERROR:",
            Error
        )

        StopFly()

        MovementOwner = nil

    end


    HatchRunning = false

end


