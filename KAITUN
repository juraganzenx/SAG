local function GetHighlightedEgg()


local Folder =
    GetEggFolder()


if not Folder then

    return nil

end


for _, Object in ipairs(
    Folder:GetDescendants()
) do

    if Object.ClassName ==
        HIGHLIGHT_CLASS_NAME then


        local Enabled =
            true


        if REQUIRE_HIGHLIGHT_ENABLED then

            local Success,
                Value =
                pcall(function()

                    return Object.Enabled

                end)


            if not Success then

                Enabled =
                    false

            else

                Enabled =
                    Value

            end

        end


        if Enabled then

            local Current =
                Object.Parent


            while Current
                and Current ~= Folder do

                if Current:IsA("Model")
                    and IsValidEgg(Current) then

                    print(
                        "[HIGHLIGHT] FOUND:",
                        Current.Name
                    )

                    return Current

                end


                Current =
                    Current.Parent

            end

        end

    end

end


return nil


end

