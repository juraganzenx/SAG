--==================================================
-- WAIT FUSED EGG
--==================================================

local function WaitForFusedEgg(
    Timeout
)

    local StartTime =
        tick()


    while tick() - StartTime <
        Timeout do


        --============================================
        -- EQUIPPED
        --============================================

        local Equipped =
            GetEquippedTool()


        if Equipped then

            print(
                "[FUSE] FUSED RESULT EQUIPPED:",
                Equipped.Name
            )


            return Equipped

        end


        --============================================
        -- BACKPACK
        --============================================

        local Backpack =
            GetBackpack()


        if Backpack then

            for _, Object in ipairs(
                Backpack:GetChildren()
            ) do

                if Object:IsA("Tool") then

                    print(
                        "[FUSE] FUSED RESULT FOUND:",
                        Object.Name
                    )


                    return Object

                end

            end

        end


        task.wait(
            0.2
        )

    end


    warn(
        "[FUSE] Fused egg timeout."
    )


    return nil

end


--==================================================
-- GET OWN PLOT
--==================================================

local function GetMyPlot()

    local Plots =
        Workspace:FindFirstChild(
            "Plots"
        )


    if not Plots then

        warn(
            "[PLOT] workspace.Plots tidak ditemukan."
        )

        return nil

    end


    for PlotNumber =
        MIN_PLOT,
        MAX_PLOT do


        local Plot =
            Plots:FindFirstChild(
                tostring(PlotNumber)
            )


        if Plot then

            local PlotSign =
                Plot:FindFirstChild(
                    "PlotSign"
                )


            if PlotSign then

                local PlayerPlotSign =
                    PlotSign:FindFirstChild(
                        "PlayerPlotSign"
                    )


                if PlayerPlotSign then

                    local Frame =
                        PlayerPlotSign:FindFirstChild(
                            "Frame"
                        )


                    if Frame then

                        local PlayerName =
                            Frame:FindFirstChild(
                                "PlayerName"
                            )


                        if PlayerName then

                            if PlayerName.Text ==
                                LocalPlayer.Name then


                                print(
                                    "[PLOT] MY PLOT:",
                                    Plot.Name
                                )


                                return Plot

                            end

                        end

                    end

                end

            end

        end

    end


    warn(
        "[PLOT] Plot milik sendiri tidak ditemukan."
    )


    return nil

end


