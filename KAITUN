--==================================================
-- MOVEMENT LOCK
--==================================================

local function AcquireMovementLock(
    Name
)

    if MovementOwner ~= nil then

        warn(
            "[TELEPORT] BUSY:",
            MovementOwner,
            "| REQUEST:",
            Name
        )

        return false

    end


    MovementOwner = Name

    return true

end


local function ReleaseMovementLock(
    Name
)

    if MovementOwner == Name then

        MovementOwner = nil

    end

end


--==================================================
-- STOP MOVEMENT
--==================================================

local function StopFly()

    local Root =
        GetRoot()


    if Root then

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end

end


--==================================================
-- TELEPORT
--==================================================

local function AutoFlyToPosition(
    TargetPosition,
    Distance,
    LockName
)

    if not TargetPosition then
        return false
    end


    Distance =
        Distance
        or REACH_DISTANCE


    LockName =
        LockName
        or "AUTO_TELEPORT"


    if not AcquireMovementLock(
        LockName
    ) then

        return false

    end


    local Root =
        GetRoot()


    if not Root then

        ReleaseMovementLock(
            LockName
        )

        return false

    end


    print(
        "[TELEPORT] ->",
        LockName
    )


    local Success,
        Error =
        pcall(function()

            Root.CFrame =
                CFrame.new(
                    TargetPosition
                )

        end)


    if not Success then

        warn(
            "[TELEPORT] ERROR:",
            Error
        )

        ReleaseMovementLock(
            LockName
        )

        return false

    end


    task.wait(
        0.08
    )


    Root =
        GetRoot()


    if not Root then

        ReleaseMovementLock(
            LockName
        )

        return false

    end


    local CurrentDistance =
        (
            Root.Position
            - TargetPosition
        ).Magnitude


    local Result =
        CurrentDistance <= Distance


    print(
        "[TELEPORT] DIST:",
        CurrentDistance,
        "| SUCCESS:",
        Result
    )


    ReleaseMovementLock(
        LockName
    )


    return Result

end


--==================================================
-- GET POSITION
--==================================================

local function GetPosition(
    Object
)

    if not Object then
        return nil
    end


    if Object:IsA(
        "BasePart"
    ) then

        return Object.Position

    end


    if Object:IsA(
        "Model"
    ) then

        local Success,
            Pivot =
            pcall(function()

                return Object:GetPivot()

            end)


        if Success
            and Pivot then

            return Pivot.Position

        end

    end


    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )


    if Part then
        return Part.Position
    end


    return nil

end


--==================================================
-- TELEPORT OBJECT
--==================================================

local function FlyToObject(
    Object,
    Distance,
    LockName
)

    local Position =
        GetPosition(
            Object
        )


    if not Position then

        warn(
            "[TELEPORT] POSITION INVALID:",
            Object
        )

        return false

    end


    return AutoFlyToPosition(
        Position,
        Distance or REACH_DISTANCE,
        LockName or "OBJECT"
    )

end


--==================================================
-- FIND 3 SAME PET
--==================================================

local function FindThreeSamePets()

    local Backpack =
        GetBackpack()


    if not Backpack then
        return nil
    end


    local Groups = {}


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if Tool:IsA("Tool")
            and not BLACKLIST[Tool.Name] then

            local Weight =
                Tool:GetAttribute(
                    "Weight"
                )

            local UID =
                Tool:GetAttribute(
                    "UID"
                )


            if typeof(Weight) == "number"
                and Weight < MAX_PET_WEIGHT
                and typeof(UID) == "string"
                and UID ~= "" then

                Groups[Tool.Name] =
                    Groups[Tool.Name]
                    or {}


                table.insert(
                    Groups[Tool.Name],
                    Tool
                )

            end

        end

    end


    for Name, Tools in pairs(
        Groups
    ) do

        if #Tools >= 3 then

            print(
                "[FUSE] FOUND:",
                Name
            )


            return
                Tools[1],
                Tools[2],
                Tools[3]

        end

    end


    return nil

end


