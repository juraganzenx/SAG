local function IsMyEgg(
    Egg
)

    if not Egg then
        return false
    end


    return string.match(
        Egg.Name,
        "^" .. UserId .. "_"
    ) ~= nil

end


local function GetPlacedEggPosition(
    Egg
)

    if not Egg
        or not Egg.Parent then

        return nil

    end


    if Egg:IsA("BasePart") then
        return Egg.Position
    end


    if Egg:IsA("Model") then

        local Success,
            Pivot =
            pcall(function()

                return Egg:GetPivot()

            end)


        if Success
            and Pivot then

            return Pivot.Position

        end

    end


    local Part =
        Egg:FindFirstChildWhichIsA(
            "BasePart",
            true
        )


    if Part then
        return Part.Position
    end


    return nil

end


local function GetMyPlacedEggs()

    local Eggs = {}
    local Seen = {}


    for _, Render in ipairs(
        GetActiveRenders()
    ) do


        for _, Egg in ipairs(
            Render:GetChildren()
        ) do


            if IsMyEgg(Egg)
                and not Seen[Egg] then

                Seen[Egg] = true

                table.insert(
                    Eggs,
                    Egg
                )

            end

        end

    end


    return Eggs

end


--==================================================
-- TRIGGER PROMPTS
--==================================================

local function TriggerNearbyPrompts()

    local Root =
        GetRoot()


    if not Root then
        return
    end


    for _, Prompt in ipairs(
        Workspace:GetDescendants()
    ) do


        if Prompt:IsA(
            "ProximityPrompt"
        )
            and Prompt.Enabled then


            local Part =
                Prompt.Parent


            if Part
                and Part:IsA(
                    "BasePart"
                ) then


                local Distance =
                    (
                        Root.Position
                        - Part.Position
                    ).Magnitude


                if Distance <
                    MAX_PROMPT_DISTANCE then


                    if not TriggeredPrompts[
                        Prompt
                    ] then


                        TriggeredPrompts[
                            Prompt
                        ] = true


                        print(
                            "[HATCH] TRIGGER:",
                            Prompt:GetFullName()
                        )


                        pcall(function()

                            fireproximityprompt(
                                Prompt
                            )

                        end)

                    end


                else

                    TriggeredPrompts[
                        Prompt
                    ] = nil

                end

            end

        end

    end

end


