        "[FIELD EGG] EGG POSITION:",
        EggPosition
    )


    --==================================================
    -- TELEPORT DEKAT EGG
    --==================================================

    local CarryPosition =
        EggPosition
        + Vector3.new(
            0,
            FIELD_EGG_HEIGHT_OFFSET,
            0
        )


