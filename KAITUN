        end

    end


    warn(
        "[PLOT] OWN PLOT TIDAK DITEMUKAN"
    )


    return nil

end


--==================================================
-- GET PLOT AREA
--==================================================

local function GetPlotArea(
    Plot
)

    if not Plot then
        return nil
    end


    local BiggestPart = nil
    local BiggestArea = 0


    for _, Object in ipairs(
        Plot:GetDescendants()
    ) do


        if Object:IsA(
            "BasePart"
        ) then


            local Name =
                Object.Name:lower()


            if not Name:find("sign")
                and not Name:find(
                    "playername"
                )
                and not Name:find(
                    "deco"
                )
                and not Name:find(
                    "border"
                )
                and not Name:find(
                    "wall"
                )
                and not Name:find(
                    "fence"
                ) then


                local Area =
                    Object.Size.X
                    * Object.Size.Z


                if Area >
                    BiggestArea then

                    BiggestArea =
                        Area

                    BiggestPart =
                        Object

                end

            end

        end

    end


    if BiggestPart then

        print(
            "[PLACE] AREA:",
            BiggestPart:GetFullName(),
            "| SIZE:",
            BiggestPart.Size
        )

    end


    return BiggestPart

end


--==================================================
-- RANDOM POSITION
--==================================================

local function GetRandomPosition(
    Plot,
    AreaPart
)

    if not Plot
        or not AreaPart then

        return nil

    end


    local Size =
        AreaPart.Size


    local MinX =
        -Size.X / 2
        + MARGIN


    local MaxX =
        Size.X / 2
        - MARGIN


    local MinZ =
        -Size.Z / 2
        + MARGIN


    local MaxZ =
        Size.Z / 2
        - MARGIN


    if MinX > MaxX then

        MinX = 0
        MaxX = 0

    end


    if MinZ > MaxZ then

        MinZ = 0
        MaxZ = 0

    end


    local LocalX =
        MinX
        + math.random()
        * (MaxX - MinX)


    local LocalZ =
        MinZ
        + math.random()
        * (MaxZ - MinZ)


    local WorldPosition =
        AreaPart.CFrame:
        PointToWorldSpace(
            Vector3.new(
                LocalX,
                0,
                LocalZ
            )
        )


    local PlotPivot =
        Plot:GetPivot()


    local PlotLocalPosition =
        PlotPivot:
        PointToObjectSpace(
            WorldPosition
        )


    local Result =
        Vector3.new(
            PlotLocalPosition.X,
            FIXED_Y,
            PlotLocalPosition.Z
        )


    print(
        "[PLACE] RANDOM LOCAL:",
        Result
    )


    return Result

end


--==================================================
-- PLACE EGG
--==================================================

local function PlaceEggOnce(
    Tool,
    Plot
)

    if not Tool
        or not Tool.Parent then

        warn(
            "[PLACE] TOOL INVALID"
        )

        return false

    end


    local UID =
        Tool:GetAttribute(
            "UID"
        )


    if typeof(UID) ~= "string"
        or UID == "" then

        warn(
            "[PLACE] UID TIDAK DITEMUKAN:",
            Tool.Name
        )

        return false

    end


    local AreaPart =
        GetPlotArea(
            Plot
        )


    if not AreaPart then

        warn(
            "[PLACE] PLOT AREA TIDAK DITEMUKAN"
        )

        return false

    end


    local RandomPosition =
        GetRandomPosition(
            Plot,
            AreaPart
        )


    if not RandomPosition then
        return false
    end


    local LocalCFrame =
        CFrame.new(
            RandomPosition.X,
            FIXED_Y,
            RandomPosition.Z
        )


    print(
        "=========================================="
    )

    print(
        "[PLACE] PLACE TOOL:",
        Tool.Name
    )

    print(
        "[PLACE] UID:",
        UID
    )

    print(
        "[PLACE] LOCAL CF:",
        LocalCFrame
    )


    local Success,
        Result =
        pcall(function()

            return PlaceEggRemote:
                InvokeServer({

                    ["Uid"] =
                        UID,

                    ["LocalCFrame"] =
                        LocalCFrame,

                })

        end)


    print(
        "[PLACE] RESULT:",
        Success,
        Result
    )


    if not Success then

        warn(
            "[PLACE] ERROR:",
            Result
        )

        return false

    end


    if Result == false then

        warn(
            "[PLACE] SERVER RETURN FALSE"
        )

        return false

    end


    return true

end


--==================================================
