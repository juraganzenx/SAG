    end


    local UID =
        EggInfo.UID


    print(
        "=========================================="
    )

    print(
        "[INVENTORY PLACE] START"
    )

    print(
        "[INVENTORY PLACE] UID:",
        UID
    )


    --==============================================
    -- EQUIP
    --==============================================

    local Tool =
        EquipEggByUID(
            UID
        )


    if not Tool then

        warn(
            "[INVENTORY PLACE] GAGAL EQUIP:",
            UID
        )

        return false

    end


    --==============================================
    -- GET PLOT
    --==============================================

    local Plot =
        GetMyPlot()


    if not Plot then
        return false
    end


    --==============================================
    -- FLY PLOT
    --==============================================

    if not FlyToObject(
        Plot,
        REACH_DISTANCE,
        "PLACE:OWN_PLOT"
    ) then

        return false

    end


    task.wait(
        0.2
    )


    --==============================================
    -- VALIDATE EQUIPPED TOOL
    --==============================================

    Tool =
        GetEquippedTool()


    if not Tool then

        warn(
            "[INVENTORY PLACE] TOOL HILANG"
        )

        return false

    end


    local ToolUID =
        Tool:GetAttribute(
            "UID"
        )


    print(
        "[INVENTORY PLACE] CURRENT TOOL:",
        Tool.Name
    )

    print(
        "[INVENTORY PLACE] CURRENT UID:",
        ToolUID
    )


    if not ToolUID
        or tostring(ToolUID)
            ~= tostring(UID) then

        warn(
            "[INVENTORY PLACE] UID TOOL TIDAK SESUAI"
        )

        return false

    end


    --==============================================
    -- PLACE
    --==============================================

    if not PlaceEggByUID(
        UID,
        Plot
    ) then

        warn(
            "[INVENTORY PLACE] PLACE FAILED"
        )

        return false

    end


    --==============================================
    -- WAIT TOOL GONE
    --==============================================

    task.wait(
        0.5
    )


    WaitToolGone(
        Tool,
        WAIT_TOOL_GONE
    )


    --==============================================
    -- VERIFY INVENTORY
    --==============================================

    if IsEggStillAvailable(
        UID
    ) then

        warn(
            "[INVENTORY PLACE] EGG MASIH ADA:",
            UID
        )

        return false

    end


    print(
        "[INVENTORY PLACE] SUCCESS:",
        UID
    )


    return true

