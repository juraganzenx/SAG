local function GetMyPlot()


local Plots =
    Workspace:FindFirstChild(
        "Plots"
    )


if not Plots then
    return nil
end


for Number =
    MIN_PLOT,
    MAX_PLOT do


    local Plot =
        Plots:FindFirstChild(
            tostring(Number)
        )


    if Plot then

        local PlotSign =
            Plot:FindFirstChild(
                "PlotSign"
            )


        local PlayerPlotSign =
            PlotSign
            and PlotSign:FindFirstChild(
                "PlayerPlotSign"
            )


        local Frame =
            PlayerPlotSign
            and PlayerPlotSign:FindFirstChild(
                "Frame"
            )


        local PlayerName =
            Frame
            and Frame:FindFirstChild(
                "PlayerName"
            )


        if PlayerName
            and PlayerName.Text ==
                LocalPlayer.Name then

            return Plot

        end

    end

end


return nil


end

--==================================================
-- GET PLOT AREA
--==================================================

local function GetPlotArea(
Plot
)


if not Plot then
    return nil
end


local BiggestPart =
    nil

local BiggestArea =
    0


for _, Object in ipairs(
    Plot:GetDescendants()
) do

    if Object:IsA("BasePart") then

        local Name =
            Object.Name:lower()


        if not Name:find("sign")
            and not Name:find("playername")
            and not Name:find("deco")
            and not Name:find("border")
            and not Name:find("wall")
            and not Name:find("fence") then


            local Area =
                Object.Size.X
                * Object.Size.Z


            if Area >
                BiggestArea then

                BiggestArea =
                    Area

                BiggestPart =
                    Object

            end

        end

    end

end


return BiggestPart


end

--==================================================
-- RANDOM PLOT POSITION
--==================================================

local function GetRandomPosition(
Plot,
AreaPart
)


if not Plot
    or not AreaPart then

    return nil

end


local Size =
    AreaPart.Size


local X =
    math.random(
        -math.floor(
            Size.X / 2 - MARGIN
        ),
        math.floor(
            Size.X / 2 - MARGIN
        )
    )


local Z =
    math.random(
        -math.floor(
            Size.Z / 2 - MARGIN
        ),
        math.floor(
            Size.Z / 2 - MARGIN
        )
    )


local WorldPosition =
    AreaPart.CFrame:
    PointToWorldSpace(
        Vector3.new(
            X,
            0,
            Z
        )
    )


local PlotPivot =
    Plot:GetPivot()


local LocalPosition =
    PlotPivot:
    PointToObjectSpace(
        WorldPosition
    )


