--==================================================

local function HatchOneEgg(
Egg
)


local Position =
    GetObjectPosition(
        Egg
    )


if not Position then
    return false
end


if not TweenToPosition(
    Position
) then

    return false

end


local StartTime =
    tick()


while tick() - StartTime <
    HATCH_MAX_TIME do


    if not Egg.Parent then
        return true
    end


    local Root =
        GetRoot()


    if Root then

        for _, Prompt in ipairs(
            Workspace:GetDescendants()
        ) do


            if Prompt:IsA(
                "ProximityPrompt"
            )
                and Prompt.Enabled then


                local Parent =
                    Prompt.Parent


                if Parent
                    and Parent:IsA(
                        "BasePart"
                    ) then


                    local Distance =
                        (
                            Root.Position
                            - Parent.Position
                        ).Magnitude


                    if Distance <=
                        MAX_PROMPT_DISTANCE then


                        pcall(function()

                            fireproximityprompt(
                                Prompt
                            )

                        end)


                    end

                end

            end

        end

    end


    task.wait(
        PROMPT_CHECK_DELAY
    )

end


return false


end

