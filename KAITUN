--==================================================
-- GET BEST HIGHLIGHT EGG
--
-- UPGRADE:
-- BUKAN RANDOM LAGI
--
-- PRIORITY:
-- 1. SCALE TERBESAR
-- 2. JIKA SCALE SAMA -> PIVOT X TERBESAR
--==================================================

local function GetHighlightEgg()

    if not HighlightEggConfig.Enabled
        or not HighlightEggConfig.RequireHighlight then

        return nil

    end


    local EggFolder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )


    if not EggFolder then

        return nil

    end


    local SelectedEgg =
        nil

    local LargestScale =
        -math.huge

    local HighestPivotX =
        -math.huge


    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model") then

            if HasHighlight(Object) then

                local Scale =
                    GetEggScale(
                        Object
                    )


                local PivotX =
                    GetEggWorldPivotX(
                        Object
                    )


                print(
                    "[AUTO EGG] HIGHLIGHT:",
                    Object.Name,
                    "| Scale:",
                    Scale,
                    "| PivotX:",
                    PivotX
                )


                --====================================
                -- SCALE TERBESAR
                --====================================

                if Scale >
                    LargestScale then

                    LargestScale =
                        Scale

                    HighestPivotX =
                        PivotX

                    SelectedEgg =
                        Object


                --====================================
                -- SCALE SAMA
                -- -> PIVOT X TERBESAR
                --====================================

                elseif Scale ==
                    LargestScale
                    and PivotX >
                    HighestPivotX then

                    HighestPivotX =
                        PivotX

                    SelectedEgg =
                        Object

