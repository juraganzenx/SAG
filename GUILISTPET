--==================================================
-- GET TEXT
--==================================================

local function GetText(Object)

    local Success, Value = pcall(function()
        return Object.ContentText
    end)

    if Success
        and Value ~= nil
        and tostring(Value) ~= "" then

        return tostring(Value)
    end

    local Attribute =
        Object:GetAttribute("ContentText")

    if Attribute ~= nil
        and tostring(Attribute) ~= "" then

        return tostring(Attribute)
    end

    if Object:IsA("TextLabel")
        or Object:IsA("TextButton")
        or Object:IsA("TextBox") then

        if Object.Text ~= "" then
            return Object.Text
        end
    end

    return nil
end

--==================================================
-- FIND TEXT
--==================================================

local function FindText(Container, Name)

    for _, Object in ipairs(
        Container:GetDescendants()
    ) do

        if Object:IsA("TextLabel")
            or Object:IsA("TextButton")
            or Object:IsA("TextBox") then

            if Object.Name:lower() == Name:lower() then

                local Text = GetText(Object)

                if Text then
                    return Text
                end
            end
        end
    end

    return ""
end

--==================================================
-- PARSE PER SECOND
--==================================================

local function ParsePerSecond(Text)

    if not Text then
        return 0
    end

    local Number, Suffix =
        Text:match(
            "%$?([%d%.]+)%s*([KkMmBbTt]?)%s*/[Ss]"
        )

    if not Number then
        return 0
    end

    Number = tonumber(Number)

    if not Number then
        return 0
    end

    Suffix = Suffix:upper()

    if Suffix == "K" then
        return Number * 1e3

    elseif Suffix == "M" then
        return Number * 1e6

    elseif Suffix == "B" then
        return Number * 1e9

    elseif Suffix == "T" then
        return Number * 1e12
    end

    return Number
end

--==================================================
-- FORMAT MONEY
--==================================================

local function FormatMoney(Number)

    if Number >= 1e12 then

        return string.format(
            "$%.2fT/s",
            Number / 1e12
        )

    elseif Number >= 1e9 then

        return string.format(
            "$%.2fB/s",
            Number / 1e9
        )

    elseif Number >= 1e6 then

        return string.format(
            "$%.2fM/s",
            Number / 1e6
        )

    elseif Number >= 1e3 then

        return string.format(
            "$%.2fK/s",
            Number / 1e3
        )

    end

    return string.format(
        "$%.0f/s",
        Number
    )
end

--==================================================
-- GET GROUP
--==================================================

local function GetGroup(Object, Data)

    local Current = Object.Parent

    -- Cari Model terdekat
    while Current and Current ~= Data do

        if Current:IsA("Model") then
            return Current
        end

        Current = Current.Parent
    end

    -- Cari Folder
    Current = Object.Parent

    while Current and Current ~= Data do

        if Current:IsA("Folder") then
            return Current
        end

        Current = Current.Parent
    end

    return Object.Parent
end

--==================================================
-- FIND MY TOTAL INCOME
--==================================================

local function FindMyTotalIncome()

    local Assets =
        workspace:FindFirstChild(
            "ClientRenderedAssets"
        )

    if not Assets then
        return 0
    end

    local GroupMap = {}
    local TotalPerSecond = 0

    --==================================================
    -- SCAN ASSET
    --==================================================

    for _, Asset in ipairs(
        Assets:GetChildren()
    ) do

        -- Hanya asset milik kita
        if string.find(
            Asset.Name,
            UserId,
            1,
            true
        ) then

            local Data =
                Asset:FindFirstChild("Data")

            if Data then

                for _, Object in ipairs(
                    Data:GetDescendants()
                ) do

                    if Object:IsA("TextLabel")
                        or Object:IsA("TextButton")
                        or Object:IsA("TextBox") then

                        local Name =
                            Object.Name:lower()

                        -- Mulai dari DisplayName
                        if Name == "displayname" then

                            local Group =
                                GetGroup(
                                    Object,
                                    Data
                                )

                            if Group then

                                local Key =
                                    Group:GetFullName()

                                -- Jangan hitung group yang sama 2x
                                if not GroupMap[Key] then

                                    GroupMap[Key] = true

                                    local PerSecond =
                                        FindText(
                                            Group,
                                            "PerSecond"
                                        )

                                    local Value =
                                        ParsePerSecond(
                                            PerSecond
                                        )

                                    TotalPerSecond += Value
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return TotalPerSecond
end

