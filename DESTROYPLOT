--==================================================
-- CLIENTRENDEREDASSETS
-- Destroy SEMUA PART di dalam ClientRenderedAssets
-- termasuk PART yang baru ditambahkan
--==================================================

local function destroyParts(obj)
    for _, descendant in ipairs(obj:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant:Destroy()
        end
    end
end

local function setupClientRenderedAssets(folder)
    -- Destroy Part yang sudah ada
    destroyParts(folder)

    -- Destroy Part yang baru ditambahkan
    folder.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("BasePart") then
            descendant:Destroy()
        end
    end)
end

-- ClientRenderedAssets yang sudah ada
for _, obj in ipairs(workspace:GetChildren()) do
    if obj.Name == "ClientRenderedAssets" then
        setupClientRenderedAssets(obj)
    end
end

-- ClientRenderedAssets yang baru muncul
workspace.ChildAdded:Connect(function(obj)
    if obj.Name == "ClientRenderedAssets" then
        setupClientRenderedAssets(obj)
    end
end)


