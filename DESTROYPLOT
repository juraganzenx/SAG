task.spawn(function()
    while task.wait(0.1) do
        local treadmill = workspace:FindFirstChild("__ClientTreadmillRenders")
        if treadmill then
            treadmill:Destroy()
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "TreadmillBottom" then
                obj:Destroy()
            end
        end
    end
end)
