-- Destroy __ClientTreadmillRenders
local treadmillRenders = workspace:FindFirstChild("__ClientTreadmillRenders")
if treadmillRenders then
    treadmillRenders:Destroy()
end

-- Destroy semua TreadmillBottom
for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("BasePart") and obj.Name == "TreadmillBottom" then
        obj:Destroy()
    end
end

-- Destroy semua Child di semua ClientRenderedAssets
for _, obj in ipairs(workspace:GetChildren()) do
    if obj.Name == "ClientRenderedAssets" then
        for _, child in ipairs(obj:GetChildren()) do
            child:Destroy()
        end
    end
end


-- Destroy semua Child di Stands.Models
local stands = workspace:FindFirstChild("Stands")
local models = stands and stands:FindFirstChild("Models")

if models then
    for _, child in ipairs(models:GetChildren()) do
        child:Destroy()
    end
end
