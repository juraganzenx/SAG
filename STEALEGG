--==================================================
-- AUTO EGG CARRY
-- PIVOT SCALE > 5
-- WALK SPEED 1000
-- AUTO STOP WHEN REACHED
-- ONLY 1 LARGEST SCALED EGG
-- PUBLIC SERVER HOP IF NO VALID EGG
-- START DELAY 5 SECONDS
--==================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local START_AREA_NAME = "StartArea"
local EGG_FOLDER_NAME = "AreaEggSlotsClient"

local WALK_SPEED = 800

local REACH_DISTANCE = 11

local CARRY_DELAY = 0

local LOOP_DELAY = 2

-- Hanya ambil jika Scale > 5
local MIN_SCALE = 6

-- Delay awal sebelum script mulai
local START_DELAY = 5

--==================================================
-- CHARACTER
--==================================================

local function GetCharacter()

    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

end


local function GetHumanoid()

    local Character = GetCharacter()

    return Character:FindFirstChildOfClass("Humanoid")

end


local function GetRoot()

    local Character = GetCharacter()

    return Character:FindFirstChild("HumanoidRootPart")

end


--==================================================
-- GET POSITION
--==================================================

local function GetPosition(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then

        return Object.Position

    end

    if Object:IsA("Model") then

        return Object:GetPivot().Position

    end

    return nil

end


--==================================================
-- STOP MOVEMENT
--==================================================

local function StopMovement()

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if Humanoid then

        Humanoid:Move(
            Vector3.zero,
            false
        )

        if Root then

            Humanoid:MoveTo(
                Root.Position
            )

        end

    end


    if Root then

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end

end


--==================================================
-- WALK TO
--==================================================

local function WalkTo(Object)

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid
        or not Root
        or not Object then

        return false

    end


    local Position =
        GetPosition(Object)

    if not Position then
        return false
    end


    Humanoid.WalkSpeed =
        WALK_SPEED


    print(
        "[AUTO EGG] Walking to:",
        Object.Name
    )


    Humanoid:MoveTo(
        Position
    )


    local StartTime =
        tick()


    while true do

        --================================================
        -- CHECK CHARACTER
        --================================================

        Root =
            GetRoot()

        if not Root then

            StopMovement()

            return false

        end


        --================================================
        -- CHECK OBJECT
        --================================================

        if not Object
            or not Object.Parent then

            StopMovement()

            return false

        end


        --================================================
        -- DISTANCE
        --================================================

        local Distance =
            (
                Root.Position
                - Position
            ).Magnitude


        --================================================
        -- REACHED
        --================================================

        if Distance <= REACH_DISTANCE then

            print(
                "[AUTO EGG] REACHED:",
                Object.Name,
                "| Distance:",
                math.floor(Distance)
            )


            StopMovement()


            RunService.Heartbeat:Wait()


            StopMovement()


            return true

        end


        --================================================
        -- TIMEOUT
        --================================================

        if tick() - StartTime > 120 then

            warn(
                "[AUTO EGG] Walk timeout:",
                Object.Name
            )


            StopMovement()

            return false

        end


        --================================================
        -- REFRESH MOVE
        --================================================

        Humanoid:MoveTo(
            Position
        )


        RunService.Heartbeat:Wait()

    end

end


--==================================================
-- GET START AREA
--==================================================

local function GetStartArea()

    return Workspace:FindFirstChild(
        START_AREA_NAME,
        true
    )

end


--==================================================
-- GET PIVOT SCALE
--==================================================

local function GetEggScale(Egg)

    if not Egg
        or not Egg:IsA("Model") then

        return 0

    end


    local Success, Scale =
        pcall(function()

            return Egg:GetScale()

        end)


    if Success
        and Scale then

        return Scale

    end


    return 0

end


--==================================================
-- GET LARGEST EGG
-- ONLY SCALE > MIN_SCALE
--==================================================

local function GetLargestScaledEgg()

    local EggFolder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )


    if not EggFolder then

        warn(
            "[AUTO EGG] AreaEggSlotsClient tidak ditemukan"
        )

        return nil

    end


    local LargestEgg = nil
    local LargestScale = MIN_SCALE


    --================================================
    -- SCAN ALL OBJECTS
    --================================================

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model") then

            local Scale =
                GetEggScale(Object)


            print(
                "[AUTO EGG] Found:",
                Object.Name,
                "| Pivot Scale:",
                Scale
            )


            --================================================
            -- ONLY SCALE > MIN_SCALE
            --================================================

            if Scale > MIN_SCALE then

                if Scale > LargestScale then

                    LargestScale =
                        Scale

                    LargestEgg =
                        Object

                end

            end

        end

    end


    --================================================
    -- RESULT
    --================================================

    if LargestEgg then

        print(
            "=========================================="
        )

        print(
            "[AUTO EGG] VALID EGG FOUND"
        )

        print(
            "[AUTO EGG] Name:",
            LargestEgg.Name
        )

        print(
            "[AUTO EGG] Pivot Scale:",
            LargestScale
        )

        print(
            "=========================================="
        )

    else

        warn(
            "[AUTO EGG] Tidak ada Egg dengan Pivot Scale > "
                .. MIN_SCALE
        )

    end


    return LargestEgg

end


--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()

    local Servers = {}
    local Cursor = ""


    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"


        if Cursor ~= "" then

            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(Cursor)

        end


        local Success, Result =
            pcall(function()

                return game:HttpGet(Url)

            end)


        if not Success then

            warn(
                "[AUTO EGG] Gagal mengambil daftar server:",
                Result
            )

            return Servers

        end


        local DecodeSuccess, Data =
            pcall(function()

                return HttpService:JSONDecode(Result)

            end)


        if not DecodeSuccess then

            warn(
                "[AUTO EGG] Gagal decode server list"
            )

            return Servers

        end


        for _, Server in ipairs(
            Data.data or {}
        ) do

            --================================================
            -- SKIP SERVER SEKARANG
            --================================================

            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(
                    Servers,
                    Server
                )

            end

        end


        Cursor =
            Data.nextPageCursor or ""


    until Cursor == ""
        or #Servers > 0


    return Servers

end


--==================================================
-- SERVER HOP
-- PUBLIC SERVER LAIN
--==================================================

local function ServerHop()

    print(
        "=========================================="
    )

    print(
        "[AUTO EGG] Tidak ada Egg valid."
    )

    print(
        "[AUTO EGG] Mencari public server lain..."
    )

    print(
        "=========================================="
    )


    StopMovement()


    local Servers =
        GetServers()


    if #Servers == 0 then

        warn(
            "[AUTO EGG] Tidak menemukan server lain."
        )

        task.wait(3)

        return

    end


    --================================================
    -- RANDOM SERVER
    --================================================

    local Server =
        Servers[
            math.random(
                1,
                #Servers
            )
        ]


    print(
        "[AUTO EGG] Server ditemukan:"
    )

    print(
        "[AUTO EGG] JobId:",
        Server.id
    )

    print(
        "[AUTO EGG] Players:",
        Server.playing,
        "/",
        Server.maxPlayers
    )


    --================================================
    -- TELEPORT
    --================================================

    local Success, Error =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )

        end)


    if not Success then

        warn(
            "[AUTO EGG] Teleport gagal:",
            Error
        )

        task.wait(3)

    end

end


--==================================================
-- CARRY EGG
--==================================================

local function CarryEgg(Egg)

    if not Egg then
        return false
    end


    local Uid =
        Egg.Name


    print(
        "[AUTO EGG] Request Carry:",
        Uid
    )


    local Args = {

        [1] = {

            ["Uid"] = Uid

        }

    }


    local Success, Result =
        pcall(function()

            return ReplicatedStorage
                :WaitForChild("Network")
                :WaitForChild(
                    "Eggs: RequestAreaEggCarry"
                )
                :InvokeServer(
                    unpack(Args)
                )

        end)


    if Success then

        print(
            "[AUTO EGG] Carry berhasil:",
            Uid
        )

        return true

    else

        warn(
            "[AUTO EGG] Carry gagal:",
            Uid,
            Result
        )

        return false

    end

end


--==================================================
-- MAIN PROCESS
--==================================================

local function Process()

    --================================================
    -- 1. CARI EGG TERBESAR
    --================================================

    local Egg =
        GetLargestScaledEgg()


    --================================================
    -- 2. TIDAK ADA -> PUBLIC SERVER HOP
    --================================================

    if not Egg then

        ServerHop()

        return

    end


    --================================================
    -- 3. GET START AREA
    --================================================

    local StartArea =
        GetStartArea()


    if not StartArea then

        warn(
            "[AUTO EGG] StartArea tidak ditemukan"
        )

        task.wait(2)

        return

    end


    --================================================
    -- 4. JALAN KE START AREA
    --================================================

    print(
        "[AUTO EGG] -> StartArea"
    )


    local StartReached =
        WalkTo(StartArea)


    if not StartReached then

        return

    end


    task.wait(0.2)


    --================================================
    -- 5. CEK EGG MASIH ADA
    --================================================

    if not Egg
        or not Egg.Parent then

        print(
            "[AUTO EGG] Egg sudah tidak tersedia."
        )

        return

    end


    --================================================
    -- 6. CEK SCALE TERBARU
    --================================================

    local CurrentScale =
        GetEggScale(Egg)


    if CurrentScale <= MIN_SCALE then

        print(
            "[AUTO EGG] Scale berubah:",
            CurrentScale
        )

        return

    end


    --================================================
    -- 7. JALAN KE EGG
    --================================================

    print(
        "[AUTO EGG] -> Egg:",
        Egg.Name
    )

    print(
        "[AUTO EGG] Pivot Scale:",
        CurrentScale
    )


    local Reached =
        WalkTo(Egg)


    --================================================
    -- 8. CARRY
    --================================================

    if Reached then

        task.wait(0.2)


        local Carried =
            CarryEgg(Egg)


        if Carried then

            print(
                "[AUTO EGG] Egg berhasil di-carry"
            )

        end


        task.wait(
            CARRY_DELAY
        )

    else

        return

    end


    --================================================
    -- 9. BALIK START AREA
    --================================================

    print(
        "[AUTO EGG] -> StartArea"
    )


    WalkTo(StartArea)


    task.wait(
        LOOP_DELAY
    )

end


--==================================================
-- MAIN LOOP
--==================================================

task.spawn(function()

    print(
        "=========================================="
    )

    print(
        " AUTO EGG CARRY"
    )

    print(
        " STARTING IN:",
        START_DELAY,
        "SECONDS"
    )

    print(
        "=========================================="
    )


    --================================================
    -- INITIAL DELAY
    --================================================

    task.wait(
        START_DELAY
    )


    print(
        "=========================================="
    )

    print(
        " AUTO EGG CARRY STARTED"
    )

    print(
        " FILTER: PIVOT SCALE >",
        MIN_SCALE
    )

    print(
        " WALK SPEED:",
        WALK_SPEED
    )

    print(
        " AUTO STOP"
    )

    print(
        " ONLY 1 LARGEST EGG"
    )

    print(
        " PUBLIC SERVER HOP"
    )

    print(
        "=========================================="
    )


    --================================================
    -- LOOP
    --================================================

    while true do

        local Success, Error =
            pcall(Process)


        if not Success then

            warn(
                "[AUTO EGG] Main Error:",
                Error
            )


            StopMovement()


            task.wait(2)

        end

    end

end)
