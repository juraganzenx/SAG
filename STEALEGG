--==================================================
-- AUTO EGG CARRY + AUTO PLACE
--
-- FLOW:
-- 1. CARI EGG VALID
-- 2. JALAN KE STARTAREA
-- 3. JALAN KE EGG
-- 4. CARRY EGG
-- 5. BALIK KE STARTAREA
-- 6. CEK EGG TOOL DI CHARACTER
-- 7. JIKA ADA -> JALAN KE PETAREA
-- 8. PLACE EGG
-- 9. ULANG
-- 10. JIKA TIDAK ADA EGG VALID -> SERVER HOP
--
-- FILTER:
-- SCALE > 6
-- WORLDPIVOT X > 1950
-- PILIH X TERBESAR / PALING DEPAN
--==================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- MODULES
--==================================================

local EggToolDisplay = require(
    ReplicatedStorage.Library.Client.Eggs.EggToolDisplay
)

local PlotCmds = require(
    ReplicatedStorage.Library.Client.PlotCmds
)

--==================================================
-- REMOTES
--==================================================

local Network = ReplicatedStorage:WaitForChild("Network")

local RequestCarryEggRemote =
    Network:WaitForChild("Eggs: RequestAreaEggCarry")

local RequestPlaceEggRemote =
    Network:WaitForChild("Eggs: RequestPlaceEgg")

--==================================================
-- CONFIG
--==================================================

local START_AREA_NAME = "StartArea"
local EGG_FOLDER_NAME = "AreaEggSlotsClient"

local WALK_SPEED = 800
local REACH_DISTANCE = 11

local START_DELAY = 5
local LOOP_DELAY = 2
local CARRY_DELAY = 0

-- EGG FILTER
local MIN_SCALE = 6
local MIN_WORLD_PIVOT_X = 1950

-- PLACE
local DELAY_BEFORE_PLACE = 0.1
local MIN_PLACE_DISTANCE = 2
local MAX_PLACE_DISTANCE = 6

-- WAKTU MENUNGGU EGG MUNCUL DI CHARACTER
local EGG_TOOL_TIMEOUT = 5

--==================================================
-- CHARACTER
--==================================================

local function GetCharacter()

    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

end

local function GetHumanoid()

    local Character = GetCharacter()

    return Character:FindFirstChildOfClass("Humanoid")

end

local function GetRoot()

    local Character = GetCharacter()

    return Character:FindFirstChild("HumanoidRootPart")

end

--==================================================
-- GET POSITION
--==================================================

local function GetPosition(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then

        local Success, Pivot = pcall(function()
            return Object:GetPivot()
        end)

        if Success and Pivot then
            return Pivot.Position
        end

    end

    return nil

end

--==================================================
-- STOP MOVEMENT
--==================================================

local function StopMovement()

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if Humanoid then

        Humanoid:Move(Vector3.zero, false)

        if Root then
            Humanoid:MoveTo(Root.Position)
        end

    end

    if Root then

        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero

    end

end

--==================================================
-- WALK TO
--==================================================

local function WalkTo(Object)

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid or not Root or not Object then
        return false
    end

    local Position = GetPosition(Object)

    if not Position then
        return false
    end

    Humanoid.WalkSpeed = WALK_SPEED

    print("[AUTO EGG] Walking to:", Object.Name)

    local StartTime = tick()

    while true do

        Humanoid = GetHumanoid()
        Root = GetRoot()

        if not Humanoid or not Root then

            StopMovement()

            return false

        end

        if not Object or not Object.Parent then

            StopMovement()

            return false

        end

        Position = GetPosition(Object)

        if not Position then

            StopMovement()

            return false

        end

        local Distance =
            (Root.Position - Position).Magnitude

        if Distance <= REACH_DISTANCE then

            print(
                "[AUTO EGG] REACHED:",
                Object.Name,
                "| Distance:",
                math.floor(Distance)
            )

            StopMovement()

            RunService.Heartbeat:Wait()

            StopMovement()

            return true

        end

        if tick() - StartTime > 120 then

            warn(
                "[AUTO EGG] Walk timeout:",
                Object.Name
            )

            StopMovement()

            return false

        end

        Humanoid.WalkSpeed = WALK_SPEED

        Humanoid:MoveTo(Position)

        RunService.Heartbeat:Wait()

    end

end

--==================================================
-- GET START AREA
--==================================================

local function GetStartArea()

    return Workspace:FindFirstChild(
        START_AREA_NAME,
        true
    )

end

--==================================================
-- GET EGG SCALE
--==================================================

local function GetEggScale(Egg)

    if not Egg or not Egg:IsA("Model") then
        return 0
    end

    local Success, Scale = pcall(function()
        return Egg:GetScale()
    end)

    if Success and Scale then
        return Scale
    end

    return 0

end

--==================================================
-- GET EGG WORLD PIVOT X
--==================================================

local function GetEggWorldPivotX(Egg)

    if not Egg or not Egg:IsA("Model") then
        return 0
    end

    local Success, Pivot = pcall(function()
        return Egg.WorldPivot
    end)

    if Success and Pivot then
        return Pivot.Position.X
    end

    return 0

end

--==================================================
-- GET FRONTMOST VALID EGG
--
-- SCALE > MIN_SCALE
-- WORLDPIVOT X > MIN_WORLD_PIVOT_X
--
-- PILIH X TERBESAR
--==================================================

local function GetLargestScaledEgg()

    local EggFolder =
        Workspace:FindFirstChild(EGG_FOLDER_NAME)

    if not EggFolder then

        warn(
            "[AUTO EGG] AreaEggSlotsClient tidak ditemukan"
        )

        return nil

    end

    local SelectedEgg = nil
    local HighestPivotX = MIN_WORLD_PIVOT_X
    local SelectedScale = 0

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model") then

            local Scale = GetEggScale(Object)
            local PivotX = GetEggWorldPivotX(Object)

            if Scale > MIN_SCALE
                and PivotX > MIN_WORLD_PIVOT_X then

                if PivotX > HighestPivotX then

                    HighestPivotX = PivotX
                    SelectedScale = Scale
                    SelectedEgg = Object

                end

            end

        end

    end

    if SelectedEgg then

        print(
            "[AUTO EGG] VALID EGG:",
            SelectedEgg.Name,
            "| Scale:",
            SelectedScale,
            "| X:",
            HighestPivotX
        )

    else

        warn("[AUTO EGG] Tidak ada Egg valid")

    end

    return SelectedEgg

end

--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()

    local Servers = {}
    local Cursor = ""

    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then

            Url = Url
                .. "&cursor="
                .. HttpService:UrlEncode(Cursor)

        end

        local Success, Result = pcall(function()
            return game:HttpGet(Url)
        end)

        if not Success then

            warn(
                "[AUTO EGG] Gagal mengambil server:",
                Result
            )

            return Servers

        end

        local DecodeSuccess, Data = pcall(function()
            return HttpService:JSONDecode(Result)
        end)

        if not DecodeSuccess then
            return Servers
        end

        for _, Server in ipairs(Data.data or {}) do

            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(Servers, Server)

            end

        end

        Cursor = Data.nextPageCursor or ""

    until Cursor == ""
        or #Servers > 0

    return Servers

end

--==================================================
-- SERVER HOP
--==================================================

local function ServerHop()

    print("==========================================")
    print("[AUTO EGG] TIDAK ADA EGG VALID")
    print("[AUTO EGG] SERVER HOP...")
    print("==========================================")

    StopMovement()

    local Servers = GetServers()

    if #Servers == 0 then

        warn("[AUTO EGG] Tidak menemukan server lain")

        task.wait(3)

        return

    end

    local Server =
        Servers[math.random(1, #Servers)]

    print(
        "[AUTO EGG] Hopping:",
        Server.id
    )

    local Success, Error = pcall(function()

        TeleportService:TeleportToPlaceInstance(
            game.PlaceId,
            Server.id,
            LocalPlayer
        )

    end)

    if not Success then

        warn(
            "[AUTO EGG] Teleport gagal:",
            Error
        )

        task.wait(3)

    end

end

--==================================================
-- CARRY EGG
--==================================================

local function CarryEgg(Egg)

    if not Egg or not Egg.Parent then
        return false
    end

    local Uid = Egg.Name

    print("[AUTO EGG] Request Carry:", Uid)

    local Success, Result = pcall(function()

        return RequestCarryEggRemote:InvokeServer({
            ["Uid"] = Uid
        })

    end)

    if Success then

        print("[AUTO EGG] Carry request berhasil:", Uid)

        return true

    end

    warn(
        "[AUTO EGG] Carry gagal:",
        Result
    )

    return false

end

--==================================================
-- GET EQUIPPED EGG TOOL
--==================================================

local function GetEquippedEggTool()

    local Character = GetCharacter()

    for _, Object in ipairs(Character:GetChildren()) do

        if Object:IsA("Tool") then

            local Success, IsEgg = pcall(function()
                return EggToolDisplay.IsEggTool(Object)
            end)

            if Success and IsEgg then
                return Object
            end

        end

    end

    return nil

end

--==================================================
-- WAIT FOR EGG TOOL IN CHARACTER
--==================================================

local function WaitForEggTool(Timeout)

    local StartTime = tick()

    while tick() - StartTime < Timeout do

        local EggTool = GetEquippedEggTool()

        if EggTool then

            print(
                "[AUTO EGG] Egg Tool detected:",
                EggTool.Name
            )

            return EggTool

        end

        task.wait(0.1)

    end

    return nil

end

--==================================================
-- GET PET AREA DATA
--==================================================

local function GetPetAreaData()

    local Success, PlotData = pcall(function()
        return PlotCmds.GetPlotData()
    end)

    if not Success or not PlotData then

        warn("[AUTO EGG] PlotData tidak ditemukan")

        return nil, nil

    end

    local PetArea = PlotData.PetArea
    local CenterPoint = PlotData.CenterPoint

    if not PetArea
        or not CenterPoint
        or not PetArea:IsA("BasePart")
        or not CenterPoint:IsA("BasePart") then

        warn(
            "[AUTO EGG] PetArea / CenterPoint tidak valid"
        )

        return nil, nil

    end

    return PetArea, CenterPoint

end

--==================================================
-- CHECK POSITION INSIDE PETAREA
--==================================================

local function IsPositionInsidePart(
    Part,
    WorldPosition
)

    local LocalPosition =
        Part.CFrame:PointToObjectSpace(
            WorldPosition
        )

    local HalfSize = Part.Size / 2

    return
        math.abs(LocalPosition.X) <= HalfSize.X
        and math.abs(LocalPosition.Y) <= HalfSize.Y + 10
        and math.abs(LocalPosition.Z) <= HalfSize.Z

end

--==================================================
-- GET RANDOM PLACE POSITION
--==================================================

local function GetRandomNearbyPosition(PetArea)

    local Root = GetRoot()

    if not Root then
        return nil
    end

    local PlayerPosition = Root.Position

    for _ = 1, 20 do

        local Angle =
            math.random() * math.pi * 2

        local Distance =
            MIN_PLACE_DISTANCE
            + math.random()
            * (
                MAX_PLACE_DISTANCE
                - MIN_PLACE_DISTANCE
            )

        local WorldPosition = Vector3.new(
            PlayerPosition.X
                + math.cos(Angle) * Distance,

            PetArea.Position.Y
                + PetArea.Size.Y / 2,

            PlayerPosition.Z
                + math.sin(Angle) * Distance
        )

        if IsPositionInsidePart(
            PetArea,
            WorldPosition
        ) then

            return WorldPosition

        end

    end

    -- FALLBACK KE TENGAH PETAREA
    return PetArea.Position
        + Vector3.new(
            0,
            PetArea.Size.Y / 2,
            0
        )

end

--==================================================
-- PLACE EGG
--==================================================

local function PlaceEgg(EggTool)

    if not EggTool
        or EggTool.Parent ~= GetCharacter() then

        return false

    end

    local Success, Result = pcall(function()

        if not EggToolDisplay.IsEggTool(EggTool) then
            return false
        end

        local EggUID =
            EggToolDisplay.GetToolUid(EggTool)

        if not EggUID then

            warn("[AUTO EGG] Egg UID tidak ditemukan")

            return false

        end

        local PetArea, CenterPoint =
            GetPetAreaData()

        if not PetArea or not CenterPoint then
            return false
        end

        local WorldPosition =
            GetRandomNearbyPosition(PetArea)

        if not WorldPosition then
            return false
        end

        local LocalCFrame =
            CenterPoint.CFrame:ToObjectSpace(
                CFrame.new(WorldPosition)
            )

        print(
            "[AUTO EGG] Placing:",
            EggUID
        )

        local Response1, Response2 =
            RequestPlaceEggRemote:InvokeServer({
                ["Uid"] = EggUID,
                ["LocalCFrame"] = LocalCFrame
            })

        print(
            "[AUTO EGG] Place Response:",
            Response1,
            Response2
        )

        return true

    end)

    if not Success then

        warn(
            "[AUTO EGG] Place Error:",
            Result
        )

        return false

    end

    return Result == true

end

--==================================================
-- MAIN PROCESS
--==================================================

local function Process()

    --==============================================
    -- 1. CARI EGG VALID
    -- JIKA TIDAK ADA -> HOP
    --==============================================

    local Egg = GetLargestScaledEgg()

    if not Egg then

        ServerHop()

        return

    end

    --==============================================
    -- 2. GET STARTAREA
    --==============================================

    local StartArea = GetStartArea()

    if not StartArea then

        warn("[AUTO EGG] StartArea tidak ditemukan")

        return

    end

    --==============================================
    -- 3. KE STARTAREA
    --==============================================

    print("[AUTO EGG] STEP 1 -> StartArea")

    if not WalkTo(StartArea) then
        return
    end

    task.wait(0.2)

    --==============================================
    -- 4. CEK EGG MASIH VALID
    --==============================================

    if not Egg or not Egg.Parent then
        return
    end

    if GetEggScale(Egg) <= MIN_SCALE
        or GetEggWorldPivotX(Egg) <= MIN_WORLD_PIVOT_X then

        return

    end

    --==============================================
    -- 5. KE EGG
    --==============================================

    print(
        "[AUTO EGG] STEP 2 -> Egg:",
        Egg.Name
    )

    if not WalkTo(Egg) then
        return
    end

    task.wait(0.2)

    --==============================================
    -- 6. CARRY EGG
    --==============================================

    print("[AUTO EGG] STEP 3 -> Carry")

    local Carried = CarryEgg(Egg)

    if not Carried then
        return
    end

    task.wait(CARRY_DELAY)

    --==============================================
    -- 7. BALIK KE STARTAREA
    --==============================================

    print(
        "[AUTO EGG] STEP 4 -> Return StartArea"
    )

    if not WalkTo(StartArea) then
        return
    end

    task.wait(0.2)

    --==============================================
    -- 8. BARU CEK EGG DI CHARACTER
    --
    -- SETELAH SAMPAI STARTAREA EGG BISA BERUBAH
    -- MENJADI MILIK PLAYER DAN DI-EQUIP
    --==============================================

    print(
        "[AUTO EGG] STEP 5 -> Check Egg Tool"
    )

    local EggTool =
        WaitForEggTool(EGG_TOOL_TIMEOUT)

    -- Jika belum ada Egg Tool,
    -- jangan place dan lanjut loop
    if not EggTool then

        warn(
            "[AUTO EGG] Tidak ada Egg Tool di Character"
        )

        task.wait(LOOP_DELAY)

        return

    end

    --==============================================
    -- 9. GET PETAREA
    --==============================================

    local PetArea =
        GetPetAreaData()

    if not PetArea then
        return
    end

    --==============================================
    -- 10. KE PETAREA
    --==============================================

    print(
        "[AUTO EGG] STEP 6 -> PetArea"
    )

    if not WalkTo(PetArea) then
        return
    end

    task.wait(DELAY_BEFORE_PLACE)

    --==============================================
    -- 11. CEK LAGI EGG TOOL
    --==============================================

    EggTool =
        GetEquippedEggTool()

    if not EggTool then

        warn(
            "[AUTO EGG] Egg Tool hilang sebelum Place"
        )

        return

    end

    --==============================================
    -- 12. PLACE EGG
    --==============================================

    print(
        "[AUTO EGG] STEP 7 -> Place Egg"
    )

    local Placed =
        PlaceEgg(EggTool)

    if Placed then

        print(
            "[AUTO EGG] EGG BERHASIL DI-PLACE"
        )

    else

        warn(
            "[AUTO EGG] Place Egg gagal"
        )

    end

    task.wait(LOOP_DELAY)

end

--==================================================
-- START
--==================================================

task.spawn(function()

    print("==========================================")
    print(" AUTO EGG CARRY + AUTO PLACE")
    print(" START DELAY:", START_DELAY)
    print("==========================================")

    task.wait(START_DELAY)

    print("==========================================")
    print(" AUTO EGG STARTED")
    print(" FLOW:")
    print(" EGG -> START -> CARRY -> START")
    print(" -> CHECK TOOL -> PETAREA -> PLACE")
    print(" -> REPEAT / HOP IF NO EGG")
    print("==========================================")

    while true do

        local Success, Error =
            pcall(Process)

        if not Success then

            warn(
                "[AUTO EGG] Main Error:",
                Error
            )

            StopMovement()

            task.wait(2)

        end

    end

end)
