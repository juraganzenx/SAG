--==================================================
-- MOVE TO
--==================================================

local function MoveTo(Object)
    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid or not Root or not Object then
        return false
    end

    local Position = GetPosition(Object)

    if not Position then
        return false
    end

    --==================================================
    -- WALK MODE
    --==================================================

    if MOVEMENT_MODE == "WALK" then
        local StartTime = tick()

        while true do
            if not IsAutoEggEnabled()
                or MOVEMENT_MODE ~= "WALK" then

                StopMovement()
                return false
            end

            Humanoid = GetHumanoid()
            Root = GetRoot()

            if not Humanoid or not Root
                or not Object.Parent then

                StopMovement()
                return false
            end

            Position = GetPosition(Object)

            if not Position then
                return false
            end

            local Distance =
                (Root.Position - Position).Magnitude

            if Distance <= REACH_DISTANCE then
                StopMovement()
                return true
            end

            if tick() - StartTime > 120 then
                StopMovement()
                return false
            end

            Humanoid.WalkSpeed = MOVEMENT_SPEED
            Humanoid:MoveTo(Position)

            RunService.Heartbeat:Wait()
        end
    end

    --==================================================
    -- TWEEN MODE
    --==================================================

    if MOVEMENT_MODE == "TWEEN" then
        local StartTime = tick()

        while true do
            if not IsAutoEggEnabled()
                or MOVEMENT_MODE ~= "TWEEN" then

                StopMovement()
                return false
            end

            Root = GetRoot()

            if not Root
                or not Object.Parent then

                StopMovement()
                return false
            end

            Position = GetPosition(Object)

            if not Position then
                StopMovement()
                return false
            end

            local Distance =
                (Root.Position - Position).Magnitude

            if Distance <= REACH_DISTANCE then
                StopMovement()
                return true
            end

            if MOVEMENT_SPEED <= 0 then
                return false
            end

            local Duration =
                math.max(
                    Distance / MOVEMENT_SPEED,
                    0.05
                )

            if CurrentTween then
                pcall(function()
                    CurrentTween:Cancel()
                end)
            end

            CurrentTween =
                TweenService:Create(
                    Root,
                    TweenInfo.new(
                        Duration,
                        Enum.EasingStyle.Linear
                    ),
                    {
                        CFrame = CFrame.new(
                            Position.X,
                            Root.Position.Y,
                            Position.Z
                        )
                    }
                )

            CurrentTween:Play()

            while CurrentTween
                and CurrentTween.PlaybackState
                    == Enum.PlaybackState.Playing do

                if not IsAutoEggEnabled()
                    or MOVEMENT_MODE ~= "TWEEN" then

                    StopMovement()
                    return false
                end

                if not Object
                    or not Object.Parent then

                    StopMovement()
                    return false
                end

                if tick() - StartTime > 120 then
                    StopMovement()
                    return false
                end

                RunService.Heartbeat:Wait()
            end

            CurrentTween = nil

            Root = GetRoot()
            Position = GetPosition(Object)

            if Root and Position then
                if (Root.Position - Position).Magnitude
                    <= REACH_DISTANCE then

                    return true
                end
            end
        end
    end

    return false
end

