--==================================================
-- WALK / TWEEN TO
--==================================================

local function WalkTo(Object)
    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid
        or not Root
        or not Object then

        return false
    end

    local Position = GetPosition(Object)

    if not Position then
        return false
    end

    local ModeAtStart = MovementMode

    print(
        "[AUTO EGG] Moving to:",
        Object.Name,
        "| Mode:",
        ModeAtStart
    )

    --==================================================
    -- TWEEN MODE
    --==================================================

    if ModeAtStart == "TWEEN" then
        local Distance =
            (Root.Position - Position).Magnitude

        if Distance <= REACH_DISTANCE then
            StopMovement()
            return true
        end

        local Duration =
            Distance / WALK_SPEED

        ActiveTween =
            TweenService:Create(
                Root,
                TweenInfo.new(
                    Duration,
                    Enum.EasingStyle.Linear
                ),
                {
                    CFrame = CFrame.new(Position)
                }
            )

        local CurrentTween = ActiveTween

        CurrentTween:Play()

        local StartTime = tick()

        while CurrentTween.PlaybackState
            == Enum.PlaybackState.Playing do

            if not IsAutoEggEnabled() then
                CurrentTween:Cancel()

                if ActiveTween == CurrentTween then
                    ActiveTween = nil
                end

                StopMovement()
                return false
            end

            if MovementMode ~= ModeAtStart then
                CurrentTween:Cancel()

                if ActiveTween == CurrentTween then
                    ActiveTween = nil
                end

                StopMovement()
                return false
            end

            if not Object
                or not Object.Parent then

                CurrentTween:Cancel()

                if ActiveTween == CurrentTween then
                    ActiveTween = nil
                end

                StopMovement()
                return false
            end

            if tick() - StartTime > 120 then
                CurrentTween:Cancel()

                if ActiveTween == CurrentTween then
                    ActiveTween = nil
                end

                StopMovement()
                return false
            end

            RunService.Heartbeat:Wait()
        end

        if ActiveTween == CurrentTween then
            ActiveTween = nil
        end

        if not IsAutoEggEnabled()
            or MovementMode ~= ModeAtStart then

            StopMovement()
            return false
        end

        local NewRoot = GetRoot()
        local FinalPosition = GetPosition(Object)

        if not NewRoot
            or not FinalPosition then

            return false
        end

        local FinalDistance =
            (NewRoot.Position - FinalPosition).Magnitude

        if FinalDistance <= REACH_DISTANCE then
            print(
                "[AUTO EGG] REACHED:",
                Object.Name
            )

            StopMovement()
            return true
        end

        return false
    end

    --==================================================
    -- WALK MODE
    --==================================================

    Humanoid.WalkSpeed = WALK_SPEED

    local StartTime = tick()

    while true do
        if not IsAutoEggEnabled() then
            StopMovement()
            return false
        end

        if MovementMode ~= ModeAtStart then
            StopMovement()
            return false
        end

        Humanoid = GetHumanoid()
        Root = GetRoot()

        if not Humanoid
            or not Root then

            StopMovement()
            return false
        end

        if not Object
            or not Object.Parent then

            StopMovement()
            return false
        end

        Position = GetPosition(Object)

        if not Position then
            StopMovement()
            return false
        end

        local Distance =
            (Root.Position - Position).Magnitude

        if Distance <= REACH_DISTANCE then
            print(
                "[AUTO EGG] REACHED:",
                Object.Name,
                "| Distance:",
                math.floor(Distance)
            )

            StopMovement()
            return true
        end

        if tick() - StartTime > 120 then
            warn(
                "[AUTO EGG] Movement timeout:",
                Object.Name
            )

            StopMovement()
            return false
        end

        Humanoid.WalkSpeed = WALK_SPEED
        Humanoid:MoveTo(Position)

        RunService.Heartbeat:Wait()
    end
end

