--==================================================
-- AUTO EGG CARRY + AUTO PLACEa
--
-- FLOW:
-- 1. CARI EGG VALID
-- 2. PRIORITAS EGG LIMITED (CLASSNAME = HIGHLIGHT)
-- 3. JIKA TIDAK ADA HIGHLIGHT:
--    -> SCALE TERBESAR
--    -> JIKA SCALE SAMA -> X TERBESAR
-- 4. JALAN KE STARTAREA
-- 5. JALAN KE EGG
-- 6. CARRY EGG
-- 7. BALIK KE STARTAREA
-- 8. CEK EGG TOOL DI CHARACTER
-- 9. JALAN KE PETAREA
-- 10. PLACE RANDOM DI SELURUH PETAREA
-- 11. TUNGGU EGG TOOL HILANG
-- 12. JIKA MASIH ADA -> RETRY PLACE
-- 13. JIKA BERHASIL -> CARI EGG BERIKUTNYA
-- 14. JIKA TIDAK ADA EGG VALID -> SERVER HOP
--
-- PRIORITAS EGG:
--
-- PRIORITAS 1:
-- ADA DESCENDANT DENGAN CLASSNAME "Highlight"
-- -> TIDAK PEDULI SCALE
-- -> TIDAK PEDULI WORLDPIVOT X
--
-- PRIORITAS 2:
-- SCALE > 8
-- WORLDPIVOT X > 1950
-- SCALE TERBESAR
-- JIKA SCALE SAMA -> X TERBESAR
--==================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- MODULES
--==================================================

local EggToolDisplay = require(
    ReplicatedStorage.Library.Client.Eggs.EggToolDisplay
)

local PlotCmds = require(
    ReplicatedStorage.Library.Client.PlotCmds
)

--==================================================
-- REMOTES
--==================================================

local Network =
    ReplicatedStorage:WaitForChild("Network")

local RequestCarryEggRemote =
    Network:WaitForChild("Eggs: RequestAreaEggCarry")

local RequestPlaceEggRemote =
    Network:WaitForChild("Eggs: RequestPlaceEgg")

--==================================================
-- CONFIG
--==================================================

local START_AREA_NAME = "StartArea"
local EGG_FOLDER_NAME = "AreaEggSlotsClient"

local WALK_SPEED = 800
local REACH_DISTANCE = 11

local START_DELAY = 5
local LOOP_DELAY = 2
local CARRY_DELAY = 0

--==================================================
-- NORMAL EGG FILTER
--==================================================

local MIN_SCALE = 8
local MIN_WORLD_PIVOT_X = 1950

--==================================================
-- PLACE CONFIG
--==================================================

local DELAY_BEFORE_PLACE = 0.1

local MAX_PLACE_ATTEMPTS = 50

local PLACE_VERIFY_TIMEOUT = 3

local PLACE_RETRY_DELAY = 0.15

--==================================================
-- EGG TOOL CONFIG
--==================================================

local EGG_TOOL_TIMEOUT = 5

--==================================================
-- CHARACTER
--==================================================

local function GetCharacter()

    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

end

local function GetHumanoid()

    local Character = GetCharacter()

    return Character:FindFirstChildOfClass("Humanoid")

end

local function GetRoot()

    local Character = GetCharacter()

    return Character:FindFirstChild("HumanoidRootPart")

end

--==================================================
-- GET POSITION
--==================================================

local function GetPosition(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then

        return Object.Position

    end

    if Object:IsA("Model") then

        local Success, Pivot =
            pcall(function()

                return Object:GetPivot()

            end)

        if Success and Pivot then

            return Pivot.Position

        end

    end

    return nil

end

--==================================================
-- STOP MOVEMENT
--==================================================

local function StopMovement()

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if Humanoid then

        Humanoid:Move(
            Vector3.zero,
            false
        )

        if Root then

            Humanoid:MoveTo(
                Root.Position
            )

        end

    end

    if Root then

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end

end

--==================================================
-- WALK TO
--==================================================

local function WalkTo(Object)

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid
        or not Root
        or not Object then

        return false

    end

    local Position =
        GetPosition(Object)

    if not Position then

        return false

    end

    Humanoid.WalkSpeed =
        WALK_SPEED

    print(
        "[AUTO EGG] Walking to:",
        Object.Name
    )

    local StartTime =
        tick()

    while true do

        Humanoid = GetHumanoid()
        Root = GetRoot()

        if not Humanoid
            or not Root then

            StopMovement()

            return false

        end

        if not Object
            or not Object.Parent then

            StopMovement()

            return false

        end

        Position =
            GetPosition(Object)

        if not Position then

            StopMovement()

            return false

        end

        local Distance =
            (
                Root.Position
                - Position
            ).Magnitude

        if Distance <= REACH_DISTANCE then

            print(
                "[AUTO EGG] REACHED:",
                Object.Name,
                "| Distance:",
                math.floor(Distance)
            )

            StopMovement()

            RunService.Heartbeat:Wait()

            StopMovement()

            return true

        end

        if tick() - StartTime > 120 then

            warn(
                "[AUTO EGG] Walk timeout:",
                Object.Name
            )

            StopMovement()

            return false

        end

        Humanoid.WalkSpeed =
            WALK_SPEED

        Humanoid:MoveTo(
            Position
        )

        RunService.Heartbeat:Wait()

    end

end

--==================================================
-- GET START AREA
--==================================================

local function GetStartArea()

    return Workspace:FindFirstChild(
        START_AREA_NAME,
        true
    )

end

--==================================================
-- GET EGG SCALE
--==================================================

local function GetEggScale(Egg)

    if not Egg
        or not Egg:IsA("Model") then

        return 0

    end

    local Success, Scale =
        pcall(function()

            return Egg:GetScale()

        end)

    if Success and Scale then

        return Scale

    end

    return 0

end

--==================================================
-- GET EGG WORLD PIVOT X
--==================================================

local function GetEggWorldPivotX(Egg)

    if not Egg
        or not Egg:IsA("Model") then

        return 0

    end

    local Success, Pivot =
        pcall(function()

            return Egg.WorldPivot

        end)

    if Success and Pivot then

        return Pivot.Position.X

    end

    return 0

end

--==================================================
-- CHECK LIMITED EGG
--
-- MENCARI CLASSNAME "Highlight"
--
-- TIDAK PEDULI NAMA OBJECT
--==================================================

local function HasHighlight(Egg)

    if not Egg then
        return false
    end

    for _, Object in ipairs(
        Egg:GetDescendants()
    ) do

        if Object:IsA("Highlight") then

            return true

        end

    end

    return false

end

--==================================================
-- GET BEST EGG
--
-- PRIORITAS 1:
-- LIMITED EGG
-- CLASSNAME = Highlight
--
-- PRIORITAS 2:
-- NORMAL EGG
-- SCALE TERBESAR
-- JIKA SCALE SAMA -> X TERBESAR
--==================================================

local function GetLargestScaledEgg()

    local EggFolder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )

    if not EggFolder then

        warn(
            "[AUTO EGG] AreaEggSlotsClient tidak ditemukan"
        )

        return nil

    end

    --==================================================
    -- PASS 1
    -- CARI LIMITED EGG
    --==================================================

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model")
            and HasHighlight(Object) then

            print(
                "=========================================="
            )

            print(
                "[AUTO EGG] LIMITED EGG TERDETEKSI!"
            )

            print(
                "[AUTO EGG] EGG:",
                Object.Name
            )

            print(
                "[AUTO EGG] CLASSNAME HIGHLIGHT: TRUE"
            )

            print(
                "[AUTO EGG] Scale:",
                GetEggScale(Object)
            )

            print(
                "[AUTO EGG] WorldPivot X:",
                GetEggWorldPivotX(Object)
            )

            print(
                "=========================================="
            )

            -- Langsung pilih.
            --
            -- Scale tidak diperhatikan.
            -- WorldPivot X tidak diperhatikan.

            return Object

        end

    end

    --==================================================
    -- PASS 2
    -- NORMAL EGG
    --==================================================

    local SelectedEgg = nil

    local LargestScale =
        MIN_SCALE

    local HighestPivotX =
        MIN_WORLD_PIVOT_X

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model") then

            local Scale =
                GetEggScale(Object)

            local PivotX =
                GetEggWorldPivotX(Object)

            --==================================================
            -- NORMAL FILTER
            --==================================================

            if Scale > MIN_SCALE
                and PivotX > MIN_WORLD_PIVOT_X then

                --==================================================
                -- PRIORITAS:
                -- SCALE TERBESAR
                -- SCALE SAMA -> X TERBESAR
                --==================================================

                if Scale > LargestScale
                    or (
                        Scale == LargestScale
                        and PivotX > HighestPivotX
                    ) then

                    LargestScale =
                        Scale

                    HighestPivotX =
                        PivotX

                    SelectedEgg =
                        Object

                end

            end

        end

    end

    --==================================================
    -- RESULT
    --==================================================

    if SelectedEgg then

        print(
            "=========================================="
        )

        print(
            "[AUTO EGG] SELECTED NORMAL EGG:",
            SelectedEgg.Name
        )

        print(
            "[AUTO EGG] SCALE:",
            LargestScale
        )

        print(
            "[AUTO EGG] WORLD PIVOT X:",
            HighestPivotX
        )

        print(
            "[AUTO EGG] LIMITED: FALSE"
        )

        print(
            "=========================================="
        )

    else

        warn(
            "[AUTO EGG] Tidak ada Egg valid"
        )

    end

    return SelectedEgg

end

--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()

    local Servers = {}
    local Cursor = ""

    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then

            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    Cursor
                )

        end

        local Success, Result =
            pcall(function()

                return game:HttpGet(
                    Url
                )

            end)

        if not Success then

            warn(
                "[AUTO EGG] Gagal mengambil server:",
                Result
            )

            return Servers

        end

        local DecodeSuccess, Data =
            pcall(function()

                return HttpService:JSONDecode(
                    Result
                )

            end)

        if not DecodeSuccess then

            return Servers

        end

        for _, Server in ipairs(
            Data.data or {}
        ) do

            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(
                    Servers,
                    Server
                )

            end

        end

        Cursor =
            Data.nextPageCursor
            or ""

    until Cursor == ""
        or #Servers > 0

    return Servers

end

--==================================================
-- SERVER HOP
--==================================================

local function ServerHop()

    print(
        "=========================================="
    )

    print(
        "[AUTO EGG] TIDAK ADA EGG VALID"
    )

    print(
        "[AUTO EGG] SERVER HOP..."
    )

    print(
        "=========================================="
    )

    StopMovement()

    local Servers =
        GetServers()

    if #Servers == 0 then

        warn(
            "[AUTO EGG] Tidak menemukan server lain"
        )

        task.wait(3)

        return

    end

    local Server =
        Servers[
            math.random(
                1,
                #Servers
            )
        ]

    print(
        "[AUTO EGG] Hopping:",
        Server.id
    )

    local Success, Error =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )

        end)

    if not Success then

        warn(
            "[AUTO EGG] Teleport gagal:",
            Error
        )

        task.wait(3)

    end

end

--==================================================
-- CARRY EGG
--==================================================

local function CarryEgg(Egg)

    if not Egg
        or not Egg.Parent then

        return false

    end

    local Uid =
        Egg.Name

    print(
        "[AUTO EGG] Request Carry:",
        Uid
    )

    local Success, Result =
        pcall(function()

            return RequestCarryEggRemote:InvokeServer({
                ["Uid"] = Uid
            })

        end)

    if Success then

        print(
            "[AUTO EGG] Carry request berhasil:",
            Uid
        )

        return true

    end

    warn(
        "[AUTO EGG] Carry gagal:",
        Result
    )

    return false

end

--==================================================
-- GET EQUIPPED EGG TOOL
--==================================================

local function GetEquippedEggTool()

    local Character =
        GetCharacter()

    for _, Object in ipairs(
        Character:GetChildren()
    ) do

        if Object:IsA("Tool") then

            local Success, IsEgg =
                pcall(function()

                    return EggToolDisplay.IsEggTool(
                        Object
                    )

                end)

            if Success and IsEgg then

                return Object

            end

        end

    end

    return nil

end

--==================================================
-- WAIT FOR EGG TOOL
--==================================================

local function WaitForEggTool(
    Timeout
)

    local StartTime =
        tick()

    while tick() - StartTime < Timeout do

        local EggTool =
            GetEquippedEggTool()

        if EggTool then

            print(
                "[AUTO EGG] Egg Tool detected:",
                EggTool.Name
            )

            return EggTool

        end

        task.wait(0.1)

    end

    return nil

end

--==================================================
-- GET PET AREA DATA
--==================================================

local function GetPetAreaData()

    local Success, PlotData =
        pcall(function()

            return PlotCmds.GetPlotData()

        end)

    if not Success
        or not PlotData then

        warn(
            "[AUTO EGG] PlotData tidak ditemukan"
        )

        return nil, nil

    end

    local PetArea =
        PlotData.PetArea

    local CenterPoint =
        PlotData.CenterPoint

    if not PetArea
        or not CenterPoint
        or not PetArea:IsA("BasePart")
        or not CenterPoint:IsA("BasePart") then

        warn(
            "[AUTO EGG] PetArea / CenterPoint tidak valid"
        )

        return nil, nil

    end

    return PetArea, CenterPoint

end

--==================================================
-- CHECK POSITION INSIDE PETAREA
--==================================================

local function IsPositionInsidePart(
    Part,
    WorldPosition
)

    local LocalPosition =
        Part.CFrame:PointToObjectSpace(
            WorldPosition
        )

    local HalfSize =
        Part.Size / 2

    return
        math.abs(LocalPosition.X)
            <= HalfSize.X
        and
        math.abs(LocalPosition.Y)
            <= HalfSize.Y + 10
        and
        math.abs(LocalPosition.Z)
            <= HalfSize.Z

end

--==================================================
-- RANDOM POSITION SELURUH PETAREA
--==================================================

local function GetRandomPetAreaPosition(
    PetArea
)

    if not PetArea then

        return nil

    end

    local HalfSize =
        PetArea.Size / 2

    --==================================================
    -- RANDOM X
    --==================================================

    local RandomX =
        math.random()
        * (
            HalfSize.X * 2
        )
        - HalfSize.X

    --==================================================
    -- RANDOM Z
    --==================================================

    local RandomZ =
        math.random()
        * (
            HalfSize.Z * 2
        )
        - HalfSize.Z

    --==================================================
    -- PADDING
    --==================================================

    local Padding =
        0.5

    if HalfSize.X > Padding * 2 then

        RandomX =
            math.clamp(
                RandomX,
                -HalfSize.X + Padding,
                HalfSize.X - Padding
            )

    end

    if HalfSize.Z > Padding * 2 then

        RandomZ =
            math.clamp(
                RandomZ,
                -HalfSize.Z + Padding,
                HalfSize.Z - Padding
            )

    end

    --==================================================
    -- POSISI DI PERMUKAAN ATAS
    --==================================================

    local LocalPosition =
        Vector3.new(
            RandomX,
            HalfSize.Y,
            RandomZ
        )

    local WorldPosition =
        PetArea.CFrame:PointToWorldSpace(
            LocalPosition
        )

    if IsPositionInsidePart(
        PetArea,
        WorldPosition
    ) then

        return WorldPosition

    end

    return nil

end

--==================================================
-- WAIT EGG TOOL HILANG
--==================================================

local function WaitUntilEggToolGone(
    Timeout
)

    local StartTime =
        tick()

    while tick() - StartTime < Timeout do

        local EggTool =
            GetEquippedEggTool()

        if not EggTool then

            print(
                "[AUTO EGG] Egg Tool SUDAH HILANG"
            )

            return true

        end

        task.wait(0.1)

    end

    return false

end

--==================================================
-- PLACE EGG
--==================================================

local function PlaceEgg(
    EggTool
)

    if not EggTool
        or EggTool.Parent ~= GetCharacter() then

        return false

    end

    local PetArea, CenterPoint =
        GetPetAreaData()

    if not PetArea
        or not CenterPoint then

        return false

    end

    local Success, IsEgg =
        pcall(function()

            return EggToolDisplay.IsEggTool(
                EggTool
            )

        end)

    if not Success
        or not IsEgg then

        return false

    end

    local EggUID =
        EggToolDisplay.GetToolUid(
            EggTool
        )

    if not EggUID then

        warn(
            "[AUTO EGG] Egg UID tidak ditemukan"
        )

        return false

    end

    print(
        "=========================================="
    )

    print(
        "[AUTO EGG] PLACE START:",
        EggUID
    )

    print(
        "=========================================="
    )

    --==================================================
    -- RETRY
    --==================================================

    for Attempt = 1, MAX_PLACE_ATTEMPTS do

        --==================================================
        -- CEK TOOL
        --==================================================

        local CurrentTool =
            GetEquippedEggTool()

        if not CurrentTool then

            print(
                "[AUTO EGG] Egg sudah tidak ada di Character"
            )

            return true

        end

        --==================================================
        -- RANDOM POSITION
        --==================================================

        local WorldPosition =
            GetRandomPetAreaPosition(
                PetArea
            )

        if not WorldPosition then

            task.wait(
                PLACE_RETRY_DELAY
            )

            continue

        end

        --==================================================
        -- WORLD -> CENTERPOINT LOCAL CFRAME
        --==================================================

        local LocalCFrame =
            CenterPoint.CFrame:ToObjectSpace(
                CFrame.new(
                    WorldPosition
                )
            )

        print(
            "[AUTO EGG] Place Attempt:",
            Attempt
        )

        print(
            "[AUTO EGG] Position:",
            WorldPosition
        )

        --==================================================
        -- REQUEST PLACE
        --==================================================

        local InvokeSuccess
        local Response1
        local Response2

        InvokeSuccess,
        Response1,
        Response2 =
            pcall(function()

                return RequestPlaceEggRemote:InvokeServer({
                    ["Uid"] = EggUID,
                    ["LocalCFrame"] =
                        LocalCFrame
                })

            end)

        if InvokeSuccess then

            print(
                "[AUTO EGG] Place Response:",
                Response1,
                Response2
            )

        else

            warn(
                "[AUTO EGG] Place Invoke Error:",
                Response1
            )

        end

        --==================================================
        -- VERIFY
        --==================================================

        local Placed =
            WaitUntilEggToolGone(
                PLACE_VERIFY_TIMEOUT
            )

        if Placed then

            print(
                "=========================================="
            )

            print(
                "[AUTO EGG] EGG BERHASIL DI-PLACE"
            )

            print(
                "[AUTO EGG] Attempt:",
                Attempt
            )

            print(
                "=========================================="
            )

            return true

        end

        --==================================================
        -- RETRY
        --==================================================

        warn(
            "[AUTO EGG] Place belum berhasil."
        )

        warn(
            "[AUTO EGG] Egg masih di Character."
        )

        warn(
            "[AUTO EGG] Coba posisi random lain..."
        )

        task.wait(
            PLACE_RETRY_DELAY
        )

    end

    warn(
        "[AUTO EGG] MAX PLACE ATTEMPTS tercapai."
    )

    return false

end

--==================================================
-- MAIN PROCESS
--==================================================

local function Process()

    --==================================================
    -- 1. CARI EGG
    --==================================================

    local Egg =
        GetLargestScaledEgg()

    if not Egg then

        ServerHop()

        return

    end

    --==================================================
    -- 2. GET START AREA
    --==================================================

    local StartArea =
        GetStartArea()

    if not StartArea then

        warn(
            "[AUTO EGG] StartArea tidak ditemukan"
        )

        return

    end

    --==================================================
    -- 3. KE STARTAREA
    --==================================================

    print(
        "[AUTO EGG] STEP 1 -> StartArea"
    )

    if not WalkTo(StartArea) then

        return

    end

    task.wait(0.2)

    --==================================================
    -- 4. CEK EGG
    --==================================================

    if not Egg
        or not Egg.Parent then

        warn(
            "[AUTO EGG] Egg sudah hilang"
        )

        return

    end

    --==================================================
    -- 5. VALIDASI EGG
    --==================================================

    local IsLimitedEgg =
        HasHighlight(Egg)

    local CurrentScale =
        GetEggScale(Egg)

    local CurrentPivotX =
        GetEggWorldPivotX(Egg)

    if not IsLimitedEgg then

        if CurrentScale <= MIN_SCALE
            or CurrentPivotX <= MIN_WORLD_PIVOT_X then

            warn(
                "[AUTO EGG] Egg tidak lagi valid"
            )

            return

        end

    else

        print(
            "[AUTO EGG] Egg Limited terdeteksi."
        )

        print(
            "[AUTO EGG] Scale dan X tidak difilter."
        )

    end

    --==================================================
    -- 6. KE EGG
    --==================================================

    print(
        "[AUTO EGG] STEP 2 -> Egg:",
        Egg.Name
    )

    print(
        "[AUTO EGG] Scale:",
        CurrentScale
    )

    print(
        "[AUTO EGG] X:",
        CurrentPivotX
    )

    print(
        "[AUTO EGG] Limited:",
        IsLimitedEgg
    )

    if not WalkTo(Egg) then

        return

    end

    task.wait(0.2)

    --==================================================
    -- 7. CARRY
    --==================================================

    print(
        "[AUTO EGG] STEP 3 -> Carry"
    )

    local Carried =
        CarryEgg(Egg)

    if not Carried then

        return

    end

    task.wait(
        CARRY_DELAY
    )

    --==================================================
    -- 8. BALIK STARTAREA
    --==================================================

    print(
        "[AUTO EGG] STEP 4 -> Return StartArea"
    )

    if not WalkTo(StartArea) then

        return

    end

    task.wait(0.2)

    --==================================================
    -- 9. CEK EGG TOOL
    --==================================================

    print(
        "[AUTO EGG] STEP 5 -> Check Egg Tool"
    )

    local EggTool =
        WaitForEggTool(
            EGG_TOOL_TIMEOUT
        )

    if not EggTool then

        warn(
            "[AUTO EGG] Tidak ada Egg Tool di Character"
        )

        task.wait(
            LOOP_DELAY
        )

        return

    end

    --==================================================
    -- 10. GET PETAREA
    --==================================================

    local PetArea =
        GetPetAreaData()

    if not PetArea then

        return

    end

    --==================================================
    -- 11. KE PETAREA
    --==================================================

    print(
        "[AUTO EGG] STEP 6 -> PetArea"
    )

    if not WalkTo(PetArea) then

        return

    end

    task.wait(
        DELAY_BEFORE_PLACE
    )

    --==================================================
    -- 12. CEK TOOL LAGI
    --==================================================

    EggTool =
        GetEquippedEggTool()

    if not EggTool then

        warn(
            "[AUTO EGG] Egg Tool hilang sebelum Place"
        )

        return

    end

    --==================================================
    -- 13. PLACE
    --==================================================

    print(
        "[AUTO EGG] STEP 7 -> Place Egg"
    )

    local Placed =
        PlaceEgg(
            EggTool
        )

    --==================================================
    -- 14. BERHASIL
    --==================================================

    if Placed then

        print(
            "[AUTO EGG] PLACE CONFIRMED"
        )

        task.wait(
            LOOP_DELAY
        )

        return

    end

    --==================================================
