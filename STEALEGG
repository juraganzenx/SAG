--==================================================
-- MOVE TO
-- WALK / TWEEN
--==================================================

local function MoveTo(Object)

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid
        or not Root
        or not Object then

        return false
    end

    local Position =
        GetPosition(Object)

    if not Position then
        return false
    end

    --==================================================
    -- WALK
    --==================================================

    if MOVEMENT_MODE == "WALK" then

        Humanoid.WalkSpeed =
            MOVEMENT_SPEED

        print(
            "[AUTO EGG] WALK ->",
            Object.Name,
            "| SPEED:",
            MOVEMENT_SPEED
        )

        local StartTime =
            tick()

        while true do

            if not IsAutoEggEnabled()
                or MOVEMENT_MODE ~= "WALK" then

                StopMovement()
                return false
            end

            Humanoid = GetHumanoid()
            Root = GetRoot()

            if not Humanoid
                or not Root then

                StopMovement()
                return false
            end

            if not Object
                or not Object.Parent then

                StopMovement()
                return false
            end

            Position =
                GetPosition(Object)

            if not Position then

                StopMovement()
                return false
            end

            local Distance =
                (
                    Root.Position
                    - Position
                ).Magnitude

            if Distance <= REACH_DISTANCE then

                StopMovement()

                return true
            end

            if tick() - StartTime > 120 then

                warn(
                    "[AUTO EGG] WALK TIMEOUT:",
                    Object.Name
                )

                StopMovement()

                return false
            end

            Humanoid.WalkSpeed =
                MOVEMENT_SPEED

            Humanoid:MoveTo(
                Position
            )

            RunService.Heartbeat:Wait()
        end
    end

    --==================================================
    -- TWEEN
    --==================================================

    if MOVEMENT_MODE == "TWEEN" then

        print(
            "[AUTO EGG] TWEEN ->",
            Object.Name,
            "| SPEED:",
            MOVEMENT_SPEED
        )

        local StartTime =
            tick()

        while true do

            if not IsAutoEggEnabled()
                or MOVEMENT_MODE ~= "TWEEN" then

                StopMovement()

                return false
            end

            Root = GetRoot()

            if not Root then

                StopMovement()

                return false
            end

            if not Object
                or not Object.Parent then

                StopMovement()

                return false
            end

            Position =
                GetPosition(Object)

            if not Position then

                StopMovement()

                return false
            end

            local Distance =
                (
                    Root.Position
                    - Position
                ).Magnitude

            if Distance <= REACH_DISTANCE then

                StopMovement()

                return true
            end

            if MOVEMENT_SPEED <= 0 then
                return false
            end

            -- Hitung durasi berdasarkan distance/speed
            local Duration =
                Distance / MOVEMENT_SPEED

            if Duration < 0.05 then
                Duration = 0.05
            end

            if CurrentTween then

                pcall(function()
                    CurrentTween:Cancel()
                end)

                CurrentTween = nil
            end

            -- Target tetap mempertahankan tinggi karakter
            local TargetCFrame =
                CFrame.new(
                    Position.X,
                    Root.Position.Y,
                    Position.Z
                )

            CurrentTween =
                TweenService:Create(
                    Root,
                    TweenInfo.new(
                        Duration,
                        Enum.EasingStyle.Linear
                    ),
                    {
                        CFrame = TargetCFrame
                    }
                )

            CurrentTween:Play()

            -- Tunggu tween sambil cek ON/OFF
            while CurrentTween
                and CurrentTween.PlaybackState
                    == Enum.PlaybackState.Playing do

                if not IsAutoEggEnabled()
                    or MOVEMENT_MODE ~= "TWEEN" then

                    StopMovement()

                    return false
                end

                if not Object
                    or not Object.Parent then

                    StopMovement()

                    return false
                end

                Root = GetRoot()

                if not Root then

                    StopMovement()

                    return false
                end

                Position =
                    GetPosition(Object)

                if Position then

                    local CurrentDistance =
                        (
                            Root.Position
                            - Position
                        ).Magnitude

                    if CurrentDistance <= REACH_DISTANCE then

                        StopMovement()

                        return true
                    end
                end

                if tick() - StartTime > 120 then

                    warn(
                        "[AUTO EGG] TWEEN TIMEOUT:",
                        Object.Name
                    )

                    StopMovement()

                    return false
                end

                RunService.Heartbeat:Wait()
            end

            CurrentTween = nil

            Root = GetRoot()

            if Root and Position then

                local FinalDistance =
                    (
                        Root.Position
                        - Position
                    ).Magnitude

                if FinalDistance <= REACH_DISTANCE then

                    StopMovement()

                    return true
                end
            end

            RunService.Heartbeat:Wait()
        end
    end

    return false
end

