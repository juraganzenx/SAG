--==================================================
-- WAIT FOR EGG TOOL
--==================================================

local function WaitForEggTool(Timeout)

    local StartTime =
        tick()

    while tick() - StartTime < Timeout do

        if not IsAutoEggEnabled() then
            return nil
        end

        local EggTool =
            GetEquippedEggTool()

        if EggTool then

            print(
                "[AUTO EGG] EGG TOOL:",
                EggTool.Name
            )

            return EggTool
        end

        task.wait(0.1)
    end

    return nil
end

