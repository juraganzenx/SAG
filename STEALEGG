--==================================================
-- RANDOM POSITION SELURUH PETAREA
--==================================================

local function GetRandomPetAreaPosition(PetArea)
    if not PetArea then
        return nil
    end

    local HalfSize = PetArea.Size / 2
    local Padding = 0.5

    local RandomX =
        math.random(
            math.floor((-HalfSize.X + Padding) * 100),
            math.floor((HalfSize.X - Padding) * 100)
        ) / 100

    local RandomZ =
        math.random(
            math.floor((-HalfSize.Z + Padding) * 100),
            math.floor((HalfSize.Z - Padding) * 100)
        ) / 100

    local LocalPosition =
        Vector3.new(
            RandomX,
            HalfSize.Y,
            RandomZ
        )

    return PetArea.CFrame:PointToWorldSpace(
        LocalPosition
    )
end

