-- GET PET AREA DATA
--==================================================

local function GetPetAreaData()

    local Success, PlotData =
        pcall(function()

            return PlotCmds.GetPlotData()
        end)

    if not Success
        or not PlotData then

        return nil, nil
    end

    local PetArea =
        PlotData.PetArea

    local CenterPoint =
        PlotData.CenterPoint

    if not PetArea
        or not CenterPoint
        or not PetArea:IsA("BasePart")
        or not CenterPoint:IsA("BasePart") then

        return nil, nil
    end

    return PetArea, CenterPoint
end

--==================================================
-- CHECK POSITION INSIDE PETAREA
--==================================================

local function IsPositionInsidePart(
    Part,
    WorldPosition
)

    local LocalPosition =
        Part.CFrame:PointToObjectSpace(
            WorldPosition
        )

    local HalfSize =
        Part.Size / 2

    return
        math.abs(LocalPosition.X)
            <= HalfSize.X
        and
        math.abs(LocalPosition.Y)
            <= HalfSize.Y + 10
        and
        math.abs(LocalPosition.Z)
            <= HalfSize.Z
end

--==================================================
-- RANDOM POSITION PETAREA
--==================================================

local function GetRandomPetAreaPosition(PetArea)

    if not PetArea then
        return nil
    end

    local HalfSize =
        PetArea.Size / 2

    local RandomX =
        math.random()
        * (HalfSize.X * 2)
        - HalfSize.X

    local RandomZ =
        math.random()
        * (HalfSize.Z * 2)
        - HalfSize.Z

    local Padding = 0.5

    if HalfSize.X > Padding * 2 then

        RandomX =
            math.clamp(
                RandomX,
                -HalfSize.X + Padding,
                HalfSize.X - Padding
            )
    end

    if HalfSize.Z > Padding * 2 then

        RandomZ =
            math.clamp(
                RandomZ,
                -HalfSize.Z + Padding,
                HalfSize.Z - Padding
            )
    end

    local LocalPosition =
        Vector3.new(
            RandomX,
            HalfSize.Y,
            RandomZ
        )

    local WorldPosition =
        PetArea.CFrame:PointToWorldSpace(
            LocalPosition
        )

    if IsPositionInsidePart(
        PetArea,
        WorldPosition
    ) then

        return WorldPosition
    end

    return nil
end

--==================================================
-- WAIT EGG TOOL GONE
--==================================================

local function WaitUntilEggToolGone(Timeout)

    local StartTime =
        tick()

    while tick() - StartTime < Timeout do

        if not IsAutoEggEnabled() then
            return false
        end

        local EggTool =
            GetEquippedEggTool()

        if not EggTool then

            print(
                "[AUTO EGG] EGG TOOL HILANG"
            )

            return true
        end

        task.wait(0.1)
    end

    return false
end

--==================================================
-- PLACE EGG
--==================================================

local function PlaceEgg(EggTool)

    if not IsAutoEggEnabled() then
        return false
    end

    if not EggTool
        or EggTool.Parent ~= GetCharacter() then

        return false
    end

    local PetArea, CenterPoint =
        GetPetAreaData()

    if not PetArea
        or not CenterPoint then

        return false
    end

    local Success, IsEgg =
        pcall(function()

            return EggToolDisplay.IsEggTool(
                EggTool
            )
        end)

    if not Success
        or not IsEgg then

        return false
    end

    local EggUID =
        EggToolDisplay.GetToolUid(
            EggTool
        )

    if not EggUID then
        return false
    end

    for Attempt = 1, MAX_PLACE_ATTEMPTS do

        if not IsAutoEggEnabled() then
            return false
        end

        local CurrentTool =
            GetEquippedEggTool()

        if not CurrentTool then
            return true
        end

        local WorldPosition =
            GetRandomPetAreaPosition(
                PetArea
            )

        if not WorldPosition then

            task.wait(
                PLACE_RETRY_DELAY
            )

            continue
        end

        local LocalCFrame =
            CenterPoint.CFrame:ToObjectSpace(
                CFrame.new(
                    WorldPosition
                )
            )

        print(
            "[AUTO EGG] PLACE ATTEMPT:",
            Attempt
        )

        pcall(function()

            return RequestPlaceEggRemote:InvokeServer({
                ["Uid"] = EggUID,

                ["LocalCFrame"] =
                    LocalCFrame
            })
        end)

        local Placed =
            WaitUntilEggToolGone(
                PLACE_VERIFY_TIMEOUT
            )

        if Placed then

            print(
                "[AUTO EGG] PLACE SUCCESS"
            )

            return true
        end

        task.wait(
            PLACE_RETRY_DELAY
        )
    end

    return false
end

--==================================================
-- MAIN PROCESS
--==================================================

local function Process()

    if not IsAutoEggEnabled() then
        return
    end

    -- 1. FIND EGG
    local Egg =
        GetLargestScaledEgg()

    if not Egg then

        ServerHop()

        return
    end

    -- 2. GET START AREA
    local StartArea =
        GetStartArea()

    if not StartArea then

        warn(
            "[AUTO EGG] StartArea tidak ditemukan"
        )

        return
    end

    -- 3. GO START AREA
    print(
        "[AUTO EGG] STEP 1 -> START AREA"
    )

    if not MoveTo(StartArea) then
        return
    end

    task.wait(0.2)

    -- 4. CHECK EGG
    if not Egg
        or not Egg.Parent then

        return
    end

    -- 5. VALIDATE EGG
    local IsLimitedEgg =
        HasHighlight(Egg)

    local CurrentScale =
        GetEggScale(Egg)

    local CurrentPivotX =
        GetEggWorldPivotX(Egg)

    if not IsLimitedEgg then

        if CurrentScale <= MIN_SCALE
            or CurrentPivotX <= MIN_WORLD_PIVOT_X then

            return
        end
    end

    -- 6. GO EGG
    print(
        "[AUTO EGG] STEP 2 -> EGG:",
        Egg.Name
    )

    if not MoveTo(Egg) then
        return
    end

    task.wait(0.2)

    -- 7. CARRY
    print(
        "[AUTO EGG] STEP 3 -> CARRY"
    )

    local Carried =
        CarryEgg(Egg)

    if not Carried then
        return
    end

    task.wait(CARRY_DELAY)

    -- 8. RETURN START AREA
    print(
        "[AUTO EGG] STEP 4 -> START AREA"
    )

    if not MoveTo(StartArea) then
        return
    end

    task.wait(0.2)

    -- 9. WAIT EGG TOOL
    local EggTool =
        WaitForEggTool(
            EGG_TOOL_TIMEOUT
        )

    if not EggTool then

        task.wait(LOOP_DELAY)

        return
    end

    -- 10. GET PET AREA
    local PetArea =
        GetPetAreaData()

    if not PetArea then
        return
    end

    -- 11. GO PET AREA
    print(
        "[AUTO EGG] STEP 5 -> PET AREA"
    )

    if not MoveTo(PetArea) then
        return
    end

    task.wait(
        DELAY_BEFORE_PLACE
    )

    -- 12. CHECK TOOL
    EggTool =
        GetEquippedEggTool()

    if not EggTool then
        return
    end

    -- 13. PLACE
    print(
        "[AUTO EGG] STEP 6 -> PLACE"
    )

    local Placed =
        PlaceEgg(EggTool)

    if Placed then

        task.wait(
            LOOP_DELAY
        )

        return
    end

    -- RETRY PLACE
    while IsAutoEggEnabled() do

        local CurrentTool =
            GetEquippedEggTool()

        if not CurrentTool then
            break
        end

        local RetrySuccess =
            PlaceEgg(CurrentTool)

        if RetrySuccess then
            break
        end

        task.wait(
            PLACE_RETRY_DELAY
        )
    end

    if IsAutoEggEnabled() then

        task.wait(
            LOOP_DELAY
        )
    end
end

