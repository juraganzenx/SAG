--==================================================
-- PLACE EGG
--==================================================

local function PlaceEgg(EggTool)
    if not IsAutoEggEnabled()
        or not EggTool
        or EggTool.Parent ~= GetCharacter() then

        return false
    end

    local PetArea, CenterPoint =
        GetPetAreaData()

    if not PetArea
        or not CenterPoint then

        return false
    end

    local Success, IsEgg = pcall(function()
        return EggToolDisplay.IsEggTool(EggTool)
    end)

    if not Success
        or not IsEgg then

        return false
    end

    local EggUID =
        EggToolDisplay.GetToolUid(EggTool)

    if not EggUID then
        warn(
            "[AUTO EGG] Egg UID tidak ditemukan"
        )

        return false
    end

    print(
        "[AUTO EGG] PLACE START:",
        EggUID
    )

    for Attempt = 1, MAX_PLACE_ATTEMPTS do
        if not IsAutoEggEnabled() then
            return false
        end

        local CurrentTool =
            GetEquippedEggTool()

        if not CurrentTool then
            return true
        end

        local WorldPosition =
            GetRandomPetAreaPosition(PetArea)

        if not WorldPosition then
            task.wait(PLACE_RETRY_DELAY)
            continue
        end

        local LocalCFrame =
            CenterPoint.CFrame:ToObjectSpace(
                CFrame.new(WorldPosition)
            )

        print(
            "[AUTO EGG] Place Attempt:",
            Attempt
        )

        local InvokeSuccess, Response =
            pcall(function()
                return RequestPlaceEggRemote:InvokeServer({
                    ["Uid"] = EggUID,
                    ["LocalCFrame"] = LocalCFrame
                })
            end)

        if InvokeSuccess then
            print(
                "[AUTO EGG] Place Response:",
                Response
            )
        else
            warn(
                "[AUTO EGG] Place Error:",
                Response
            )
        end

        if WaitUntilEggToolGone(PLACE_VERIFY_TIMEOUT) then
            print(
                "[AUTO EGG] EGG BERHASIL DI-PLACE"
            )

            return true
        end

        task.wait(PLACE_RETRY_DELAY)
    end

    warn(
        "[AUTO EGG] MAX PLACE ATTEMPTS tercapai"
    )

    return false
end

--==================================================
-- MAIN PROCESS
--==================================================

local function Process()
    if not IsAutoEggEnabled() then
        return
    end

    -- 1. CARI EGG
    local Egg = GetLargestScaledEgg()

    if not IsAutoEggEnabled() then
        return
    end

    if not Egg then
        ServerHop()
        return
    end

    -- 2. START AREA
    local StartArea = GetStartArea()

    if not StartArea then
        warn(
            "[AUTO EGG] StartArea tidak ditemukan"
        )

        return
    end

    -- 3. KE START AREA
    print("[AUTO EGG] STEP 1 -> StartArea")

    if not WalkTo(StartArea) then
        return
    end

    task.wait(0.2)

    if not IsAutoEggEnabled()
        or not Egg
        or not Egg.Parent then

        return
    end

    -- 4. VALIDASI EGG
    local IsLimitedEgg = HasHighlight(Egg)
    local CurrentScale = GetEggScale(Egg)
    local CurrentPivotX = GetEggWorldPivotX(Egg)

    if not IsLimitedEgg then
        if CurrentScale <= MIN_SCALE
            or CurrentPivotX <= MIN_WORLD_PIVOT_X then

            warn(
                "[AUTO EGG] Egg tidak lagi valid"
            )

            return
        end
    end

    -- 5. KE EGG
    print(
        "[AUTO EGG] STEP 2 -> Egg:",
        Egg.Name
    )

    if not WalkTo(Egg) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(0.3)

    -- 6. CARRY
    print("[AUTO EGG] STEP 3 -> Carry")

    if not CarryEgg(Egg) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(CARRY_DELAY)

    -- 7. BALIK START AREA
    print(
        "[AUTO EGG] STEP 4 -> Return StartArea"
    )

    if not WalkTo(StartArea) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(0.2)

    -- 8. CEK EGG TOOL
    local EggTool =
        GetEquippedEggTool()

    if not EggTool then
        EggTool =
            WaitForEggTool(EGG_TOOL_TIMEOUT)
    end

    if not EggTool then
        warn(
            "[AUTO EGG] Egg Tool tidak ditemukan"
        )

        return
    end

    -- 9. GET PET AREA
    local PetArea =
        GetPetAreaData()

    if not PetArea then
        return
    end

    -- 10. KE PET AREA
    print(
        "[AUTO EGG] STEP 5 -> PetArea"
    )

    if not WalkTo(PetArea) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(DELAY_BEFORE_PLACE)

    -- 11. PLACE
    EggTool =
        GetEquippedEggTool()

    if not EggTool then
        return
    end

    print(
        "[AUTO EGG] STEP 6 -> Place Egg"
    )

    local Placed =
        PlaceEgg(EggTool)

    if not IsAutoEggEnabled() then
        return
    end

    -- RETRY PLACE JIKA TOOL MASIH ADA
    while not Placed
        and IsAutoEggEnabled() do

        local CurrentTool =
            GetEquippedEggTool()

        if not CurrentTool then
            Placed = true
            break
        end

        print(
            "[AUTO EGG] Retry Place..."
        )

        Placed =
            PlaceEgg(CurrentTool)

        if not Placed then
            task.wait(PLACE_RETRY_DELAY)
        end
    end

    if Placed then
        print(
            "[AUTO EGG] PLACE CONFIRMED"
        )
    end

    if IsAutoEggEnabled() then
        task.wait(LOOP_DELAY)
    end
end

