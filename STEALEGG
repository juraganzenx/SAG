--==================================================
-- GET BEST EGG
-- PRIORITY:
-- 1. HIGHLIGHT
-- 2. SCALE TERBESAR
-- 3. X TERBESAR JIKA SCALE SAMA
--==================================================

local function GetLargestScaledEgg()
    local EggFolder =
        Workspace:FindFirstChild(EGG_FOLDER_NAME)

    if not EggFolder then
        warn(
            "[AUTO EGG] AreaEggSlotsClient tidak ditemukan"
        )

        return nil
    end

    -- PASS 1: LIMITED EGG

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model")
            and HasHighlight(Object) then

            print(
                "[AUTO EGG] LIMITED EGG:",
                Object.Name
            )

            return Object
        end
    end

    -- PASS 2: NORMAL EGG

    local SelectedEgg = nil
    local LargestScale = MIN_SCALE
    local HighestPivotX = MIN_WORLD_PIVOT_X

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model") then
            local Scale = GetEggScale(Object)
            local PivotX = GetEggWorldPivotX(Object)

            if Scale > MIN_SCALE
                and PivotX > MIN_WORLD_PIVOT_X then

                if Scale > LargestScale
                    or (
                        Scale == LargestScale
                        and PivotX > HighestPivotX
                    ) then

                    LargestScale = Scale
                    HighestPivotX = PivotX
                    SelectedEgg = Object
                end
            end
        end
    end

    if SelectedEgg then
        print(
            "[AUTO EGG] SELECTED:",
            SelectedEgg.Name
        )

        print(
            "[AUTO EGG] SCALE:",
            LargestScale
        )

        print(
            "[AUTO EGG] X:",
            HighestPivotX
        )
    else
        warn(
            "[AUTO EGG] Tidak ada Egg valid"
        )
    end

    return SelectedEgg
end

--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()
    local Servers = {}
    local Cursor = ""

    repeat
        if not IsAutoEggEnabled() then
            return Servers
        end

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then
            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(Cursor)
        end

        local Success, Result = pcall(function()
            return game:HttpGet(Url)
        end)

        if not Success then
            warn(
                "[AUTO EGG] Gagal mengambil server:",
                Result
            )

            return Servers
        end

        local DecodeSuccess, Data = pcall(function()
            return HttpService:JSONDecode(Result)
        end)

        if not DecodeSuccess then
            return Servers
        end

        for _, Server in ipairs(Data.data or {}) do
            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(Servers, Server)
            end
        end

        Cursor = Data.nextPageCursor or ""

    until Cursor == ""
        or #Servers > 0

    return Servers
end

--==================================================
-- SERVER HOP
--==================================================

local function ServerHop()
    if not IsAutoEggEnabled() then
        return
    end

    print("[AUTO EGG] TIDAK ADA EGG VALID")
    print("[AUTO EGG] SERVER HOP...")

    StopMovement()

    local Servers = GetServers()

    if not IsAutoEggEnabled() then
        return
    end

    if #Servers == 0 then
        warn(
            "[AUTO EGG] Tidak menemukan server lain"
        )

        task.wait(3)
        return
    end

    local Server =
        Servers[math.random(1, #Servers)]

    print(
        "[AUTO EGG] Hopping:",
        Server.id
    )

    pcall(function()
        if IsAutoEggEnabled() then
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )
        end
    end)
end

