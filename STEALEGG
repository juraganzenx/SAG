--==================================================
-- EGG FUNCTIONS
--==================================================

local function GetEggScale(Egg)
    if not Egg or not Egg:IsA("Model") then
        return 0
    end

    local Success, Scale = pcall(function()
        return Egg:GetScale()
    end)

    return Success and Scale or 0
end

local function GetEggWorldPivotX(Egg)
    if not Egg or not Egg:IsA("Model") then
        return 0
    end

    local Success, Pivot = pcall(function()
        return Egg.WorldPivot
    end)

    if Success and Pivot then
        return Pivot.Position.X
    end

    return 0
end

local function HasHighlight(Egg)
    if not Egg then
        return false
    end

    for _, Object in ipairs(Egg:GetDescendants()) do
        if Object:IsA("Highlight") then
            return true
        end
    end

    return false
end

local function GetLargestScaledEgg()
    local EggFolder =
        Workspace:FindFirstChild(EGG_FOLDER_NAME)

    if not EggFolder then
        return nil
    end

    -- PRIORITAS LIMITED
    for _, Object in ipairs(EggFolder:GetDescendants()) do
        if Object:IsA("Model")
            and HasHighlight(Object) then

            return Object
        end
    end

    local SelectedEgg = nil
    local LargestScale = MIN_SCALE
    local HighestPivotX = MIN_WORLD_PIVOT_X

    for _, Object in ipairs(EggFolder:GetDescendants()) do
        if Object:IsA("Model") then
            local Scale = GetEggScale(Object)
            local PivotX = GetEggWorldPivotX(Object)

            if Scale > MIN_SCALE
                and PivotX > MIN_WORLD_PIVOT_X then

                if Scale > LargestScale
                    or (
                        Scale == LargestScale
                        and PivotX > HighestPivotX
                    ) then

                    LargestScale = Scale
                    HighestPivotX = PivotX
                    SelectedEgg = Object
                end
            end
        end
    end

    return SelectedEgg
end

--==================================================
-- SERVER HOP
--==================================================

local function GetServers()
    local Servers = {}
    local Cursor = ""

    repeat
        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then
            Url = Url
                .. "&cursor="
                .. HttpService:UrlEncode(Cursor)
        end

        local Success, Result = pcall(function()
            return game:HttpGet(Url)
        end)

        if not Success then
            return Servers
        end

        local DecodeSuccess, Data = pcall(function()
            return HttpService:JSONDecode(Result)
        end)

        if not DecodeSuccess then
            return Servers
        end

        for _, Server in ipairs(Data.data or {}) do
            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(Servers, Server)
            end
        end

        Cursor = Data.nextPageCursor or ""

    until Cursor == ""
        or #Servers > 0

    return Servers
end

local function ServerHop()
    if not IsAutoEggEnabled() then
        return
    end

    StopMovement()

    local Servers = GetServers()

    if #Servers == 0 then
        task.wait(3)
        return
    end

    local Server =
        Servers[math.random(1, #Servers)]

    pcall(function()
        if IsAutoEggEnabled() then
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )
        end
    end)
end

