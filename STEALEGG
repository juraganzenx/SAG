--==================================================
-- GET EGG SCALE
--==================================================

local function GetEggScale(Egg)

    if not Egg
        or not Egg:IsA("Model") then

        return 0
    end

    local Success, Scale =
        pcall(function()
            return Egg:GetScale()
        end)

    if Success and Scale then
        return Scale
    end

    return 0
end

--==================================================
-- GET EGG WORLD PIVOT X
--==================================================

local function GetEggWorldPivotX(Egg)

    if not Egg
        or not Egg:IsA("Model") then

        return 0
    end

    local Success, Pivot =
        pcall(function()
            return Egg.WorldPivot
        end)

    if Success and Pivot then
        return Pivot.Position.X
    end

    return 0
end

--==================================================
-- CHECK LIMITED EGG
-- CLASSNAME = Highlight
--==================================================

local function HasHighlight(Egg)

    if not Egg then
        return false
    end

    for _, Object in ipairs(
        Egg:GetDescendants()
    ) do

        if Object:IsA("Highlight") then
            return true
        end
    end

    return false
end

--==================================================
-- GET BEST EGG
--==================================================

local function GetLargestScaledEgg()

    local EggFolder =
        Workspace:FindFirstChild(
            EGG_FOLDER_NAME
        )

    if not EggFolder then

        warn(
            "[AUTO EGG] AreaEggSlotsClient tidak ditemukan"
        )

        return nil
    end

    -- PASS 1
    -- PRIORITAS LIMITED EGG

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model")
            and HasHighlight(Object) then

            print(
                "[AUTO EGG] LIMITED EGG:",
                Object.Name
            )

            return Object
        end
    end

    -- PASS 2
    -- NORMAL EGG

    local SelectedEgg = nil
    local LargestScale = MIN_SCALE
    local HighestPivotX = MIN_WORLD_PIVOT_X

    for _, Object in ipairs(
        EggFolder:GetDescendants()
    ) do

        if Object:IsA("Model") then

            local Scale =
                GetEggScale(Object)

            local PivotX =
                GetEggWorldPivotX(Object)

            if Scale > MIN_SCALE
                and PivotX > MIN_WORLD_PIVOT_X then

                if Scale > LargestScale
                    or (
                        Scale == LargestScale
                        and PivotX > HighestPivotX
                    ) then

                    LargestScale = Scale
                    HighestPivotX = PivotX
                    SelectedEgg = Object
                end
            end
        end
    end

    if SelectedEgg then

        print(
            "[AUTO EGG] SELECTED:",
            SelectedEgg.Name
        )

        print(
            "[AUTO EGG] SCALE:",
            LargestScale
        )

        print(
            "[AUTO EGG] X:",
            HighestPivotX
        )

    else

        warn(
            "[AUTO EGG] Tidak ada Egg valid"
        )
    end

    return SelectedEgg
end

--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()

    local Servers = {}
    local Cursor = ""

    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then

            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    Cursor
                )
        end

        local Success, Result =
            pcall(function()
                return game:HttpGet(Url)
            end)

        if not Success then
            return Servers
        end

        local DecodeSuccess, Data =
            pcall(function()
                return HttpService:JSONDecode(
                    Result
                )
            end)

        if not DecodeSuccess then
            return Servers
        end

        for _, Server in ipairs(
            Data.data or {}
        ) do

            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(
                    Servers,
                    Server
                )
            end
        end

        Cursor =
            Data.nextPageCursor
            or ""

    until Cursor == ""
        or #Servers > 0

    return Servers
end

--==================================================
-- SERVER HOP
--==================================================

local function ServerHop()

    if not IsAutoEggEnabled() then
        return
    end

    StopMovement()

    print("[AUTO EGG] SERVER HOP...")

    local Servers =
        GetServers()

    if not IsAutoEggEnabled() then
        return
    end

    if #Servers == 0 then

        warn(
            "[AUTO EGG] Server lain tidak ditemukan"
        )

        task.wait(3)

        return
    end

    local Server =
        Servers[
            math.random(
                1,
                #Servers
            )
        ]

    pcall(function()

        if IsAutoEggEnabled() then

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )
        end
    end)
end

