--==================================================
-- EGG TOOL
--==================================================

local function GetEquippedEggTool()
    local Character = GetCharacter()

    for _, Object in ipairs(Character:GetChildren()) do
        if Object:IsA("Tool") then
            local Success, IsEgg = pcall(function()
                return EggToolDisplay.IsEggTool(Object)
            end)

            if Success and IsEgg then
                return Object
            end
        end
    end

    return nil
end

local function WaitForEggTool(Timeout)
    local StartTime = tick()

    while tick() - StartTime < Timeout do
        if not IsAutoEggEnabled() then
            return nil
        end

        local EggTool = GetEquippedEggTool()

        if EggTool then
            return EggTool
        end

        task.wait(0.1)
    end

    return nil
end

local function WaitUntilEggToolGone(Timeout)
    local StartTime = tick()

    while tick() - StartTime < Timeout do
        if not IsAutoEggEnabled() then
            return false
        end

        if not GetEquippedEggTool() then
            return true
        end

        task.wait(0.1)
    end

    return false
end

--==================================================
-- PET AREA
--==================================================

local function GetPetAreaData()
    local Success, PlotData = pcall(function()
        return PlotCmds.GetPlotData()
    end)

    if not Success or not PlotData then
        return nil, nil
    end

    local PetArea = PlotData.PetArea
    local CenterPoint = PlotData.CenterPoint

    if not PetArea
        or not CenterPoint
        or not PetArea:IsA("BasePart")
        or not CenterPoint:IsA("BasePart") then

        return nil, nil
    end

    return PetArea, CenterPoint
end

local function GetRandomPetAreaPosition(PetArea)
    local HalfSize = PetArea.Size / 2
    local Padding = 0.5

    local RandomX = math.random(
        math.floor((-HalfSize.X + Padding) * 100),
        math.floor((HalfSize.X - Padding) * 100)
    ) / 100

    local RandomZ = math.random(
        math.floor((-HalfSize.Z + Padding) * 100),
        math.floor((HalfSize.Z - Padding) * 100)
    ) / 100

    return PetArea.CFrame:PointToWorldSpace(
        Vector3.new(
            RandomX,
            HalfSize.Y,
            RandomZ
        )
    )
end

--==================================================
-- PLACE EGG
--==================================================

local function PlaceEgg(EggTool)
    if not IsAutoEggEnabled()
        or not EggTool
        or EggTool.Parent ~= GetCharacter() then

        return false
    end

    local PetArea, CenterPoint = GetPetAreaData()

    if not PetArea or not CenterPoint then
        return false
    end

    local Success, IsEgg = pcall(function()
        return EggToolDisplay.IsEggTool(EggTool)
    end)

    if not Success or not IsEgg then
        return false
    end

    local EggUID =
        EggToolDisplay.GetToolUid(EggTool)

    if not EggUID then
        return false
    end

    for Attempt = 1, MAX_PLACE_ATTEMPTS do
        if not IsAutoEggEnabled() then
            return false
        end

        if not GetEquippedEggTool() then
            return true
        end

        local WorldPosition =
            GetRandomPetAreaPosition(PetArea)

        local LocalCFrame =
            CenterPoint.CFrame:ToObjectSpace(
                CFrame.new(WorldPosition)
            )

        pcall(function()
            RequestPlaceEggRemote:InvokeServer({
                ["Uid"] = EggUID,
                ["LocalCFrame"] = LocalCFrame
            })
        end)

        if WaitUntilEggToolGone(PLACE_VERIFY_TIMEOUT) then
            return true
        end

        task.wait(PLACE_RETRY_DELAY)
    end

    return false
end

--==================================================
-- MAIN PROCESS
--==================================================

local function Process()
    if not IsAutoEggEnabled() then
        return
    end

    -- FIND EGG
    local Egg = GetLargestScaledEgg()

    if not Egg then
        ServerHop()
        return
    end

    -- START AREA
    local StartArea = GetStartArea()

    if not StartArea then
        return
    end

    -- GO START AREA
    if not MoveTo(StartArea) then
        return
    end

    task.wait(0.2)

    -- VALIDATE EGG
    if not Egg or not Egg.Parent then
        return
    end

    local IsLimitedEgg = HasHighlight(Egg)

    if not IsLimitedEgg then
        local CurrentScale = GetEggScale(Egg)
        local CurrentPivotX = GetEggWorldPivotX(Egg)

        if CurrentScale <= MIN_SCALE
            or CurrentPivotX <= MIN_WORLD_PIVOT_X then

            return
        end
    end

    -- GO EGG
    if not MoveTo(Egg) then
        return
    end

    task.wait(0.2)

    -- CARRY
    if not CarryEgg(Egg) then
        return
    end

    task.wait(CARRY_DELAY)

    -- RETURN START AREA
    if not MoveTo(StartArea) then
        return
    end

    task.wait(0.2)

    -- WAIT TOOL
    local EggTool = WaitForEggTool(EGG_TOOL_TIMEOUT)

    if not EggTool then
        task.wait(LOOP_DELAY)
        return
    end

    -- GET PET AREA
    local PetArea = GetPetAreaData()

    if not PetArea then
        return
    end

    -- GO PET AREA
    if not MoveTo(PetArea) then
        return
    end

    task.wait(DELAY_BEFORE_PLACE)

    EggTool = GetEquippedEggTool()

    if not EggTool then
        return
    end

    -- PLACE
    local Placed = PlaceEgg(EggTool)

    if Placed then
        task.wait(LOOP_DELAY)
        return
    end

    -- RETRY PLACE
    while IsAutoEggEnabled() do
        local CurrentTool = GetEquippedEggTool()

        if not CurrentTool then
            break
        end

        if PlaceEgg(CurrentTool) then
            break
        end

        task.wait(PLACE_RETRY_DELAY)
    end

    if IsAutoEggEnabled() then
        task.wait(LOOP_DELAY)
    end
end

