--==================================================
-- PLACE EGG
--==================================================

local function PlaceEgg(EggTool)

    if not IsAutoEggEnabled()
        or not EggTool
        or EggTool.Parent ~= GetCharacter() then

        return false
    end

    local PetArea, CenterPoint =
        GetPetAreaData()

    if not PetArea
        or not CenterPoint then

        return false
    end

    local Success, IsEgg =
        pcall(function()

            return EggToolDisplay.IsEggTool(
                EggTool
            )
        end)

    if not Success
        or not IsEgg then

        return false
    end

    local EggUID =
        EggToolDisplay.GetToolUid(EggTool)

    if not EggUID then

        warn(
            "[AUTO EGG] Egg UID tidak ditemukan"
        )

        return false
    end

    print(
        "[AUTO EGG] PLACE START:",
        EggUID
    )

    for Attempt = 1, MAX_PLACE_ATTEMPTS do

        if not IsAutoEggEnabled() then
            return false
        end

        local CurrentTool =
            GetEquippedEggTool()

        if not CurrentTool then
            return true
        end

        local WorldPosition =
            GetRandomPetAreaPosition(PetArea)

        if not WorldPosition then

            task.wait(PLACE_RETRY_DELAY)
            continue
        end

        local LocalCFrame =
            CenterPoint.CFrame:ToObjectSpace(
                CFrame.new(WorldPosition)
            )

        print(
            "[AUTO EGG] Place Attempt:",
            Attempt
        )

        local InvokeSuccess, Response1, Response2 =
            pcall(function()

                return RequestPlaceEggRemote:InvokeServer({
                    ["Uid"] = EggUID,
                    ["LocalCFrame"] = LocalCFrame
                })
            end)

        if InvokeSuccess then

            print(
                "[AUTO EGG] Place Response:",
                Response1,
                Response2
            )

        else

            warn(
                "[AUTO EGG] Place Error:",
                Response1
            )
        end

        local Placed =
            WaitUntilEggToolGone(
                PLACE_VERIFY_TIMEOUT
            )

        if Placed then

            print(
                "[AUTO EGG] EGG BERHASIL DI-PLACE"
            )

            print(
                "[AUTO EGG] Attempt:",
                Attempt
            )

            return true
        end

        if not IsAutoEggEnabled() then
            return false
        end

        task.wait(PLACE_RETRY_DELAY)
    end

    warn(
        "[AUTO EGG] MAX PLACE ATTEMPTS tercapai."
    )

    return false
end

--==================================================
-- MAIN PROCESS
--==================================================

local function Process()

    if not IsAutoEggEnabled() then
        return
    end

    -- 1. CARI EGG

    local Egg =
        GetLargestScaledEgg()

    if not IsAutoEggEnabled() then
        return
    end

    if not Egg then

        ServerHop()
        return
    end

    -- 2. GET START AREA

    local StartArea =
        GetStartArea()

    if not StartArea then

        warn(
            "[AUTO EGG] StartArea tidak ditemukan"
        )

        return
    end

    -- 3. KE STARTAREA

    print(
        "[AUTO EGG] STEP 1 -> StartArea"
    )

    if not WalkTo(StartArea) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(0.2)

    -- 4. CEK EGG

    if not Egg
        or not Egg.Parent then

        warn(
            "[AUTO EGG] Egg sudah hilang"
        )

        return
    end

    -- 5. VALIDASI EGG

    local IsLimitedEgg =
        HasHighlight(Egg)

    local CurrentScale =
        GetEggScale(Egg)

    local CurrentPivotX =
        GetEggWorldPivotX(Egg)

    if not IsLimitedEgg then

        if CurrentScale <= MIN_SCALE
            or CurrentPivotX <= MIN_WORLD_PIVOT_X then

            warn(
                "[AUTO EGG] Egg tidak lagi valid"
            )

            return
        end

    else

        print(
            "[AUTO EGG] Egg Limited terdeteksi."
        )
    end

    -- 6. KE EGG

    print(
        "[AUTO EGG] STEP 2 -> Egg:",
        Egg.Name
    )

    if not WalkTo(Egg) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(0.2)

    -- 7. CARRY

    print(
        "[AUTO EGG] STEP 3 -> Carry"
    )

    local Carried =
        CarryEgg(Egg)

    if not Carried then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(CARRY_DELAY)

    -- 8. BALIK STARTAREA

    print(
        "[AUTO EGG] STEP 4 -> Return StartArea"
    )

    if not WalkTo(StartArea) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(0.2)

    -- 9. CEK EGG TOOL

    print(
        "[AUTO EGG] STEP 5 -> Check Egg Tool"
    )

    local EggTool =
        WaitForEggTool(EGG_TOOL_TIMEOUT)

    if not EggTool then

        if IsAutoEggEnabled() then
            warn(
                "[AUTO EGG] Tidak ada Egg Tool di Character"
            )

            task.wait(LOOP_DELAY)
        end

        return
    end

    -- 10. GET PETAREA

    local PetArea =
        GetPetAreaData()

    if not PetArea then
        return
    end

    -- 11. KE PETAREA

    print(
        "[AUTO EGG] STEP 6 -> PetArea"
    )

    if not WalkTo(PetArea) then
        return
    end

    if not IsAutoEggEnabled() then
        return
    end

    task.wait(DELAY_BEFORE_PLACE)

    -- 12. CEK TOOL LAGI

    EggTool =
        GetEquippedEggTool()

    if not EggTool then

        warn(
            "[AUTO EGG] Egg Tool hilang sebelum Place"
        )

        return
    end

    -- 13. PLACE

    print(
        "[AUTO EGG] STEP 7 -> Place Egg"
    )

    local Placed =
        PlaceEgg(EggTool)

    if not IsAutoEggEnabled() then
        return
    end

    if Placed then

        print(
            "[AUTO EGG] PLACE CONFIRMED"
        )

        task.wait(LOOP_DELAY)

        return
    end

    -- RETRY PLACE

    while IsAutoEggEnabled() do

        local CurrentTool =
            GetEquippedEggTool()

        if not CurrentTool then

            print(
                "[AUTO EGG] Egg akhirnya berhasil di-place."
            )

            break
        end

        print(
            "[AUTO EGG] Retry Place..."
        )

        local RetrySuccess =
            PlaceEgg(CurrentTool)

        if RetrySuccess then
            break
        end

        task.wait(PLACE_RETRY_DELAY)
    end

    if IsAutoEggEnabled() then
        task.wait(LOOP_DELAY)
    end
end

