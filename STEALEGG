--==================================================
-- CONFIG SAVE
--==================================================

local CONFIG_FILE = "AutoEggMovementConfig.json"

local DefaultConfig = {
    MovementMode = "WALK",
    MovementSpeed = 800
}

local MOVEMENT_MODE = DefaultConfig.MovementMode
local MOVEMENT_SPEED = DefaultConfig.MovementSpeed

local function LoadConfig()
    if not isfile or not readfile then
        warn("[AUTO EGG] Executor tidak mendukung Load Config")
        return
    end

    if isfile(CONFIG_FILE) then
        local Success, Data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)

        if Success and type(Data) == "table" then
            if Data.MovementMode == "WALK"
                or Data.MovementMode == "TWEEN" then

                MOVEMENT_MODE = Data.MovementMode
            end

            local SavedSpeed =
                tonumber(Data.MovementSpeed)

            if SavedSpeed and SavedSpeed > 0 then
                MOVEMENT_SPEED = SavedSpeed
            end

            print(
                "[AUTO EGG] CONFIG LOADED | MODE:",
                MOVEMENT_MODE,
                "| SPEED:",
                MOVEMENT_SPEED
            )
        end
    else
        print("[AUTO EGG] Config belum ada, memakai default")
    end
end

local function SaveConfig()
    if not writefile then
        warn("[AUTO EGG] Executor tidak mendukung Save Config")
        return
    end

    local Success, Error = pcall(function()
        writefile(
            CONFIG_FILE,
            HttpService:JSONEncode({
                MovementMode = MOVEMENT_MODE,
                MovementSpeed = MOVEMENT_SPEED
            })
        )
    end)

    if Success then
        print(
            "[AUTO EGG] CONFIG SAVED | MODE:",
            MOVEMENT_MODE,
            "| SPEED:",
            MOVEMENT_SPEED
        )
    else
        warn("[AUTO EGG] Gagal save config:", Error)
    end
end

LoadConfig()

