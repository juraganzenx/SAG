    print("AUTO EGG - WALK / TWEEN + AUTO SAVE")
    print("MODE:", MOVEMENT_MODE)
    print("SPEED:", MOVEMENT_SPEED)
    print("CONFIG FILE:", CONFIG_FILE)
    print("==========================================")

    task.wait(START_DELAY)

    while true do
        if not IsAutoEggEnabled() then
            StopMovement()
            task.wait(0.2)
            continue
        end

        local Success, Error = pcall(Process)

        if not Success then
            warn("[AUTO EGG] MAIN ERROR:", Error)
            StopMovement()
            task.wait(2)
        end
    end
end)
