--==================================================
-- CHECK POSITION INSIDE PETAREA
--==================================================

local function IsPositionInsidePart(
    Part,
    WorldPosition
)

    local LocalPosition =
        Part.CFrame:PointToObjectSpace(
            WorldPosition
        )

    local HalfSize = Part.Size / 2

    return
        math.abs(LocalPosition.X)
            <= HalfSize.X
        and
        math.abs(LocalPosition.Y)
            <= HalfSize.Y + 10
        and
        math.abs(LocalPosition.Z)
            <= HalfSize.Z
end

--==================================================
-- RANDOM POSITION SELURUH PETAREA
--==================================================

local function GetRandomPetAreaPosition(PetArea)

    if not PetArea then
        return nil
    end

    local HalfSize =
        PetArea.Size / 2

    local RandomX =
        math.random()
        * (HalfSize.X * 2)
        - HalfSize.X

    local RandomZ =
        math.random()
        * (HalfSize.Z * 2)
        - HalfSize.Z

    local Padding = 0.5

    if HalfSize.X > Padding * 2 then

        RandomX =
            math.clamp(
                RandomX,
                -HalfSize.X + Padding,
                HalfSize.X - Padding
            )
    end

    if HalfSize.Z > Padding * 2 then

        RandomZ =
            math.clamp(
                RandomZ,
                -HalfSize.Z + Padding,
                HalfSize.Z - Padding
            )
    end

    local LocalPosition =
        Vector3.new(
            RandomX,
            HalfSize.Y,
            RandomZ
        )

    local WorldPosition =
        PetArea.CFrame:PointToWorldSpace(
            LocalPosition
        )

    if IsPositionInsidePart(
        PetArea,
        WorldPosition
    ) then

        return WorldPosition
    end

    return nil
end

