--==================================================
-- SAVE / LOAD SETTINGS
--==================================================

local function LoadSettings()
    if not isfile or not readfile then
        warn("[AUTO EGG] Executor tidak mendukung Load Settings")
        return
    end

    if not isfile(SETTINGS_FILE) then
        print("[AUTO EGG] Settings belum ada, default: WALK")
        return
    end

    local Success, Data = pcall(function()
        return HttpService:JSONDecode(readfile(SETTINGS_FILE))
    end)

    if not Success or type(Data) ~= "table" then
        warn("[AUTO EGG] Gagal load settings")
        return
    end

    if Data.MovementMode == "WALK"
        or Data.MovementMode == "TWEEN" then

        MovementMode = Data.MovementMode
    end

    print(
        "[AUTO EGG] Settings Loaded | Mode:",
        MovementMode
    )
end

local function SaveSettings()
    if not writefile then
        warn("[AUTO EGG] Executor tidak mendukung Save Settings")
        return
    end

    local Data = {
        MovementMode = MovementMode
    }

    local Success, Error = pcall(function()
        writefile(
            SETTINGS_FILE,
            HttpService:JSONEncode(Data)
        )
    end)

    if Success then
        print(
            "[AUTO EGG] Settings Saved | Mode:",
            MovementMode
        )
    else
        warn(
            "[AUTO EGG] Gagal save settings:",
            Error
        )
    end
end

