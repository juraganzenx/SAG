--==================================================
-- ULTRA LOW GRAPHIC
--==================================================

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

--==================================================
-- GRAPHICS QUALITY
--==================================================

pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

--==================================================
-- LIGHTING
--==================================================

pcall(function()
    Lighting.GlobalShadows = false
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.Brightness = 0
end)

--==================================================
-- REMOVE POST PROCESS EFFECTS
--==================================================

for _, obj in ipairs(Lighting:GetChildren()) do
    if obj:IsA("BloomEffect")
    or obj:IsA("BlurEffect")
    or obj:IsA("ColorCorrectionEffect")
    or obj:IsA("DepthOfFieldEffect")
    or obj:IsA("SunRaysEffect") then

        pcall(function()
            obj.Enabled = false
        end)
    end
end

--==================================================
-- TERRAIN
--==================================================

pcall(function()
    local Terrain = Workspace:FindFirstChildOfClass("Terrain")

    if Terrain then
        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
        Terrain.WaterReflectance = 0
        Terrain.WaterTransparency = 1
    end
end)

--==================================================
-- DISABLE PARTICLES / VISUAL EFFECTS
--==================================================

local function OptimizeObject(obj)
    pcall(function()

        if obj:IsA("ParticleEmitter") then
            obj.Enabled = false

        elseif obj:IsA("Trail") then
            obj.Enabled = false

        elseif obj:IsA("Beam") then
            obj.Enabled = false

        elseif obj:IsA("Smoke") then
            obj.Enabled = false

        elseif obj:IsA("Fire") then
            obj.Enabled = false

        elseif obj:IsA("Sparkles") then
            obj.Enabled = false

        elseif obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
            obj.Enabled = false

        end
    end)
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    OptimizeObject(obj)
end

--==================================================
-- OPTIMIZE OBJECTS ADDED LATER
--==================================================

Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        OptimizeObject(obj)
    end)
end)

--==================================================
-- 3D RENDERING OFF
--==================================================

pcall(function()
    RunService:Set3dRenderingEnabled(false)
end)

print("====================================")
print(" ULTRA LOW GRAPHIC ENABLED")
print(" Graphics       : LEVEL 01")
print(" Shadows        : OFF")
print(" Post FX        : OFF")
print(" Particles      : OFF")
print(" Lights         : OFF")
print(" Water FX       : OFF")
print(" 3D Rendering   : OFF")
print("====================================")
