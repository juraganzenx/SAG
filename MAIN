local function Execute(url)
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(url, true))()
        end)

        if not ok then
            warn(err)
        end
    end)
end

Execute("https://raw.githubusercontent.com/juraganzenx/SAG/refs/heads/main/KAITUN")
Execute("https://raw.githubusercontent.com/juraganzenx/SAG/refs/heads/main/GODMODE")
Execute("https://raw.githubusercontent.com/juraganzenx/SAG/refs/heads/main/EQUIPBESTPET")
Execute("https://raw.githubusercontent.com/juraganzenx/SAG/refs/heads/main/UPGRADEBASE")
Execute("https://raw.githubusercontent.com/juraganzenx/SAG/refs/heads/main/UPGRADETREADMILL")
Execute("https://raw.githubusercontent.com/juraganzenx/SAG/refs/heads/main/LOWGRAFIK")
Execute("https://raw.githubusercontent.com/juraganzenx/SAG/refs/heads/main/HOPIFADAPLAYER")
