--==================================================
-- AUTO HOP IF TARGET USER FOUND
--==================================================

local TARGET_USERS = {
    ["DKG3T6"] = true,
    ["GK3A27"] = true,
    ["FD64A5"] = true,
    ["WRHL2D"] = true,
}

local TargetUserHopping = false

--==================================================
-- CHECK TARGET USER
--==================================================

local function CheckTargetUserAndHop()

    if TargetUserHopping then
        return
    end

    for _, Player in ipairs(Players:GetPlayers()) do

        -- Jangan hop kalau username tersebut adalah kita sendiri
        if Player ~= LocalPlayer
            and TARGET_USERS[Player.Name] then

            warn(
                "[TARGET HOP] Username ditemukan:",
                Player.Name
            )

            TargetUserHopping = true

            -- Gunakan ServerHop() yang sudah ada
            ServerHop()

            return
        end
    end
end

--==================================================
-- CHECK PLAYER YANG SUDAH ADA
--==================================================

task.spawn(function()

    task.wait(2)

    CheckTargetUserAndHop()

end)

--==================================================
-- CHECK PLAYER BARU MASUK
--==================================================

Players.PlayerAdded:Connect(function(Player)

    if Player ~= LocalPlayer
        and TARGET_USERS[Player.Name] then

        task.wait(0.5)

        warn(
            "[TARGET HOP] Target masuk:",
            Player.Name
        )

        CheckTargetUserAndHop()

    end

end)
