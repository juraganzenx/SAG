--==================================================
-- STANDALONE TARGET PLAYER SERVER HOP
--==================================================

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- TARGET USERS
--==================================================

local TARGET_USERS = {
    ["DKG3T6"] = true,
    ["GK3A27"] = true,
    ["FD64A5"] = true,
    ["WRHL2D"] = true,
}

--==================================================
-- CONFIG
--==================================================

local CHECK_DELAY = 1
local HOP_DELAY = 2

local TargetHopRunning = false

--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()

    local Servers = {}
    local Cursor = ""

    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then
            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(Cursor)
        end

        local Success, Result =
            pcall(function()
                return game:HttpGet(Url)
            end)

        if not Success then
            warn("[TARGET HOP] Server list error:", Result)
            return Servers
        end

        local DecodeSuccess, Data =
            pcall(function()
                return HttpService:JSONDecode(Result)
            end)

        if not DecodeSuccess then
            warn("[TARGET HOP] Server decode error")
            return Servers
        end

        for _, Server in ipairs(Data.data or {}) do

            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(
                    Servers,
                    Server
                )

            end

        end

        Cursor =
            Data.nextPageCursor
            or ""

    until Cursor == ""
        or #Servers > 0

    return Servers

end

--==================================================
-- SERVER HOP
--==================================================

local function ServerHop(TargetName)

    if TargetHopRunning then
        return
    end

    TargetHopRunning = true

    print("==========================================")
    print("[TARGET HOP] TARGET FOUND:", TargetName)
    print("[TARGET HOP] MY USERNAME:", LocalPlayer.Name)
    print("[TARGET HOP] CURRENT JOB:", game.JobId)
    print("[TARGET HOP] SERVER HOP...")
    print("==========================================")

    task.wait(HOP_DELAY)

    local Servers = GetServers()

    if #Servers == 0 then

        warn("[TARGET HOP] Tidak ada server tersedia.")

        TargetHopRunning = false

        return
    end

    local Server =
        Servers[
            math.random(
                1,
                #Servers
            )
        ]

    print(
        "[TARGET HOP] Teleport:",
        Server.id,
        "| Players:",
        Server.playing,
        "/",
        Server.maxPlayers
    )

    local Success, Error =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )

        end)

    if not Success then

        warn(
            "[TARGET HOP] Teleport error:",
            Error
        )

        TargetHopRunning = false

    end

end

--==================================================
-- CHECK TARGET
--==================================================

local function CheckTarget()

    if TargetHopRunning then
        return
    end

    for _, Player in ipairs(Players:GetPlayers()) do

        -- Jangan pernah menganggap diri sendiri sebagai target
        if Player ~= LocalPlayer then

            local Username =
                string.upper(Player.Name)

            if TARGET_USERS[Username] then

                ServerHop(Player.Name)

                return

            end

        end

    end

end

--==================================================
-- PLAYER BARU MASUK
--==================================================

Players.PlayerAdded:Connect(function(Player)

    if Player == LocalPlayer then
        return
    end

    local Username =
        string.upper(Player.Name)

    if TARGET_USERS[Username] then

        print(
            "[TARGET HOP] TARGET JOINED:",
            Player.Name
        )

        task.wait(0.5)

        CheckTarget()

    end

end)

--==================================================
-- START
--==================================================

print("==========================================")
print(" STANDALONE TARGET SERVER HOP")
print("==========================================")
print("[TARGET HOP] My Username:", LocalPlayer.Name)
print("[TARGET HOP] Current Job:", game.JobId)
print("==========================================")

-- Cek player yang sudah ada di server
task.spawn(function()

    task.wait(1)

    CheckTarget()

end)

-- Cek berkala
task.spawn(function()

    while true do

        if not TargetHopRunning then
            CheckTarget()
        end

        task.wait(CHECK_DELAY)

    end

end)
