local function GetMyPlot()

    local Plots =
        Workspace:FindFirstChild(
            "Plots"
        )


    if not Plots then

        warn(
            "[AUTO PLACE] workspace.Plots tidak ditemukan"
        )

        return nil

    end


    for PlotNumber =
        MIN_PLOT,
        MAX_PLOT do


        local Plot =
            Plots:FindFirstChild(
                tostring(PlotNumber)
            )


        if Plot then

            local PlotSign =
                Plot:FindFirstChild(
                    "PlotSign"
                )


            if PlotSign then

                local PlayerPlotSign =
                    PlotSign:FindFirstChild(
                        "PlayerPlotSign"
                    )


                if PlayerPlotSign then

                    local Frame =
                        PlayerPlotSign:FindFirstChild(
                            "Frame"
                        )


                    if Frame then

                        local PlayerName =
                            Frame:FindFirstChild(
                                "PlayerName"
                            )


                        if PlayerName then

                            print(
                                "[AUTO PLACE] Plot",
                                PlotNumber,
                                "Owner:",
                                PlayerName.Text
                            )


                            if PlayerName.Text ==
                                LocalPlayer.Name then

                                print(
                                    "[AUTO PLACE] MY PLOT:",
                                    Plot.Name
                                )

                                return Plot

                            end

                        end

                    end

                end

            end

        end

    end


    warn(
        "[AUTO PLACE] Plot milik sendiri tidak ditemukan"
    )


    return nil

end


--==================================================
-- FIND PLOT AREA
--==================================================

local function GetPlotArea(Plot)

    local BiggestPart = nil

    local BiggestArea = 0


    for _, Object in ipairs(
        Plot:GetDescendants()
    ) do

        if Object:IsA("BasePart") then

            local Name =
                Object.Name:lower()


            if not Name:find("sign")
                and not Name:find("playername")
                and not Name:find("deco")
                and not Name:find("border")
                and not Name:find("wall")
                and not Name:find("fence") then


                local Area =
                    Object.Size.X *
                    Object.Size.Z


                if Area > BiggestArea then

                    BiggestArea =
                        Area

                    BiggestPart =
                        Object

                end

            end

        end

    end


    if BiggestPart then

        print(
            "[AUTO PLACE] AREA:",
            BiggestPart:GetFullName()
        )

        print(
            "[AUTO PLACE] SIZE:",
            BiggestPart.Size
        )

    end


    return BiggestPart

end


--==================================================
-- RANDOM POSITION
--==================================================

local function GetRandomPosition(
    Plot,
    AreaPart
)

    local Size =
        AreaPart.Size


    local MinX =
        -Size.X / 2 + MARGIN

    local MaxX =
        Size.X / 2 - MARGIN


    local MinZ =
        -Size.Z / 2 + MARGIN

    local MaxZ =
        Size.Z / 2 - MARGIN


    local LocalX =
        MinX +
        math.random() *
        (MaxX - MinX)


    local LocalZ =
        MinZ +
        math.random() *
        (MaxZ - MinZ)


    local WorldPosition =
        AreaPart.CFrame:PointToWorldSpace(
            Vector3.new(
                LocalX,
                0,
                LocalZ
            )
        )


    local PlotPivot =
        Plot:GetPivot()


    local PlotLocalPosition =
        PlotPivot:PointToObjectSpace(
            WorldPosition
        )


    return Vector3.new(
        PlotLocalPosition.X,
        FIXED_Y,
        PlotLocalPosition.Z
    )

end


