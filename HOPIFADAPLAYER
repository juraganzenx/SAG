--==================================================
-- PLAYER JOIN
--==================================================

Players.PlayerAdded:Connect(
    function(Player)

        if Player == LocalPlayer then
            return
        end

        -- Tunggu data player
        task.wait(0.5)

        if HopRunning then
            return
        end

        --==================================================
        -- USERNAME TRIGGER
        --==================================================

        if IsTargetUsername(Player) then

            print("==========================================")
            print(
                "[TARGET HOP] USERNAME TARGET JOINED:",
                Player.Name
            )
            print("==========================================")

            Status.Text =
                "TARGET USER\n"
                .. Player.Name

            TriggerTargetHop(
                Player,
                "USERNAME"
            )

            return

        end

        --==================================================
        -- SPEED TRIGGER
        --==================================================

        local Speed =
            GetPlayerSpeed(Player)

        if Speed and Speed > SPEED_LIMIT then

            print("==========================================")
            print(
                "[TARGET HOP] SPEED TARGET JOINED:",
                Player.Name
            )
            print(
                "[TARGET HOP] Speed:",
                FormatNumber(Speed)
            )
            print("==========================================")

            Status.Text =
                "TARGET SPEED\n"
                .. Player.Name
                .. " | "
                .. FormatNumber(
                    Speed
                )

            TriggerTargetHop(
                Player,
                "SPEED"
            )

        end

    end
)

--==================================================
-- AUTO MONITOR
--==================================================

task.spawn(
    function()

        while true do

            if not HopRunning then

                local Player, Trigger =
                    FindTarget()

                if Player then

                    local Speed =
                        GetPlayerSpeed(
                            Player
                        )

                    if Trigger == "USERNAME" then

                        Status.Text =
                            "TARGET USER\n"
                            .. Player.Name

                    else

                        Status.Text =
                            "TARGET SPEED\n"
                            .. Player.Name
                            .. " | "
                            .. FormatNumber(
                                Speed
                            )

                    end

                    TriggerTargetHop(
                        Player,
                        Trigger
                    )

                else

                    Status.Text =
                        "Monitoring...\n"
                        .. "boyzsae1-100 OR Speed > 5B"

                end

            end

            task.wait(
                CHECK_DELAY
            )

        end

    end
)

