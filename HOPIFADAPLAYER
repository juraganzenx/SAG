--==================================================
-- CHECK TARGET USERNAME
--==================================================

local function IsTargetUsername(Player)

    -- Jangan pernah target diri sendiri
    if Player == LocalPlayer then
        return false
    end

    local Username =
        string.upper(Player.Name)

    return TARGET_USERS[Username] == true

end

--==================================================
-- GET PLAYER SPEED
--==================================================

local function GetPlayerSpeed(Player)

    local Leaderstats =
        Player:FindFirstChild("leaderstats")

    if not Leaderstats then
        return nil
    end

    local Speed =
        Leaderstats:FindFirstChild("Speed")

    if not Speed then
        return nil
    end

    local Value =
        Speed.Value

    -- NumberValue / IntValue
    if typeof(Value) == "number" then

        return Value

    end

    local Text =
        tostring(Value)

    -- Hilangkan koma
    Text =
        Text:gsub(",", "")

    -- Coba angka langsung
    local Number =
        tonumber(Text)

    if Number then
        return Number
    end

    --==================================================
    -- SUPPORT FORMAT
    -- 5K / 5M / 5B / 5T
    --==================================================

    local Clean =
        Text:gsub("%s+", ""):upper()

    local NumberPart, Suffix =
        Clean:match(
            "^([%d%.]+)([KMBT]?)$"
        )

    if not NumberPart then
        return nil
    end

    local Base =
        tonumber(NumberPart)

    if not Base then
        return nil
    end

    local Multiplier = 1

    if Suffix == "K" then

        Multiplier = 1e3

    elseif Suffix == "M" then

        Multiplier = 1e6

    elseif Suffix == "B" then

        Multiplier = 1e9

    elseif Suffix == "T" then

        Multiplier = 1e12

    end

    return Base * Multiplier

end

--==================================================
-- FORMAT NUMBER
--==================================================

local function FormatNumber(Number)

    if not Number then
        return "?"
    end

    if Number >= 1e12 then

        return string.format(
            "%.2fT",
            Number / 1e12
        )

    elseif Number >= 1e9 then

        return string.format(
            "%.2fB",
            Number / 1e9
        )

    elseif Number >= 1e6 then

        return string.format(
            "%.2fM",
            Number / 1e6
        )

    elseif Number >= 1e3 then

        return string.format(
            "%.2fK",
            Number / 1e3
        )

    end

    return tostring(Number)

end

--==================================================
-- FIND TARGET
--
-- USERNAME OR SPEED
--==================================================

local function FindTarget()

    --==================================================
    -- PRIORITY 1
    -- BOYZSAE1 - BOYZSAE100
    --==================================================

    for _, Player in ipairs(
        Players:GetPlayers()
    ) do

        if Player ~= LocalPlayer then

            if IsTargetUsername(Player) then

                return Player, "USERNAME"

            end

        end

    end

    --==================================================
    -- PRIORITY 2
    -- SPEED > 5B
    --==================================================

    for _, Player in ipairs(
        Players:GetPlayers()
    ) do

        if Player ~= LocalPlayer then

            local Speed =
                GetPlayerSpeed(Player)

            if Speed and Speed > SPEED_LIMIT then

                return Player, Speed

            end

        end

    end

    return nil, nil

end

--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()

    local Servers = {}
    local Cursor = ""

    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then

            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    Cursor
                )

        end

        print(
            "[SERVER HOP] Request server list..."
        )

        local Success, Result =
            pcall(function()

                return game:HttpGet(
                    Url
                )

            end)

        if not Success then

            warn(
                "[SERVER HOP] HTTP ERROR:",
                Result
            )

            return Servers

        end

        local DecodeSuccess, Data =
            pcall(function()

                return HttpService:JSONDecode(
                    Result
                )

            end)

        if not DecodeSuccess then

            warn(
                "[SERVER HOP] JSON DECODE ERROR"
            )

            return Servers

        end

        for _, Server in ipairs(
            Data.data or {}
        ) do

            -- Jangan kembali ke server sekarang
            if Server.id ~= game.JobId

                -- Harus masih ada slot
                and Server.playing < Server.maxPlayers then

                table.insert(
                    Servers,
                    Server
                )

            end

        end

        Cursor =
            Data.nextPageCursor or ""

    until Cursor == ""

    return Servers

end

--==================================================
-- GET SERVER TERSEPI
--==================================================

local function GetLowestServer(Servers)

    if #Servers == 0 then
        return nil
    end

    table.sort(
        Servers,
        function(A, B)

            return A.playing < B.playing

        end
    )

    local LowestPlayers =
        Servers[1].playing

    local Candidates = {}

    for _, Server in ipairs(
        Servers
    ) do

        if Server.playing ==
            LowestPlayers then

            table.insert(
                Candidates,
                Server
            )

        else

            break

        end

    end

    if #Candidates == 0 then
        return nil
    end

    -- Kalau ada beberapa server dengan
    -- player sama-sama paling sedikit,
    -- pilih random

    return Candidates[
        math.random(
            1,
            #Candidates
        )
    ]

end

--==================================================
-- HOP TO LOWEST SERVER
--==================================================

local function HopToLowestServer()

    if HopRunning then
        return false
    end

    HopRunning = true

    print("==========================================")
    print(
        "[SERVER HOP] Mencari server paling sepi..."
    )
    print("==========================================")

    task.wait(HOP_DELAY)

    local Servers =
        GetServers()

    if #Servers == 0 then

        warn(
            "[SERVER HOP] Tidak ada server tersedia."
        )

        HopRunning = false

        return false

    end

    --==================================================
    -- SORT
    --==================================================

    table.sort(
        Servers,
        function(A, B)

            return A.playing < B.playing

        end
    )

    --==================================================
    -- DEBUG TOP 10
    --==================================================

    print("==========================================")
    print(
        "[SERVER HOP] TOP 10 SERVER TERSEPI"
    )
    print("==========================================")

    for i = 1, math.min(
        10,
        #Servers
    ) do

        local Server =
            Servers[i]

        print(
            i,
            "| Players:",
            Server.playing,
            "/",
            Server.maxPlayers,
            "| JobId:",
            Server.id
        )

    end

    --==================================================
    -- SELECT
    --==================================================

    local Server =
        GetLowestServer(
            Servers
        )

    if not Server then

        warn(
            "[SERVER HOP] Gagal memilih server."
        )

        HopRunning = false

        return false

    end

    print("==========================================")
    print(
        "[SERVER HOP] SERVER TERPILIH"
    )
    print(
        "[SERVER HOP] Players:",
        Server.playing,
        "/",
        Server.maxPlayers
    )
    print(
        "[SERVER HOP] JobId:",
        Server.id
    )
    print("==========================================")

    --==================================================
    -- TELEPORT
    --==================================================

    local Success, Error =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )

        end)

    if not Success then

        warn(
            "[SERVER HOP] TELEPORT ERROR:",
            Error
        )

        HopRunning = false

        return false

    end

    return true

end

--==================================================
-- AUTO TARGET HOP
--==================================================

local function TriggerTargetHop(
    Player,
    Trigger
)

    if HopRunning then
        return
    end

    local Speed =
        GetPlayerSpeed(Player)

    print("==========================================")
    print(
        "[TARGET HOP] TARGET FOUND:",
        Player.Name
    )
    print(
        "[TARGET HOP] Trigger:",
        Trigger
    )

    if Speed then

        print(
            "[TARGET HOP] Speed:",
            FormatNumber(Speed)
        )

    end

    print("==========================================")

    HopToLowestServer()

end

