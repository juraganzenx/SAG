--==================================================
-- MAIN PROCESS
--==================================================

local function Process()

    --================================================
    -- PROCESS LOCK
    --================================================

    if ProcessRunning then

        warn(
            "[AUTO EGG] Process masih berjalan -> SKIP"
        )

        return

    end


    ProcessRunning = true


    local Success, Error =
        xpcall(function()


            --========================================
            -- STEP 1
            -- FIND EGG
            --========================================

            local Egg =
                GetBestEgg()


            if not Egg then

                ServerHop()

                return

            end


            --========================================
            -- STEP 2
            -- START AREA
            --========================================

            local StartArea =
                GetStartArea()


            if not StartArea then

                warn(
                    "[AUTO EGG] StartArea tidak ditemukan."
                )

                task.wait(2)

                return

            end


            --========================================
            -- STEP 3
            -- FLY START
            --========================================

            print(
                "[AUTO EGG] -> FLY START AREA"
            )


            local StartPosition = GetPosition(StartArea)

            if StartPosition then
                StartPosition = StartPosition + Vector3.new(-20, 10, 0)
            end

            local StartReached =
                AutoFlyToPosition(
                    StartPosition,
                    REACH_DISTANCE,
                    "MAIN:StartArea"
                )

            if not StartReached then

                return

            end


            --========================================
            -- STEP 4
            -- VALIDATE EGG
            --========================================

            if not Egg
                or not Egg.Parent then

                print(
                    "[AUTO EGG] Egg sudah hilang."
                )

                return

            end


            local IsHighlight =
                HasHighlight(Egg)


            if not IsHighlight then

                local Scale =
                    GetEggScale(Egg)


                local PivotX =
                    GetEggWorldPivotX(Egg)


                if Scale <=
                    NormalEggConfig.MIN_SCALE
                    or PivotX <=
                    NormalEggConfig.MIN_WORLD_PIVOT_X then

                    print(
                        "[AUTO EGG] Egg tidak valid lagi."
                    )

                    return

                end

            end


            --========================================
            -- STEP 5
            -- FLY EGG
            --========================================

            print(
                "[AUTO EGG] -> FLY EGG:",
                Egg.Name
            )


            local ReachedEgg =
                FlyToObject(
                    Egg
                )


            if not ReachedEgg then

                return

            end


            --========================================
            -- STEP 6
            -- CARRY
            --========================================

            task.wait(
                AFTER_CARRY_START_DELAY
            )


            local Carried =
                CarryEgg(Egg)


            if not Carried then

                warn(
                    "[AUTO EGG] Carry gagal."
                )

                return

            end


            task.wait(
                CARRY_DELAY
            )


            --========================================
            -- STEP 7
            -- RETURN START
            --========================================

            print(
                "[AUTO EGG] -> FLY RETURN START AREA"
            )


            local Returned =
                FlyToObject(
                    StartArea
                )


            if not Returned then

                return

            end


            --========================================
            -- STEP 8
            -- WAIT
            --========================================

            print(
                "[AUTO EGG] Sampai StartArea."
            )


            print(
                "[AUTO EGG] Menunggu",
                WAIT_AFTER_RETURN,
                "detik..."
            )


            task.wait(
                WAIT_AFTER_RETURN
            )


            --========================================
            -- STEP 9
            -- CHECK TOOL
            --========================================

            local Tool =
                GetEquippedTool()


            if not Tool then

                print(
                    "[AUTO EGG] Tool BELUM EQUIPPED."
                )


                Tool =
                    WaitForEquippedTool(
                        5
                    )

            end


            if not Tool then

                print(
                    "[AUTO EGG] Tool tidak muncul."
                )

                return

            end


            --========================================
            -- STEP 10
            -- OWN PLOT
            --========================================

            print(
                "[AUTO PLACE] Tool terdeteksi:",
                Tool.Name
            )


            local Plot =
                GetMyPlot()


            if not Plot then

                return

            end


            --========================================
            -- STEP 11
            -- FLY PLOT
            --========================================

            print(
                "[AUTO PLACE] -> FLY OWN PLOT"
            )


            local ReachedPlot =
                FlyToObject(
                    Plot
                )


            if not ReachedPlot then

                return

            end


            --========================================
            -- STEP 12
            -- CHECK TOOL AGAIN
            --========================================

            local CurrentTool =
                GetEquippedTool()


            if not CurrentTool then

                warn(
                    "[AUTO PLACE] Tool sudah tidak equipped."
                )

                return

            end


            --========================================
            -- STEP 13
            -- PLACE
            --========================================

            local Placed =
                PlaceEgg(
                    CurrentTool,
                    Plot
                )


            if not Placed then

                warn(
                    "[AUTO PLACE] Place gagal."
                )

                return

            end


            print(
                "[AUTO PLACE] PLACE REQUEST SENT."
            )


            --========================================
            -- STEP 14
            -- WAIT TOOL GONE
            --========================================

            local Gone =
                WaitToolGone(
                    CurrentTool,
                    WAIT_TOOL_GONE
                )


            if Gone then

                print(
                    "[AUTO PLACE] Tool sudah hilang."
                )

            else

                warn(
                    "[AUTO PLACE] Tool masih ada."
                )

            end


            --========================================
            -- STEP 15
            -- START HATCH
            --========================================

            print(
                "[AUTO HATCH] START HATCH PROCESS"
            )


            StartHatch()


            --========================================
            -- STEP 16
            -- RESUME AFTER 5 SEC
            --========================================

            print(
                "[AUTO HATCH] Menunggu",
                HATCH_RESUME_TIME,
                "detik..."
            )


            task.wait(
                HATCH_RESUME_TIME
            )


            print(
                "[AUTO EGG] RESUME -> CARI EGG BERIKUTNYA"
            )


        end,
        debug.traceback
    )


    --================================================
    -- RELEASE PROCESS LOCK
    --================================================

    ProcessRunning = false


    if not Success then

        warn(
            "[AUTO EGG] PROCESS ERROR:",
            Error
        )

        StopFly()

    end

end


