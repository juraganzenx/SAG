--==================================================
-- MOVEMENT LOCK
--==================================================

local function AcquireMovementLock(Name)

    if MovementOwner ~= nil then

        return false

    end

    MovementOwner = Name

    print(
        "[MOVEMENT LOCK] ACQUIRED:",
        Name
    )

    return true

end


local function ReleaseMovementLock(Name)

    if MovementOwner == Name then

        print(
            "[MOVEMENT LOCK] RELEASE:",
            Name
        )

        MovementOwner = nil

    end

end


local function GetMovementOwner()

    return MovementOwner

end


