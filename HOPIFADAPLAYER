        "=========================================="
    )

    print(
        "[AUTO PLACE] PLACE EGG"
    )

    print(
        "[AUTO PLACE] Tool:",
        Tool.Name
    )

    print(
        "[AUTO PLACE] UID:",
        UID
    )

    print(
        "[AUTO PLACE] X:",
        RandomPosition.X
    )

    print(
        "[AUTO PLACE] Y:",
        FIXED_Y
    )

    print(
        "[AUTO PLACE] Z:",
        RandomPosition.Z
    )

    print(
        "=========================================="
    )


    local Args = {

        [1] = {

            ["Uid"] = UID,

            ["LocalCFrame"] =
                LocalCFrame

        }

    }


    local Success, Result =
        pcall(function()

            return PlaceEggRemote:InvokeServer(
                unpack(Args)
            )

        end)


    print(
        "[AUTO PLACE] Success:",
        Success
    )

    print(
        "[AUTO PLACE] Result:",
