--==================================================
-- WAIT TOOL GONE
--==================================================

local function WaitToolGone(
    Tool,
    Timeout
)

    local StartTime =
        tick()


    while tick() - StartTime <
        Timeout do


        if not Tool.Parent then

            return true

        end


        local CurrentTool =
            GetEquippedTool()


        if CurrentTool ~= Tool then

            return true

        end


        task.wait(0.1)

    end


    return false

end


