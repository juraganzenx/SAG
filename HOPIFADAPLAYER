--==================================================
-- GET SPEED
--==================================================

local function GetPlayerSpeed(Player)

    local Leaderstats =
        Player:FindFirstChild("leaderstats")

    if not Leaderstats then
        return nil
    end

    local Speed =
        Leaderstats:FindFirstChild("Speed")

    if not Speed then
        return nil
    end

    local Value = Speed.Value

    if typeof(Value) == "number" then
        return Value
    end

    local Number =
        tonumber(
            tostring(Value):gsub(",", "")
        )

    return Number

end

--==================================================
-- FIND TARGET
--==================================================

local function FindSpeedTarget()

    for _, Player in ipairs(
        Players:GetPlayers()
    ) do

        -- Jangan pernah target diri sendiri
        if Player ~= LocalPlayer then

            local Speed =
                GetPlayerSpeed(Player)

            if Speed and Speed > SPEED_LIMIT then

                return Player, Speed

            end

        end

    end

    return nil, nil

end

--==================================================
-- GET PUBLIC SERVERS
--==================================================

local function GetServers()

    local Servers = {}
    local Cursor = ""

    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then

            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(Cursor)

        end

        local Success, Result =
            pcall(function()

                return game:HttpGet(Url)

            end)

        if not Success then

            warn(
                "[SPEED HOP] HTTP ERROR:",
                Result
            )

            return Servers

        end

        local DecodeSuccess, Data =
            pcall(function()

                return HttpService:JSONDecode(
                    Result
                )

            end)

        if not DecodeSuccess then

            warn(
                "[SPEED HOP] JSON ERROR"
            )

            return Servers

        end

        for _, Server in ipairs(
            Data.data or {}
        ) do

            if Server.id ~= game.JobId
                and Server.playing < Server.maxPlayers then

                table.insert(
                    Servers,
                    Server
                )

            end

        end

        Cursor =
            Data.nextPageCursor or ""

    until Cursor == ""

    return Servers

end

--==================================================
-- FIND SEPEST SERVER
--==================================================

local function GetLowestServer(Servers)

    if #Servers == 0 then
        return nil
    end

    table.sort(
        Servers,
        function(A, B)

            return A.playing < B.playing

        end
    )

    local LowestPlayers =
        Servers[1].playing

    local Candidates = {}

    for _, Server in ipairs(Servers) do

        if Server.playing ==
            LowestPlayers then

            table.insert(
                Candidates,
                Server
            )

        else

            break

        end

    end

    return Candidates[
        math.random(
            1,
            #Candidates
        )
    ]

end

--==================================================
-- SERVER HOP
--==================================================

local function ServerHop(TargetPlayer, Speed)

    if HopRunning then
        return
    end

    HopRunning = true

    print("==========================================")
    print("[SPEED HOP] TARGET FOUND")
    print("[SPEED HOP] Player:", TargetPlayer.Name)
    print("[SPEED HOP] Speed:", Speed)
    print("[SPEED HOP] Limit:", SPEED_LIMIT)
    print("[SPEED HOP] Mencari server sepi...")
    print("==========================================")

    task.wait(HOP_DELAY)

    local Servers =
        GetServers()

    if #Servers == 0 then

        warn(
            "[SPEED HOP] Tidak ada server tersedia."
        )

        HopRunning = false

        return

    end

    local Server =
        GetLowestServer(Servers)

    if not Server then

        warn(
            "[SPEED HOP] Gagal memilih server."
        )

        HopRunning = false

        return

    end

    print("==========================================")
    print("[SPEED HOP] SERVER TERPILIH")
    print(
        "[SPEED HOP] Players:",
        Server.playing,
        "/",
        Server.maxPlayers
    )
    print(
        "[SPEED HOP] JobId:",
        Server.id
    )
    print("==========================================")

    local Success, Error =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )

        end)

    if not Success then

        warn(
            "[SPEED HOP] TELEPORT ERROR:",
            Error
        )

        HopRunning = false

    end

end

--==================================================
-- CHECK TARGET
--==================================================

local function CheckSpeedTarget()

    if HopRunning then
        return
    end

    local Player, Speed =
        FindSpeedTarget()

    if Player then

        print(
            "[SPEED HOP] Target ditemukan:",
            Player.Name,
            "| Speed:",
            Speed
        )

        ServerHop(
            Player,
            Speed
        )

    end

end

--==================================================
-- PLAYER JOIN CHECK
--==================================================

Players.PlayerAdded:Connect(function(Player)

    if Player == LocalPlayer then
        return
    end

    task.wait(0.5)

    if HopRunning then
        return
    end

    local Speed =
        GetPlayerSpeed(Player)

    if Speed and Speed > SPEED_LIMIT then

        print(
            "[SPEED HOP] TARGET JOINED:",
            Player.Name,
            "| Speed:",
            Speed
        )

        ServerHop(
            Player,
            Speed
        )

    end

end)

