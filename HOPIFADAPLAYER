    end


    print(
        "=========================================="
    )

    print(
        "[AUTO HATCH] OWN EGG FOUND:",
        Egg.Name
    )

    print(
        "[AUTO HATCH] MAX HATCH TIME:",
        HATCH_MAX_TIME,
        "SEC"
    )

    print(
        "=========================================="
    )


    --================================================
    -- FLY TO EGG
    --================================================

    local Reached =
        FlyToPlacedEgg(
            Egg
        )


    if not Reached then

        warn(
            "[AUTO HATCH] Gagal mencapai egg."
        )

        return

    end


    --================================================
    -- HATCH LOOP
    --================================================

    TriggeredPrompts = {}


    local StartTime =
        tick()


    while tick() - StartTime <
        HATCH_MAX_TIME do


        if not Egg
            or not Egg.Parent then

            print(
                "[AUTO HATCH] Egg sudah hilang / berhasil hatch."
            )

            return

        end


        TriggerNearbyPrompts()


        task.wait(
            PROMPT_CHECK_DELAY
        )

    end


    print(
        "[AUTO HATCH] Hatch timeout:",
        HATCH_MAX_TIME,
        "detik."
    )

end


