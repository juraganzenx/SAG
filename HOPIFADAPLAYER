-- SERVER HOP
--==================================================

local function ServerHop()

    print(
        "=========================================="
    )

    print(
        "[AUTO EGG] NO VALID EGG"
    )

    print(
        "[AUTO EGG] SERVER HOP..."
    )

    print(
        "=========================================="
    )


    StopFly()


    local Servers =
        GetServers()


    if #Servers == 0 then

        warn(
            "[AUTO EGG] Tidak ada server ditemukan."
        )

        task.wait(3)

        return

    end


    local Server =
        Servers[
            math.random(
                1,
                #Servers
            )
        ]


    print(
        "[AUTO EGG] Teleport:",
        Server.id,
        "| Players:",
        Server.playing,
        "/",
        Server.maxPlayers
    )


    local Success, Error =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                Server.id,
                LocalPlayer
            )

        end)


    if not Success then

        warn(
            "[AUTO EGG] Teleport error:",
            Error
        )

        task.wait(3)

    end

end


